use clock.timeout
use console.println
use http

/// A server in the payload of a `Some`, boxed through `clock.timeout`'s `Any`
/// and used as a set element: the admission refuses the server and names it
/// `http.Server` inside `Option.Some(0)`.
///
/// `fail_key_boxed_resource`'s row for a value the Host boxed: the boundary
/// chose its layout, and the name is the same placed literal a `dyn` box's is
/// (issue #506). A task or a task scope cannot be written here, because the
/// boundary refuses to box one; a resource can.
fn admitAnswer() -> Result<Unit, Error> {
  let server = http.listen(0)?
  let answer = timeout(1s) { Some(server) }?
  let answers = Set.of(answer).inserted(answer)
  println("never printed {answers}")?
  server.close()?
  Ok(())
}

export fn main() -> Result<Unit, Error> {
  println("about to use a boxed optional server as a set element")?
  admitAnswer()?
  Ok(())
}
