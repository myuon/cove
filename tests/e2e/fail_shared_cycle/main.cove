use console.println

/// Stores a handle to a cell back into that same cell, the direct `Arc`
/// cycle ADR 0011's amendment rejects: nothing reclaims a `Shared` cell that
/// comes to hold itself, so `lock` refuses the closure instead of leaking.
struct Node {
  cell: Option<Shared<Node>>
}

export fn main() -> Result<Unit, Error> {
  let n = Shared(Node(cell: None))
  n.lock(fn(var value) {
    value = Node(cell: Some(n))
  })
  println("never printed")?
  Ok(())
}
