  show("titlecase.dz.upper", fromPoints([452])?)?
  show("titlecase.dz.title", fromPoints([453])?)?
  show("titlecase.dz.lower", fromPoints([454])?)?
  show("turkish.dotted.capital", fromPoints([304])?)?
