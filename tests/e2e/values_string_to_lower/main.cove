  show("ascii.edges", fromPoints([64, 65, 90, 91, 96, 97, 122, 123])?)?
  show(
    "ascii.long",
    fromPoints([116, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110, 32, 102, 111, 120, 32, 106, 117, 109, 112, 115, 32, 111, 118, 101, 114, 32, 116, 104, 101, 32, 108, 97, 122, 121, 32, 100, 111, 103, 32, 116, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110, 32, 102, 111, 120, 32, 106, 117, 109, 112, 115, 32, 111, 118, 101, 114, 32, 116, 104, 101, 32, 108, 97, 122, 121, 32, 100, 111, 103, 32])?,
  )?
  show("sharp.s", fromPoints([115, 116, 114, 97, 223, 101])?)?
  show("sharp.s.capital", fromPoints([7838])?)?
  show("sharp.s.run", fromPoints([223, 223, 223])?)?
  show("accents.upper", fromPoints([201, 192])?)?
  show("accents.lower", fromPoints([233, 224])?)?
  show("ligature.ff", fromPoints([64256])?)?
  show("ligature.fi", fromPoints([64257])?)?
  show("ligature.fl", fromPoints([64258])?)?
  show("ligature.ffi", fromPoints([64259])?)?
  show("ligature.ffl", fromPoints([64260])?)?
  show("ligature.long.st", fromPoints([64261])?)?
  show("ligature.st", fromPoints([64262])?)?
  show("armenian.ech.yiwn", fromPoints([1415])?)?
