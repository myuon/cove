  band(93760, 93776)?
  band(66736, 66752)?

  roundTrip("sharp.s", fromPoints([115, 116, 114, 97, 223, 101])?)?
  roundTrip("sharp.s.capital", fromPoints([7838])?)?
  roundTrip("turkish.dotted.capital", fromPoints([304])?)?
  roundTrip("turkish.dotless.small", fromPoints([305])?)?
  roundTrip("kelvin", fromPoints([8490])?)?
  roundTrip("ohm", fromPoints([8486])?)?
  roundTrip("angstrom", fromPoints([8491])?)?
  roundTrip("ligature.ff", fromPoints([64256])?)?
  roundTrip("titlecase.dz.title", fromPoints([453])?)?
  roundTrip("ypogegrammeni", fromPoints([837])?)?
  roundTrip("sigma.final", fromPoints([913, 931])?)?
  roundTrip("sigma.alone", fromPoints([931])?)?
  roundTrip(
    "ascii.mixed",
    fromPoints([72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 32, 49, 50, 51])?,
  )?
  roundTrip("greek.words", fromPoints([913, 914, 915, 32, 945, 946, 947])?)?
  Ok(())
}
