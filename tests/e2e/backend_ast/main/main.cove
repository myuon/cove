use console.println

/// The oracle, reached by name and finishing.
///
/// ADR 0034 keeps the tree-walking interpreter as the definition of what a
/// Cove program means, and `--backend ast` is how a person reaches it. This
/// is the case that says the flag works from the outside: a real program, a
/// real host, and the interpreter's own answer, asked for by name.
///
/// It used to be half of a pair. The other half was `backend_unsupported`,
/// which pinned the predecessor backend refusing the local `fn` below and
/// pointing at this flag as the way out. That backend is gone and this
/// construct lowers, so the refusal it pinned no longer exists to be pinned —
/// and the flag it pointed at is worth keeping a case on regardless of what
/// sends anybody to it.
export fn main() -> Result<Unit, Error> {
  println("this line runs on the interpreter")?
  fn double(n: Int) -> Int {
    n * 2
  }
  println("doubled {double(21)}")?
  Ok(())
}
