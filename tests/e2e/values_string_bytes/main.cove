use console.println

/// One `sliceBytes` call, printed with the bytes it answered.
///
/// The brackets are there so an empty answer is visible, and the byte length
/// is there so an answer that printed right but was cut wrong is not.
fn show(
  label: String,
  text: String,
  from: Int,
  to: Int,
) -> Result<Unit, Error> {
  match text.sliceBytes(from, to) {
    Ok(part) => println("{label} {from}..{to} Ok([{part}] {part.byteLength()})")
    Err(error) => println("{label} {from}..{to} Err({error.message})")
  }
}

/// Pins every answer `String.sliceBytes` and `String.join` give before either
/// moves out of the runtime, so the move shows no difference here.
///
/// `sliceBytes` checks five things in a fixed order — `from` in range, `to` in
/// range, forwards, `from` at a character, `to` at a character — and a call
/// that breaks several of them is told about the first. Each line below that
/// breaks more than one says which one wins.
export fn main() -> Result<Unit, Error> {
  // `a` is one byte, `あ` and `い` three, `b` one, `う` three: 11 bytes, and
  // the character starts are 0, 1, 4, 7, 8 and the end, 11.
  let text = "aあいbう"

  // Successes: empty at each end and in the middle, the whole, and every
  // character on its own.
  show("empty start", text, 0, 0)?
  show("empty end", text, 11, 11)?
  show("empty middle", text, 4, 4)?
  show("whole", text, 0, 11)?
  show("a", text, 0, 1)?
  show("あ", text, 1, 4)?
  show("い", text, 4, 7)?
  show("b", text, 7, 8)?
  show("う", text, 8, 11)?
  show("two", text, 1, 7)?
  show("tail", text, 7, 11)?

  // `from` out of range.
  show("from negative", text, -1, 4)?
  show("from past", text, 12, 12)?
  show("from huge", text, 9223372036854775807, 11)?
  show("from least", text, -9223372036854775807 - 1, 0)?
  // `from` out of range wins over `to` out of range, backwards and inside.
  show("from past to negative", text, 12, -1)?
  show("from past to inside", text, 99, 2)?

  // `to` out of range.
  show("to negative", text, 0, -1)?
  show("to past", text, 0, 12)?
  show("to huge", text, 11, 9223372036854775807)?
  // `to` out of range wins over backwards and over `from` inside a character.
  show("to past from inside", text, 2, 12)?
  show("to negative from inside", text, 5, -3)?

  // Backwards.
  show("backwards", text, 4, 1)?
  show("backwards by one", text, 8, 7)?
  // Backwards wins over both ends inside a character.
  show("backwards both inside", text, 6, 2)?

  // Inside a character.
  show("from inside", text, 2, 4)?
  show("to inside", text, 1, 3)?
  show("both inside", text, 2, 5)?
  show("empty inside", text, 3, 3)?
  show("to inside last", text, 8, 10)?

  // A four-byte character, whose three continuation bytes are each refused.
  let emoji = "x😀y"
  show("emoji", emoji, 1, 5)?
  show("emoji from 2", emoji, 2, 6)?
  show("emoji to 3", emoji, 0, 3)?
  show("emoji to 4", emoji, 0, 4)?
  show("emoji all", emoji, 0, 6)?

  // The empty string has one offset.
  show("nothing", "", 0, 0)?
  show("nothing past", "", 0, 1)?
  show("nothing before", "", -1, 0)?

  // An answer is a string like any other: it compares, counts and slices.
  let cut = text.sliceBytes(1, 7).unwrapOr("?")
  println("cut {cut == "あい"} {cut.length()} {cut.chars()}")?
  println("cut again {cut.sliceBytes(3, 6)}")?

  // A long run, so the copy is more than a word or two.
  var long = ""
  var i = 0
  while i < 40 {
    long = "{long}0123456789abcdefあいう"
    i += 1
  }
  let longBytes = long.byteLength()
  println("long {longBytes}")?
  match long.sliceBytes(19, longBytes - 25) {
    Ok(part) => {
      let partBytes = part.byteLength()
      println("long cut {partBytes} {part.sliceBytes(0, 12)} {part.sliceBytes(partBytes - 13, partBytes)}")?
    }
    Err(error) => println("long cut Err({error.message})")?
  }

  // `join`: the receiver goes between the parts.
  let empty: Array<String> = []
  println("join empty [{", ".join(empty)}] {", ".join(empty).byteLength()}")?
  println("join empty separator [{"".join(empty)}]")?
  println("join one [{", ".join(["solo"])}]")?
  println("join one empty [{", ".join([""])}] {", ".join([""]).byteLength()}")?
  println(
    "join two empty [{", ".join(["", ""])}] {", ".join(["", ""]).byteLength()}",
  )?
  println("join no separator [{"".join(["a", "bc", "", "def"])}]")?
  println("join [{", ".join(["Alice", "Bob", "Cara"])}]")?
  let kana = "・".join(["あ", "いう", "", "😀"])
  println("join multibyte [{kana}] {kana.byteLength()}")?
  println("join empty parts [{"-".join(["", "", ""])}]")?

  // Parts that are slices, and a join that is long.
  let parts = [
    text.sliceBytes(0, 1).unwrapOr("?"),
    text.sliceBytes(1, 4).unwrapOr("?"),
    text.sliceBytes(8, 11).unwrapOr("?"),
  ]
  println("join slices [{"|".join(parts)}]")?
  var many: Vector<String> = Vector.of()
  var k = 0
  while k < 300 {
    many.push("part{k}")
    k += 1
  }
  let joined = ", ".join(many.freeze())
  let joinedBytes = joined.byteLength()
  println("join many {joinedBytes} {joined.sliceBytes(0, 20)} {joined.sliceBytes(joinedBytes - 20, joinedBytes)}")?
  let head = joined.sliceBytes(0, 5).unwrapOr("?")
  println("join joined [{" / ".join([head, "", "end"])}]")?
  Ok(())
}
