use console.println

/// Prints how `Int` literals, arithmetic, precedence, and parsing evaluate.
export fn main() -> Result<Unit, Error> {
  println("decimal {1000000}")?
  println("separators {1_000_000}")?
  println("hexadecimal {0xff} {0xFF_FF}")?
  println("binary {0b1010} {0b1111_0000}")?
  println("negative {-42} {0 - 42}")?
  println("precedence {2 + 3 * 4}")?
  println("grouped {(2 + 3) * 4}")?
  println("division {7 / 2} remainder {7 % 2}")?
  println("negative division {-7 / 2} remainder {-7 % 2}")?
  println("comparison {1 < 2} {2 <= 2} {3 > 4} {3 >= 4}")?
  println("equality {1 == 1} {1 != 1}")?
  println("toFloat {7.toFloat()} {(-3).toFloat()}")?
  println("abs {(-7).abs()} {7.abs()}")?
  println("min {3.min(5)} max {3.max(5)}")?
  println("parse {Int.parse("12")} {Int.parse("x")}")?
  // `parse` is decimal; `parseRadix` is the one that asks, so `ff` is a
  // number in one of these calls and not in the other.
  println("parseRadix {Int.parseRadix("ff", 16)} {Int.parseRadix("ff", 10)}")?
  println("parseRadix {Int.parseRadix("1010", 2)} {Int.parseRadix("-z", 36)}")?
  Ok(())
}
