use console.println

/// A node that reaches its own container, so a `Node` inside `next` is a
/// cycle: the vector holds the struct, and the struct holds the vector.
///
/// This is the smallest cycle the language can write. A vector holding
/// *itself* would be smaller, and is not writable: its type is a
/// `μX. Vector<X>` — regular, finitely representable, and with no surface
/// syntax, because recursion here is nominal and inference is structural —
/// so `cove::type::recursive_type` refuses it. What that costs this case is
/// written under `main`.
struct Node {
  next: Vector<Node>
}

/// Builds and abandons `count` cycles. `Rc` alone can free none of them.
fn churn(count: Int) {
  var i = 0
  while i < count {
    var v: Vector<Node> = Vector.of()
    v.push(Node(next: v))
    i = i + 1
  }
}

/// Builds cycles of every shape the value model allows *and the language can
/// write*, abandons them, and shows that everything still named survives the
/// collections that reclaimed them.
///
/// Those two are no longer the same set, and the difference is one shape:
/// a single object that reaches itself. The value model allows it — a
/// vector is a handle and pushing that handle into the vector it names is
/// one object with a reference to itself — and no type can be written for
/// it, so the checker refuses it. What remains here is every cycle of two
/// objects or more: through a struct field, and through a closure capture.
/// A collector that reclaimed those two and not a self-reference would be a
/// collector this case no longer catches; the shape is still reachable from
/// a host that builds a value directly, and nothing here covers that.
export fn main() -> Result<Unit, Error> {
  var kept = Vector.of(1, 2, 3)

  var through: Vector<Node> = Vector.of()
  through.push(Node(next: through))
  println("a cycle through a struct field has length {through.length()}")?

  var captured: Vector<fn() -> Int> = Vector.of()
  let count = fn() {
    captured.length()
  }
  captured.push(count)
  println("a cycle through a closure capture reports {count()}")?

  churn(500)
  println("what is still named survives {kept} of length {kept.length()}")?
  Ok(())
}
