use console.println

/// Sorts under a comparison that stops the run partway through.
///
/// The failure comes out of `sorted` as its own, so nothing half-sorted is
/// ever printed: the line below never runs, and the array that was being
/// built is dropped with the call.
export fn main() -> Result<Unit, Error> {
  let items = [3, 1, 2]
  let zero = 0
  println("about to sort {items}")?
  println("never printed {items.sorted(by: fn(a, b) { a / zero < b })}")?
  println("never printed either {items}")?
  Ok(())
}
