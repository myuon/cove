use std.stringbuilder.StringBuilder

/// Appends `value` as one byte. Not the standard library: an ordinary Cove
/// function with a caller, between `main` and the library body that fails.
fn emit(var out: StringBuilder, value: Int) {
  out.appendByte(value)
}

/// Appends a byte that is not a byte, which `StringBuilder.appendByte` refuses
/// inside `std/stringbuilder.cove`. That body takes its builder as a `var`
/// parameter and is one instruction long, so the linear-memory backend expands
/// it into `emit` as it expands `fail_int_abs_overflow`'s `abs`, and the fault
/// is raised in `emit`'s own frame. The diagnostic still blames the line in
/// `emit` that called the library, keeps the library's own line as context,
/// and says that `main` called `emit`. ADR 0058.
export fn main() -> Result<Unit, Error> {
  var out = StringBuilder.withCapacity(4)
  emit(var out, 300)
  Ok(())
}
