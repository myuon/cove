use console.println

/// A domain error with its own payload.
export enum ParseError {
  NotANumber(String)
}

/// Doubles a parsed number, propagating the error with `?`.
fn double(text: String) -> Result<Int, Error> {
  let value = Int.parse(text)?
  Ok(value * 2)
}

/// Replaces the builtin error with a domain error.
fn parseOrFail(text: String) -> Result<Int, ParseError> {
  Int.parse(text).mapError { ParseError.NotANumber(text) }
}

/// Prints `Result` construction, queries, unwrapping, mapping, and
/// propagation.
export fn main() -> Result<Unit, Error> {
  // `Ok(1)` says what the value is and nothing says what the failure would
  // have been, and `Result` is generic in both — `parseOrFail` below answers
  // a `ParseError`. So the error type is written here rather than guessed:
  // `cove::type::unconstrained` is what asks for it.
  let ok: Result<Int, Error> = Ok(1)
  let failed = Err(Error("broken"))
  println("values {ok} {failed}")?
  println("isOk {ok.isOk()} {failed.isOk()}")?
  println("isError {ok.isError()} {failed.isError()}")?
  println("unwrapOr {ok.unwrapOr(0)} {failed.unwrapOr(0)}")?
  println("`?` on Ok {double("21")}")?
  println("`?` on Err {double("x")}")?
  println("mapError leaves Ok alone {parseOrFail("7")}")?
  println("mapError replaces Err {parseOrFail("x")}")?
  // The error type is not named by `unwrapOr`, so a domain error unwraps
  // exactly as the builtin one does.
  println("unwrapOr a domain error {parseOrFail("x").unwrapOr(0)}")?
  Ok(())
}
