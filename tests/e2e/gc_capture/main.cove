use console.println

/// A node that reaches its own container, so a `Node` inside `next` is a
/// cycle: the vector holds the struct, and the struct holds the vector.
///
/// This is the smallest cycle the language can write. A vector that holds
/// *itself* is a `μX. Vector<X>` — regular, finitely representable, and
/// with no surface syntax, because recursion here is nominal and inference
/// is structural — so `cove::type::recursive_type` refuses it and a
/// declared type is how a cycle is written instead.
struct Node {
  next: Vector<Node>
}

/// Builds and abandons `count` cycles, which is what makes a collection run.
fn churn(count: Int) {
  var i = 0
  while i < count {
    var v: Vector<Node> = Vector.of()
    v.push(Node(next: v))
    i += 1
  }
}

/// Answers a closure over a vector no binding of the caller's names.
///
/// A closure captures by value and a vector is a handle, so the capture and
/// the binding are one object; when this returns, the capture is the only
/// thing left that reaches it.
fn hidden() -> fn() -> Int {
  var counted = Vector.of(1, 2, 3, 4, 5)
  fn() {
    counted.length()
  }
}

/// Collects while a closure capture is the only root there is.
export fn main() -> Result<Unit, Error> {
  let count = hidden()
  churn(400)
  println("the capture survived every collection and reports {count()}")?
  Ok(())
}
