use std.html
use std.html.Html
use std.html.markup

/// One line of a log, as a page shows it.
struct Line {
  at: String
  said: String
  who: Html
}

/// The one hostile string, in the one place a page puts an unknown value.
///
/// It holds all five characters an escaper has to deal with, so a test that
/// uses it is testing the whole set rather than whichever one was remembered.
fn hostile() -> String {
  "it's \"5\" < 6 & 7 > 4"
}

/// [`hostile`] as it has to arrive on a page.
fn escaped() -> String {
  "it&#39;s &quot;5&quot; &lt; 6 &amp; 7 &gt; 4"
}

/// One row of a table, laid out over lines as markup is.
fn row(line: Line) -> Html {
  html"""
    <tr>\
      <td class="at">{line.at}</td>\
      {line.who}\
      <td>{line.said}</td>\
    </tr>
    """
}

// ------------------------------------------------------------- escaping

/// A `String` in a hole is escaped, because its type is not `Html`.
test fn escapesAStringBetweenTags() -> Result<Unit, Error> {
  let title = hostile()
  assertEqual(html"<td>{title}</td>".render(), "<td>{escaped()}</td>")?
  Ok(())
}

/// An attribute's value is escaped like everything else, `"` included, so
/// nothing a hole holds can close the quote it sits in.
test fn escapesAStringInsideAQuotedAttribute() -> Result<Unit, Error> {
  let title = hostile()
  assertEqual(
    html"<a title=\"{title}\">x</a>".render(),
    "<a title=\"{escaped()}\">x</a>",
  )?
  Ok(())
}

/// A tag written into a hole arrives as text and not as a tag.
test fn aScriptInTheDataIsNotAScript() -> Result<Unit, Error> {
  let said = "<script>&\"'"
  assertEqual(
    html"<td class=said>{said}</td>".render(),
    "<td class=said>&lt;script&gt;&amp;&quot;&#39;</td>",
  )?
  Ok(())
}

/// The literal's own text is the template's characters and goes in as
/// written, quotes and all.
test fn theLiteralTextIsNotEscaped() -> Result<Unit, Error> {
  assertEqual(
    html"<p class=\"a&b\">'x'</p>".render(),
    "<p class=\"a&b\">'x'</p>",
  )?
  Ok(())
}

// ----------------------------------------------------------------- markup

/// An `Html` in a hole goes in whole: it is already markup.
test fn anHtmlHoleGoesInWhole() -> Result<Unit, Error> {
  let cell = markup("<td>&amp;</td>")
  assertEqual(html"<tr>{cell}</tr>".render(), "<tr><td>&amp;</td></tr>")?
  Ok(())
}

/// An `Array<Html>` goes in element by element, in order, with nothing
/// between them.
test fn anArrayOfHtmlGoesInOneAfterAnother() -> Result<Unit, Error> {
  let words = ["a<", "b&"]
  let cells = words.map(fn(word) {
    html"<td>{word}</td>"
  })
  assertEqual(
    html"<tr>{cells}</tr>".render(),
    "<tr><td>a&lt;</td><td>b&amp;</td></tr>",
  )?
  let none: Array<Html> = []
  assertEqual(html"<tr>{none}</tr>".render(), "<tr></tr>")?
  Ok(())
}

/// An `Array` of anything else is rendered as a plain literal renders it, and
/// that text escaped.
test fn anArrayThatIsNotMarkupIsEscaped() -> Result<Unit, Error> {
  let words = ["<b>", "&"]
  assertEqual(html"{words}".render(), "[&lt;b&gt;, &amp;]")?
  Ok(())
}

/// A literal in a hole is a page in a page.
test fn aNestedLiteralGoesInWhole() -> Result<Unit, Error> {
  let name = "<i>"
  assertEqual(
    html"<p>{html"<b>{name}</b>"}</p>".render(),
    "<p><b>&lt;i&gt;</b></p>",
  )?
  Ok(())
}

/// A condition is an `if` expression, and its type decides as any hole's
/// does.
test fn anIfInAHoleIsAnExpression() -> Result<Unit, Error> {
  let set = true
  assertEqual(
    html"<button>{if set { "Replace" } else { "<Set>" }}</button>".render(),
    "<button>Replace</button>",
  )?
  let unset = false
  assertEqual(
    html"<button>{if unset { "Replace" } else { "<Set>" }}</button>".render(),
    "<button>&lt;Set&gt;</button>",
  )?
  assertEqual(
    html"<p>{if set { markup("<b>on</b>") } else { html"" }}</p>".render(),
    "<p><b>on</b></p>",
  )?
  Ok(())
}

/// A value that is not a `String` is written as the language writes it.
test fn anIntAndABoolAreWrittenAsEver() -> Result<Unit, Error> {
  let count = -42
  let live = true
  assertEqual(
    html"<td>{count}</td><td>{live}</td>".render(),
    "<td>-42</td><td>true</td>",
  )?
  Ok(())
}

/// A hole is any expression, a field of a struct included.
test fn aFieldOfAStructIsAHole() -> Result<Unit, Error> {
  let line = Line(at: "09:00 & on", said: "hi", who: markup("<td>me</td>"))
  assertEqual(
    html"<td>{line.at}</td>{line.who}".render(),
    "<td>09:00 &amp; on</td><td>me</td>",
  )?
  Ok(())
}

// --------------------------------------------------------------- layout

/// A `"""` literal laid out one element to a line, with `\` joining the lines,
/// is one line of markup.
test fn aLiteralOverLinesIsOneLine() -> Result<Unit, Error> {
  let line = Line(at: "09:00", said: hostile(), who: markup("<td>me</td>"))
  assertEqual(
    row(line).render(),
    "<tr><td class=\"at\">09:00</td><td>me</td><td>{escaped()}</td></tr>",
  )?
  Ok(())
}

/// A space wanted between two inline elements may be written before the `\`;
/// the line breaks around them, between tags, are nothing (ADR 0103).
test fn aSpaceAtAJoinIsWrittenBeforeTheBackslash() -> Result<Unit, Error> {
  let figure = 3
  let page = html"""
    <p>
      <b>{figure}</b> \
      <span class=muted>rows</span>
    </p>
    """
  assertEqual(page.render(), "<p><b>3</b> <span class=muted>rows</span></p>")?
  Ok(())
}

/// A literal with no hole is itself.
test fn aLiteralWithNoHoleIsItself() -> Result<Unit, Error> {
  assertEqual(html"<hr>".render(), "<hr>")?
  assertEqual(html"".render(), "")?
  Ok(())
}

// ----------------------------------------------- one-line """ literals

/// A `"""` with text after it on its line is a one-line literal (ADR 0102):
/// a quote in it is the template's own character, as in the form over lines.
test fn aOneLineLiteralHoldsQuotesAsWritten() -> Result<Unit, Error> {
  let at = "/a&b"
  let name = "<kv>"
  assertEqual(
    html"""<a href="{at}/kv">{name}</a>""".render(),
    "<a href=\"/a&amp;b/kv\">&lt;kv&gt;</a>",
  )?
  Ok(())
}

/// Its leading space is content, and a fragment may end on an attribute's
/// closing quote: the last three quotes of a run close it.
test fn aOneLineLiteralKeepsItsSpacesAndItsLastQuote() -> Result<Unit, Error> {
  let level = "warn"
  assertEqual(html""" class="is-{level}"""".render(), " class=\"is-warn\"")?
  assertEqual(
    html"<p{html""" class="is-{level}""""}>x</p>".render(),
    "<p class=\"is-warn\">x</p>",
  )?
  assertEqual(html"""""".render(), "")?
  Ok(())
}

// ----------------------------------------------- markup, nothing, join, render

/// `markup` takes text at its word, and is the one way past escaping.
test fn markupIsTakenAtItsWord() -> Result<Unit, Error> {
  assertEqual(markup("<b>&</b>").render(), "<b>&</b>")?
  Ok(())
}

/// `html""` is no markup at all, and is what a page puts where a part is
/// absent; `==` tells it from markup that is there.
test fn anEmptyLiteralIsNoMarkupAtAll() -> Result<Unit, Error> {
  assertEqual(html"".render(), "")?
  assertEqual(html"<p>{html""}</p>".render(), "<p></p>")?
  assertEqual(html"" == markup(""), true)?
  assertEqual(html"" == html"<p>", false)?
  Ok(())
}

/// `join` puts markup between each two parts and nothing around them.
test fn joinPutsMarkupBetweenEachTwo() -> Result<Unit, Error> {
  let names = ["a", "<b>", "c"]
  let links = names.map(fn(name) {
    html"<a>{name}</a>"
  })
  assertEqual(
    html.join(links, html" · ").render(),
    "<a>a</a> · <a>&lt;b&gt;</a> · <a>c</a>",
  )?
  let one = [html"<i>x</i>"]
  assertEqual(html.join(one, html", ").render(), "<i>x</i>")?
  let none: Array<Html> = []
  assertEqual(html.join(none, html", "), html"")?
  Ok(())
}

/// The module is usable qualified, as any module is.
test fn isUsableAsAQualifiedModule() -> Result<Unit, Error> {
  let count = 42
  assertEqual(html.markup("<b>x</b>").render(), "<b>x</b>")?
  assertEqual(html"<i>{count}</i>".render(), "<i>42</i>")?
  assertEqual(html.join([html"a", html"b"], html"").render(), "ab")?
  Ok(())
}

// ----------------------------------- a line break in html""" (ADR 0103)

/// Between two tags, or a tag and a hole, a line break and the indentation
/// after it are nothing.
test fn aBreakBetweenTagsIsNothing() -> Result<Unit, Error> {
  let name = "<q>"
  let page = html"""
    <tr>
      <td class=title><code>{name}</code></td>
      <td>
        {name}
      </td>
    </tr>
    """
  assertEqual(
    page.render(),
    "<tr><td class=title><code>&lt;q&gt;</code></td><td>&lt;q&gt;</td></tr>",
  )?
  Ok(())
}

/// Anywhere else a line break is one space, so prose wraps as prose.
test fn aBreakInProseIsOneSpace() -> Result<Unit, Error> {
  let version = "1.2"
  let page = html"""
    What <code>{version}</code> is made of: its
    <code>app.toml</code>, its
    {version}


    and more
    """
  assertEqual(
    page.render(),
    "What <code>1.2</code> is made of: its <code>app.toml</code>, its 1.2 and more",
  )?
  Ok(())
}

/// A `\` still joins with nothing, and `\n` is still a newline.
test fn aBackslashAndAnEscapedNewlineKeepTheirMeaning() -> Result<Unit, Error> {
  let page = html"""
    <p>un\
      done</p>
    <pre>a\nb</pre>
    """
  assertEqual(page.render(), "<p>undone</p><pre>a\nb</pre>")?
  Ok(())
}
