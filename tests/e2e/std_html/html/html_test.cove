use std.html
use std.html.Html
use std.html.empty
use std.html.markup
use std.html.render

/// One line of a log, as a page shows it.
struct Line {
  at: String
  said: String
  who: Html
}

/// The one hostile string, in the one place a page puts an unknown value.
///
/// It holds all five characters an escaper has to deal with, so a test that
/// uses it is testing the whole set rather than whichever one was remembered.
fn hostile() -> String {
  "it's \"5\" < 6 & 7 > 4"
}

/// [`hostile`] as it has to arrive on a page.
fn escaped() -> String {
  "it&#39;s &quot;5&quot; &lt; 6 &amp; 7 &gt; 4"
}

/// One row of a table, laid out over lines as markup is.
fn row(line: Line) -> Html {
  html"""
    <tr>\
      <td class="at">{line.at}</td>\
      {line.who}\
      <td>{line.said}</td>\
    </tr>
    """
}

// ------------------------------------------------------------- escaping

/// A `String` in a hole is escaped, because its type is not `Html`.
test fn escapesAStringBetweenTags() -> Result<Unit, Error> {
  let title = hostile()
  assertEqual(render(html"<td>{title}</td>"), "<td>{escaped()}</td>")?
  Ok(())
}

/// An attribute's value is escaped like everything else, `"` included, so
/// nothing a hole holds can close the quote it sits in.
test fn escapesAStringInsideAQuotedAttribute() -> Result<Unit, Error> {
  let title = hostile()
  assertEqual(
    render(html"<a title=\"{title}\">x</a>"),
    "<a title=\"{escaped()}\">x</a>",
  )?
  Ok(())
}

/// A tag written into a hole arrives as text and not as a tag.
test fn aScriptInTheDataIsNotAScript() -> Result<Unit, Error> {
  let said = "<script>&\"'"
  assertEqual(
    render(html"<td class=said>{said}</td>"),
    "<td class=said>&lt;script&gt;&amp;&quot;&#39;</td>",
  )?
  Ok(())
}

/// The literal's own text is the template's characters and goes in as
/// written, quotes and all.
test fn theLiteralTextIsNotEscaped() -> Result<Unit, Error> {
  assertEqual(
    render(html"<p class=\"a&b\">'x'</p>"),
    "<p class=\"a&b\">'x'</p>",
  )?
  Ok(())
}

// ----------------------------------------------------------------- markup

/// An `Html` in a hole goes in whole: it is already markup.
test fn anHtmlHoleGoesInWhole() -> Result<Unit, Error> {
  let cell = markup("<td>&amp;</td>")
  assertEqual(render(html"<tr>{cell}</tr>"), "<tr><td>&amp;</td></tr>")?
  Ok(())
}

/// An `Array<Html>` goes in element by element, in order, with nothing
/// between them.
test fn anArrayOfHtmlGoesInOneAfterAnother() -> Result<Unit, Error> {
  let words = ["a<", "b&"]
  let cells = words.map(fn(word) {
    html"<td>{word}</td>"
  })
  assertEqual(
    render(html"<tr>{cells}</tr>"),
    "<tr><td>a&lt;</td><td>b&amp;</td></tr>",
  )?
  let none: Array<Html> = []
  assertEqual(render(html"<tr>{none}</tr>"), "<tr></tr>")?
  Ok(())
}

/// An `Array` of anything else is rendered as a plain literal renders it, and
/// that text escaped.
test fn anArrayThatIsNotMarkupIsEscaped() -> Result<Unit, Error> {
  let words = ["<b>", "&"]
  assertEqual(render(html"{words}"), "[&lt;b&gt;, &amp;]")?
  Ok(())
}

/// A literal in a hole is a page in a page.
test fn aNestedLiteralGoesInWhole() -> Result<Unit, Error> {
  let name = "<i>"
  assertEqual(
    render(html"<p>{html"<b>{name}</b>"}</p>"),
    "<p><b>&lt;i&gt;</b></p>",
  )?
  Ok(())
}

/// A condition is an `if` expression, and its type decides as any hole's
/// does.
test fn anIfInAHoleIsAnExpression() -> Result<Unit, Error> {
  let set = true
  assertEqual(
    render(html"<button>{if set { "Replace" } else { "<Set>" }}</button>"),
    "<button>Replace</button>",
  )?
  let unset = false
  assertEqual(
    render(html"<button>{if unset { "Replace" } else { "<Set>" }}</button>"),
    "<button>&lt;Set&gt;</button>",
  )?
  assertEqual(
    render(html"<p>{if set { markup("<b>on</b>") } else { empty() }}</p>"),
    "<p><b>on</b></p>",
  )?
  Ok(())
}

/// A value that is not a `String` is written as the language writes it.
test fn anIntAndABoolAreWrittenAsEver() -> Result<Unit, Error> {
  let count = -42
  let live = true
  assertEqual(
    render(html"<td>{count}</td><td>{live}</td>"),
    "<td>-42</td><td>true</td>",
  )?
  Ok(())
}

/// A hole is any expression, a field of a struct included.
test fn aFieldOfAStructIsAHole() -> Result<Unit, Error> {
  let line = Line(at: "09:00 & on", said: "hi", who: markup("<td>me</td>"))
  assertEqual(
    render(html"<td>{line.at}</td>{line.who}"),
    "<td>09:00 &amp; on</td><td>me</td>",
  )?
  Ok(())
}

// --------------------------------------------------------------- layout

/// A `"""` literal laid out one element to a line, with `\` joining the lines,
/// is one line of markup.
test fn aLiteralOverLinesIsOneLine() -> Result<Unit, Error> {
  let line = Line(at: "09:00", said: hostile(), who: markup("<td>me</td>"))
  assertEqual(
    render(row(line)),
    "<tr><td class=\"at\">09:00</td><td>me</td><td>{escaped()}</td></tr>",
  )?
  Ok(())
}

/// A space wanted between two inline elements is written before the `\`.
test fn aSpaceAtAJoinIsWrittenBeforeTheBackslash() -> Result<Unit, Error> {
  let figure = 3
  let page = html"""
    <p>
      <b>{figure}</b> \
      <span class=muted>rows</span>
    </p>
    """
  assertEqual(
    render(page),
    "<p>\n  <b>3</b> <span class=muted>rows</span>\n</p>",
  )?
  Ok(())
}

/// A literal with no hole is itself.
test fn aLiteralWithNoHoleIsItself() -> Result<Unit, Error> {
  assertEqual(render(html"<hr>"), "<hr>")?
  assertEqual(render(html""), "")?
  Ok(())
}

// ------------------------------------------------- markup, empty, render

/// `markup` takes text at its word, and is the one way past escaping.
test fn markupIsTakenAtItsWord() -> Result<Unit, Error> {
  assertEqual(render(markup("<b>&</b>")), "<b>&</b>")?
  Ok(())
}

/// `empty` is no markup at all.
test fn emptyIsNoMarkupAtAll() -> Result<Unit, Error> {
  assertEqual(render(empty()), "")?
  assertEqual(render(html"<p>{empty()}</p>"), "<p></p>")?
  Ok(())
}

/// The module is usable qualified, as any module is.
test fn isUsableAsAQualifiedModule() -> Result<Unit, Error> {
  let count = 42
  assertEqual(html.render(html.markup("<b>x</b>")), "<b>x</b>")?
  assertEqual(html.render(html"<i>{count}</i>"), "<i>42</i>")?
  assertEqual(html.render(html.empty()), "")?
  Ok(())
}
