use console.println

/// Prints `Vector` construction, mutation, replacement, removal, aliasing,
/// and `toArray`.
export fn main() -> Result<Unit, Error> {
  var first = Vector.of(1, 2)
  println("of {first} length {first.length()}")?

  first.push(3)
  println("push {first} length {first.length()}")?

  var second = first
  second.push(4)
  println("an alias observes the push {first} {second}")?
  println("both handles report {first.length()} {second.length()}")?

  let view = first
  println("a `let` handle is a read-only view of shared storage {view}")?

  let copied = first.toArray()
  second.push(5)
  println("toArray produced an independent array {copied}")?
  println("the vector kept growing {second}")?

  println("get {first.get(0)} {first.get(99)}")?
  println("length {first.length()} isEmpty {first.isEmpty()}")?

  // `set` replaces and answers what was there, and it writes through the
  // shared storage the way `push` does, so the alias sees it. An index that
  // is not already in the vector answers `None` and writes nothing, which is
  // exactly what `get` answers for the same index.
  println("set answers what was there {first.set(0, 100)}")?
  println("the alias observes the replacement {second}")?
  println(
    "out of range {first.set(99, 0)} {first.set(-1, 0)} unchanged {first}",
  )?
  println("set never grows the vector {first.set(first.length(), 0)} {first.length()}")?

  // `pop` and `remove` take an element back out. Both are imperative verbs
  // because both write through the receiver, unlike `Set.removed`, which
  // answers a new set. Both answer `Some` of what they took, and an index
  // that is not already in the vector — including the `-1` a `pop` on an
  // empty vector asks about — answers `None` and removes nothing.
  var shrinking = Vector.of(1, 2, 3, 4)
  println("pop {shrinking.pop()} {shrinking}")?
  println("remove {shrinking.remove(0)} {shrinking}")?
  println(
    "out of range {shrinking.remove(9)} {shrinking.remove(-1)} {shrinking}",
  )?
  var alias = shrinking
  let taken = alias.pop()
  println("an alias observes the shrink {taken} {shrinking} {alias}")?

  // A removal moves the indices a replacement leaves alone: `indexOf` before
  // the removal is stale after it.
  var positions = Vector.of(10, 20, 30)
  let before = positions.indexOf(30)
  let gone = positions.remove(0)
  println("a stale position {before} {positions.indexOf(30)} {gone}")?

  // `for` asks for the elements once and walks what it was given, so a body
  // that empties the vector still visits every one of them.
  var walked = Vector.of(1, 2, 3)
  var seen = 0
  for level in walked {
    seen += level
    let ignored = walked.pop()
  }
  println("a walk that empties as it goes {seen} {walked}")?

  // Membership, position, and a part of the sequence: the same three an
  // `Array` answers, and `slice` answers an `Array` from a `Vector` too.
  println("contains {first.contains(100)} {first.contains(99)}")?
  println("indexOf {first.indexOf(100)} {first.indexOf(99)}")?
  println("slice {first.slice(0, 2)} {first.slice(-5, 99)}")?

  var empty: Vector<Int> = Vector.of()
  println("empty {empty} {empty.isEmpty()}")?
  println(
    "empty answers {empty.contains(1)} {empty.indexOf(1)} {empty.set(0, 1)}",
  )?
  println("empty shrinks to nothing {empty.pop()} {empty.remove(0)}")?
  Ok(())
}
