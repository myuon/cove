use console.println

/// Shows what a loop is worth: every loop produces `Unit`, whatever its
/// `break` carries — an operand there is evaluated for its effects and its
/// value discarded — and `continue` skips to the next iteration.
export fn main() -> Result<Unit, Error> {
  var firstMultipleOfThree = 0
  let scanned = for value in [1, 2, 3, 4, 5] {
    if value % 3 == 0 {
      firstMultipleOfThree = value
      break value
    }
  }
  println("first multiple of three: {firstMultipleOfThree}")?
  println("the `for` that found it is worth {scanned}")?

  let neverBreaks = for value in [1, 2] {
    value
  }
  println("loop with no break: {neverBreaks}")?

  var oddTotal = 0
  for value in [1, 2, 3, 4, 5, 6] {
    if value % 2 == 0 {
      continue
    }
    oddTotal += value
  }
  println("sum of odd values: {oddTotal}")?

  var attempts = 0
  let settled = while true {
    attempts += 1
    if attempts == 3 {
      break attempts
    }
  }
  println("while settled after {attempts} attempt(s), and is worth {settled}")?

  Ok(())
}
