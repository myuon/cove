use console.println

/// A point in the plane.
export struct Point {
  x: Int
  y: Int
}

/// A line between two points.
export struct Segment {
  start: Point
  end: Point
}

/// A struct whose fields are written one per line, as `cove fmt` renders them.
export struct Tag {
  name: String
  weight: Int
}

/// Initializes structs and reads their fields, and then writes one
/// initializer whose labels stand out of declaration order.
///
/// A synthesized struct initializer takes its labels in declaration order
/// exactly as an ordinary function does, and `cove check` refuses the last
/// one rather than the run — so nothing above it happens either and
/// `expected.out` is empty. It was a run-time failure until ADR 0021 moved
/// the rule into the checker; this case is in a package of its own because it
/// no longer checks. `type_struct_copy` is the case that still *runs* struct
/// initialization, field reads and rendering.
export fn main() -> Result<Unit, Error> {
  let point = Point(x: 1, y: 2)
  println("point {point}")?
  println("fields {point.x} {point.y}")?

  let segment = Segment(start: point, end: Point(x: 3, y: 4))
  println("segment {segment}")?
  println("nested fields {segment.start.x} {segment.end.y}")?

  let tag = Tag(name: "north", weight: 5)
  println("third struct {tag} {tag.name}")?

  let reordered = Point(y: 20, x: 10)
  println("initializer labels out of declaration order {reordered}")?
  Ok(())
}
