use console.println

/// Shifts right logically by the least `Int`, which
/// `Int.shiftRightLogical` refuses by stopping the run. Its low six bits are
/// all nought, so a CPU that masked the count would have shifted by nothing
/// and answered the receiver; the count is checked instead, and the
/// diagnostic names all of it. It blames the call in `shifted`, and the
/// `native` file holds the native tier, which compiles `shifted`, to the same
/// sentence and the same blame.
export fn main() -> Result<Unit, Error> {
  let count = -9223372036854775807 - 1
  println("count {count}")?
  println("never printed {shifted(-1, count, 1)}")?
  Ok(())
}

/// `x.shiftRightLogical(n)`, in a function the native tier compiles. It
/// calls itself once first, so that the inliner cannot expand it into `main`.
fn shifted(x: Int, n: Int, depth: Int) -> Int {
  if depth > 0 {
    return shifted(x, n, depth - 1)
  }
  x.shiftRightLogical(n)
}
