use console.println

/// `Int`'s seven bit operations, ADR 0074's contract: an `Int` read as a
/// 64-bit two's-complement word, and a shift count checked rather than masked.
///
/// The first block is the ADR's own table, row for row. The rest are the
/// boundary operands — nought, all ones, both ends of `Int` and the two
/// alternating masks — and the two facts the contract is most easily got
/// wrong on: a left shift that discards bits is not an overflow, and an
/// arithmetic right shift of a negative number is a floor and not a
/// truncation toward zero.
export fn main() -> Result<Unit, Error> {
  let least = -9223372036854775807 - 1
  let most = 9223372036854775807
  let fives = 6148914691236517205
  let aces = -6148914691236517206

  println("adr {5.bitAnd(3)} {5.bitOr(3)} {5.bitXor(3)}")?
  println("adr {0.bitNot()} {(-1).bitNot()}")?
  println("adr {1.shiftLeft(63)} {(-1).shiftLeft(1)} {(-3).shiftRight(1)}")?
  println("adr {(-1).shiftRightLogical(1)} {(-1).shiftRightLogical(63)}")?

  println("and {least.bitAnd(most)} {(-1).bitAnd(least)} {fives.bitAnd(aces)} {0.bitAnd(-1)}")?
  println(
    "or {least.bitOr(most)} {fives.bitOr(aces)} {least.bitOr(1)} {0.bitOr(0)}",
  )?
  println("xor {least.bitXor(-1)} {most.bitXor(most)} {fives.bitXor(aces)} {(-1).bitXor(fives)}")?
  println(
    "not {least.bitNot()} {most.bitNot()} {fives.bitNot()} {aces.bitNot()}",
  )?

  println("zero {least.shiftLeft(0)} {least.shiftRight(0)} {least.shiftRightLogical(0)}")?
  println(
    "zero {most.shiftLeft(0)} {most.shiftRight(0)} {most.shiftRightLogical(0)}",
  )?
  println("left {most.shiftLeft(1)} {3.shiftLeft(62)} {(-1).shiftLeft(63)} {fives.shiftLeft(1)}")?
  println("left {least.shiftLeft(1)} {1.shiftLeft(62)} {aces.shiftLeft(63)} {fives.shiftLeft(63)}")?
  println("floor {(-3).shiftRight(1)} {(-1).shiftRight(63)} {(-5).shiftRight(2)} {(-8).shiftRight(3)}")?
  println("floor {least.shiftRight(63)} {least.shiftRight(1)} {aces.shiftRight(1)} {most.shiftRight(62)}")?
  println("logical {least.shiftRightLogical(63)} {least.shiftRightLogical(1)} {aces.shiftRightLogical(1)}")?
  println("logical {(-2).shiftRightLogical(1)} {(-3).shiftRightLogical(62)} {most.shiftRightLogical(63)}")?

  // Every valid count, on an operand that is all ones: the three shifts
  // agree at 0 and separate at every count after it.
  var n = 0
  var left = 0
  var right = 0
  var logical = 0
  while n < 64 {
    left = left.bitXor((-1).shiftLeft(n))
    right = right + (-1).shiftRight(n)
    logical = logical.bitXor((-1).shiftRightLogical(n))
    n = n + 1
  }
  println("sweep {left} {right} {logical}")?
  Ok(())
}
