use console.println

/// Classifies `n` with an `if` chain used as an expression.
fn classify(n: Int) -> String {
  if n < 0 {
    "negative"
  } else if n == 0 {
    "zero"
  } else {
    "positive"
  }
}

/// Prints `if` used as an expression and as a statement.
export fn main() -> Result<Unit, Error> {
  println("expression {classify(-1)} {classify(0)} {classify(1)}")?

  let bound = if classify(2) == "positive" {
    1
  } else {
    2
  }
  println("bound {bound}")?

  var seen = "none"
  if bound == 1 {
    seen = "one"
  }
  println("statement {seen}")?

  if bound == 99 {
    seen = "ninety nine"
  } else {
    seen = "other"
  }
  println("statement with else {seen}")?

  let withoutElse = if false {
    1
  }
  println("an `if` with no `else` and a false condition is {withoutElse}")?

  var ran = false
  let takenWithoutElse = if bound == 1 {
    ran = true
    1
  }
  println("its branch ran: {ran}")?
  println("an `if` with no `else` whose branch ran is {takenWithoutElse}")?
  Ok(())
}
