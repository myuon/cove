use console.println

/// A program run on the backend that runs programs, named explicitly.
///
/// Every other case in this suite reaches that backend by default. This one
/// writes the flag out, which is what makes it the case that would notice if
/// `--backend` stopped selecting anything: the same source, the same host,
/// and the same output as an interpreted run, reached by asking for the
/// backend by name.
///
/// It is its own package because it names a command of its own, which is how
/// a case opts out of the both-backends comparison the shared package's cases
/// get.
export fn main() -> Result<Unit, Error> {
  var total = 0
  var i = 1
  while i <= 5 {
    total += i * i
    i += 1
  }
  println("the vm counted {total}")?
  Ok(())
}
