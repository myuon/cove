use console.println

/// Declares `Int` and produces a `String`.
///
/// A function's return type is written at its boundary, so its body is
/// checked against it. This case lives in its own package so that
/// check-time failure cannot take down every other case.
fn total(items: Array<Int>) -> Int {
  "{items.length()}"
}

/// Never runs.
export fn main() -> Result<Unit, Error> {
  println("{total([1, 2])}")?
  Ok(())
}
