use console.println
use console.eprintln

/// `[run.fail_console_error_not_granted]` grants `console` and not
/// `console.error`, so the record is written and the complaint about it is
/// refused. The two streams are two capabilities: a grant written when
/// `console` was the whole module reaches exactly what it reached then, and
/// a host that means to capture a program's output without hearing about it
/// says so this way.
export fn main() -> Result<Unit, Error> {
  println("harbour-loft,3")?
  eprintln("record 2 has no `nights` field, skipping")?
  Ok(())
}
