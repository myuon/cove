+++ b/crates/cove-native/src/template.rs
@@ -4274,7 +4274,8 @@ impl<'a> Emit<'a> {
         match op {
             ArithOp::Add => {
                 self.add_rr(RAX, RCX);
-                self.raise_unless(CC_NO, overflow);
+                // COVE-MUTANT 005-native-int-add-unchecked
