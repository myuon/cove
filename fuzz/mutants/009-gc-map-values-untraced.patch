# 009-gc-map-values-untraced
#
# A collection does not trace the values of a map's entries, only their
# keys. Wrong only when a value is the last reference to an object and
# the object is read after its block is reused.
#
# An artificial defect for measuring the fuzzing harness (issue 681).
# Never applied to this tree: scripts/fuzz-mutant.sh applies it in a
# scratch worktree. docs/FUZZ_EVALUATION.md records what found it.
diff --git a/crates/cove-runtime/src/vm/mem.rs b/crates/cove-runtime/src/vm/mem.rs
index be852531..40c19eaa 100644
--- a/crates/cove-runtime/src/vm/mem.rs
+++ b/crates/cove-runtime/src/vm/mem.rs
@@ -1717,7 +1717,8 @@ impl Space {
                 let stride = key.width() + value.width();
                 for at in 0..len {
                     self.trace_run(alloc, addr, at * stride, &key.words, work);
-                    self.trace_run(alloc, addr, at * stride + key.width(), &value.words, work);
+                    // COVE-MUTANT 009-gc-map-values-untraced
+                    let _ = value;
                 }
             }
