use console.println

struct Held {
  name: String
  items: Array<Int>
  tag: Int
}

// A struct whose fields are references, held in a compiled frame while it
// allocates enough to collect, then read field by field.
fn holdStruct(seed: Int) -> String {
  let held = Held(name: "name:{seed}:{seed * 31}", items: [seed, seed * 2, seed * 3, seed * 4], tag: seed)
  var junk = 0
  var i = 0
  while i < 600 {
    let g = "junk:{i}:{seed}:{i * 31}:{i * 977}"
    junk = junk + g.byteLength()
    i += 1
  }
  let total = held.items.fold(0, fn(p, x) { p + x })
  "{held.name} {held.items} {total} {held.tag} {junk}"
}

export fn main() -> Result<Unit, Error> {
  println(holdStruct(7))?
  println(holdStruct(11))?
  Ok(())
}
