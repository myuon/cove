/// Fetches independent values within one observable task scope.
module examples.tasks {
  provides { loadDashboard }
  uses { api.fetch clock.timeout }
}

struct Dashboard {
  bookings: List<Booking>
  prices: List<Price>
}

/// Loads independent dashboard inputs concurrently.
@hot
async fn loadDashboard() -> Result<Dashboard, Error> {
  scope tasks {
    let bookings = tasks.spawn { api.fetch<List<Booking>>("/bookings") }
    let prices = tasks.spawn { api.fetch<List<Price>>("/prices") }

    let result = clock.timeout(500ms) {
      Dashboard {
        bookings: bookings.await()?,
        prices: prices.await()?
      }
    }?

    Ok(result)
  }
}
