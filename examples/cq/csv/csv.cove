use cq.diag.Detail

/// Splits one CSV line into its fields.
///
/// The rules are RFC 4180's, with one deliberate exception. A field may be
/// quoted with `"`, a quoted field may contain commas, and `""` inside a
/// quoted field is one literal quote. An unquoted field is taken exactly as
/// written, including any spaces around it: trimming would be this program
/// deciding that a value the input chose to include was not meant.
///
/// The exception is that a record may not span lines. RFC 4180 lets a quoted
/// field contain a newline, and the reader upstream of this hands over one
/// line at a time, so a quoted field that is still open when the line ends is
/// reported rather than continued. Making it work means the reader and the
/// splitter having to agree about quoting, which is the format leaking into
/// the layer whose whole job is not to know about it.
export fn splitRecord(line: String) -> Result<Array<String>, Detail> {
  var fields = Vector.of()
  let end = line.byteLength()
  var at = 0
  // A field is the run of bytes from `start` to the cursor, and `built` is
  // what earlier runs of the same field contributed. `built` is empty for
  // every field that contains no `""`, which is nearly all of them, so the
  // common field is taken out in one `sliceBytes` and nothing is copied per
  // character. What this replaced was `field = "{field}{character}"`, which
  // copied the field so far on every character and was quadratic in its
  // length — issue #292.
  var start = 0
  var built = ""
  var position = Position.Start
  var reading = true
  while reading {
    // The scalar at the cursor and how many bytes it occupies, read together
    // because the width is a function of the value: a `String` is valid UTF-8
    // in its shortest form, so nothing has to look at the bytes twice. `-1`
    // stands for the end of the line the way `""` used to, and no scalar is
    // negative. Both are written out rather than called, because a call per
    // character is what `examples/cq/README.md` measured as doubling a loop
    // of this shape.
    var character = -1
    var advance = 1
    match line.codePointAtByte(at) {
      Some(scalar) => {
        character = scalar
        if scalar < 128 {
          advance = 1
        } else if scalar < 2048 {
          advance = 2
        } else if scalar < 65536 {
          advance = 3
        } else {
          advance = 4
        }
      }
      None => { }
    }
    match position {
      Position.Start => {
        if character == -1 {
          fields.push(taken(line, built, start, at))
          reading = false
        } else if character == 34 {
          // `"`
          position = Position.Quoted
          at += 1
          start = at
        } else if character == 44 {
          // `,`
          fields.push(taken(line, built, start, at))
          built = ""
          at += 1
          start = at
        } else {
          position = Position.Plain
          at += advance
        }
      }
      Position.Plain => {
        if character == -1 {
          fields.push(taken(line, built, start, at))
          reading = false
        } else if character == 44 {
          // `,`
          fields.push(taken(line, built, start, at))
          built = ""
          position = Position.Start
          at += 1
          start = at
        } else if character == 34 {
          // `"`
          return Err(Detail(column: columnAt(line, at), message: "a quote may only open a field, not appear inside an unquoted one"))
        } else {
          at += advance
        }
      }
      Position.Quoted => {
        if character == -1 {
          return Err(Detail(column: columnAt(line, at), message: "a quoted field was still open when the line ended"))
        } else if character == 34 {
          // `"`
          if line.codePointAtByte(at + 1).unwrapOr(-1) == 34 {
            // The one place a field is not a single run: the escape ends this
            // run, contributes the literal quote, and the next run starts
            // past both.
            built = "{taken(line, built, start, at)}\""
            at += 2
            start = at
          } else {
            built = taken(line, built, start, at)
            position = Position.Closed
            at += 1
            start = at
          }
        } else {
          at += advance
        }
      }
      Position.Closed => {
        if character == -1 {
          fields.push(taken(line, built, start, at))
          reading = false
        } else if character == 44 {
          // `,`
          fields.push(taken(line, built, start, at))
          built = ""
          position = Position.Start
          at += 1
          start = at
        } else {
          return Err(Detail(column: columnAt(line, at), message: "a quoted field must end at a `,` or at the end of the record, and `{line.sliceBytes(at, at + advance).unwrapOr("")}` follows this one"))
        }
      }
    }
  }
  Ok(fields.freeze())
}

/// The field text `built` and the run from `start` to `at` spell together.
///
/// The two short-circuits are the point rather than a nicety: a field with no
/// `""` in it takes the second branch and is one slice, and a field that
/// closed on its quote takes the first and is not copied again.
fn taken(line: String, built: String, start: Int, at: Int) -> String {
  if at <= start {
    built
  } else if built.isEmpty() {
    line.sliceBytes(start, at).unwrapOr("")
  } else {
    "{built}{line.sliceBytes(start, at).unwrapOr("")}"
  }
}

/// The character position, counting from 1, of byte offset `at`.
///
/// A `Detail`'s column has always counted characters and still does; the
/// cursor above counts bytes, so the two have to be converted somewhere. It
/// is here, on the error path, which is taken once for a record that is wrong
/// and never for one that is right — the whole reason the cursor was allowed
/// to become a byte offset.
fn columnAt(line: String, at: Int) -> Int {
  line.sliceBytes(0, at).unwrapOr("").length() + 1
}

/// Where the splitter is in a record.
///
/// `Closed` is the state that makes this a machine rather than a flag. Without
/// it, a splitter that has just read a closing quote is back where an unquoted
/// field begins, so `"a"x` reads as `ax` -- the input is not rejected, it is
/// accepted as a different value, which is the worst thing a data tool can do.
/// A quoted field ends at a `,` or at the end of the record, and anything else
/// after the closing quote is reported.
enum Position {
  /// At the start of a field, where a quote may open one.
  Start
  /// Inside an unquoted field, where a quote may not appear.
  Plain
  /// Inside a quoted field, where `""` is one literal quote.
  Quoted
  /// Just past a quoted field's closing quote.
  Closed
}

/// Renders `fields` as one CSV line, without its terminator.
export fn formatRecord(fields: Array<String>) -> String {
  var rendered = Vector.of()
  for field in fields {
    rendered.push(formatField(field))
  }
  ",".join(rendered.freeze())
}

/// Renders one field, quoting it only when leaving it bare would change what
/// it says.
///
/// A field is quoted when it holds a comma, a quote, or either half of a line
/// ending, and left alone otherwise, so a file of ordinary values reads as a
/// file of ordinary values.
fn formatField(field: String) -> String {
  if field.contains(",") || field.contains("\"") || field.contains("\n") ||
    field.contains("\r") {
    "\"{field.replace("\"", "\"\"")}\""
  } else {
    field
  }
}
