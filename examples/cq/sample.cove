use console.println
use files
use process.args

/// Writes a deterministic sample of bookings, for measuring.
///
/// The large input this example's numbers were taken over is not checked in --
/// a hundred thousand records is fifteen megabytes, and a repository is a bad
/// place to keep one. It is generated instead, by this, from a seed, so the
/// file two people measure over is the same file.
///
/// The writer is the same `files.Writer` the transformations write through, so
/// generating the input is itself a streaming job: this holds one record at a
/// time exactly as `cq` does.
export fn sample() -> Result<Unit, Error> {
  let arguments = args()
  let count = match arguments.get(0) {
    Some(text) => Int.parse(text)?
    None => 100000
  }
  let path = arguments.get(1).unwrapOr("bookings-large.jsonl")
  let writer = files.create(path)?
  var seed = 1
  for i in 0..<count {
    seed = nextSeed(seed)
    writer.writeLine(record(i + 1, seed))?
  }
  writer.close()?
  println("cq: wrote {count} records to {path}")
}

/// One record, as the line it takes in the file.
///
/// Built by interpolation rather than through `cq.json`, because this writes
/// JSON and `cq.json` reads it: generating the input with the same code that
/// parses it would make a round trip that agreed with itself and with nothing
/// else.
fn record(number: Int, seed: Int) -> String {
  let property = properties()
    .get(seed % properties().length())
    .unwrapOr("seaside-cottage")
  let guest = guests().get(seed / 7 % guests().length()).unwrapOr("A Guest")
  let status = statuses()
    .get(seed / 11 % statuses().length())
    .unwrapOr("confirmed")
  let channel = channels()
    .get(seed / 13 % channels().length())
    .unwrapOr("direct")
  let nights = seed % 7 + 1
  let people = seed / 3 % 4 + 1
  let day = seed % 28 + 1
  let rate = rateOf(property)
  var padded = "{number}"
  for i in padded.length()..<6 {
    padded = "0{padded}"
  }
  var checkIn = "2026-03-{day}"
  if day < 10 {
    checkIn = "2026-03-0{day}"
  }
  var fields = Vector.of()
  fields.push("\"id\":\"B-{padded}\"")
  fields.push("\"guest\":\"{guest}\"")
  fields.push("\"property\":\"{property}\"")
  fields.push("\"checkIn\":\"{checkIn}\"")
  fields.push("\"nights\":{nights}")
  fields.push("\"guests\":{people}")
  fields.push("\"rate\":{rate}")
  fields.push("\"status\":\"{status}\"")
  fields.push("\"channel\":\"{channel}\"")
  "\{{",".join(fields.freeze())}\}"
}

/// The nightly rate a property charges.
fn rateOf(property: String) -> Float {
  match property {
    "seaside-cottage" => 129.5
    "harbour-loft" => 184.0
    _ => 96.25
  }
}

/// The properties a generated booking may be for.
fn properties() -> Array<String> {
  ["seaside-cottage", "harbour-loft", "orchard-barn"]
}

/// The guests a generated booking may be for.
fn guests() -> Array<String> {
  [
    "Ada Lovelace",
    "Grace Hopper",
    "Alan Turing",
    "Barbara Liskov",
    "Edsger Dijkstra",
    "Katherine Johnson",
    "Donald Knuth",
    "Frances Allen",
  ]
}

/// The statuses a generated booking may have, weighted so most are confirmed.
fn statuses() -> Array<String> {
  ["confirmed", "confirmed", "confirmed", "confirmed", "pending", "cancelled"]
}

/// The channels a generated booking may have come through.
fn channels() -> Array<String> {
  ["direct", "agency"]
}

/// The next value of a linear congruential generator.
///
/// The multiplier and modulus are the ones `rand()` was specified with, and
/// the arithmetic stays well inside `Int`, which matters here: overflow is a
/// broken invariant in Cove, so a generator that relied on wrapping would stop
/// the run rather than wrap.
fn nextSeed(seed: Int) -> Int {
  (seed * 1103515245 + 12345) % 2147483648
}
