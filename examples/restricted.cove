module examples.restricted {
  purpose "Read an allowed document without ambient filesystem access"
  provides { wordCount }
  uses { documents.read console.println }
  allow { documents console }
  entrypoints { main }
}

fn wordCount(text: String) -> Int {
  text.words().count()
}

@intent("Read only through the document capability supplied by the host")
fn main() -> Result<Unit, Error> {
  let text = documents.read("input")?
  console.println("{wordCount(text)} words")?
  Ok(())
}

// `filesystem.open(...)` must fail during checking: this module neither
// declares nor receives a filesystem capability.

