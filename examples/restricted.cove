/// Reads an allowed document without ambient filesystem access.
module examples.restricted {
  provides { wordCount }
  uses { documents.read console.println }
}

fn wordCount(text: String) -> Int {
  text.words().count()
}

/// Reads only through the document capability supplied by the host.
fn main() -> Result<Unit, Error> {
  let text = documents.read("input")?
  console.println("{wordCount(text)} words")?
  Ok(())
}

// A host that grants only `documents` and `console` rejects any attempted
// `filesystem.open(...)` call at the Host API boundary.
