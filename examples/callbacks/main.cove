use http
use console.println
use clock.every
use database

/// A callback stored by the router and invoked for each request.
export type Handler = async fn(
  request: http.Request
) -> Result<http.Response, Error>

/// A callback stored by the event bus.
export type EventHandler = async fn(
  event: Event
) -> Result<Unit, Error>

/// Task-safe application dependencies captured by request handlers.
export struct App {
  repository: BookingRepository
  metrics: Shared<Metrics>
}

/// Mutable counters shared across request tasks.
export struct Metrics {
  requests: Int
  failures: Int
}

impl Metrics {
  /// Records one completed request.
  fn record(var self, failed: Bool) {
    self.requests += 1
    if failed {
      self.failures += 1
    }
  }
}

/// Immutable routes shared by all request tasks.
export struct Router {
  routes: Array<Route>
}

/// Locally mutable route construction.
struct RouterBuilder {
  routes: Vector<Route>
}

impl RouterBuilder {
  /// Adds a route during construction.
  fn get(var self, path: String, handler: Handler) {
    self.routes.push(Route(
      method: http.Method.Get,
      path: path,
      handler: handler
    ))
  }

  /// Adds a route during construction.
  fn post(var self, path: String, handler: Handler) {
    self.routes.push(Route(
      method: http.Method.Post,
      path: path,
      handler: handler
    ))
  }

  /// Consumes unique route storage into an immutable router.
  fn finish(var self) -> Router {
    Router(routes: self.routes.freeze())
  }
}

/// Immutable event subscriptions shared by request tasks.
export struct EventBus {
  subscribers: Map<String, Array<EventHandler>>
}

impl EventBus {
  /// Invokes the current subscribers.
  async fn emit(
    self,
    name: String,
    event: Event
  ) -> Result<Unit, Error> {
    for handler in self.subscribers.get(name).unwrapOr([]) {
      await handler(event)?
    }
    Ok(())
  }
}

/// Adds logging and metrics around a stored handler.
fn withObservability(
  app: App,
  next: Handler
) -> Handler {
  async fn(request) {
    let startedAt = clock.now()
    let result = await next(request)

    app.metrics.lock(fn(var metrics) {
      metrics.record(result.isError())
    })

    console.println(
      "{request.method} {request.path} {clock.now() - startedAt}"
    )?

    result
  }
}

/// Retries an operation during this call.
async fn retry<T>(
  attempts: Int,
  operation: async fn(attempt: Int) -> Result<T, Error>
) -> Result<T, Error> {
  var lastError = Error("retry did not run")

  for attempt in 0..<attempts {
    match await operation(attempt) {
      Ok(value) => return Ok(value)
      Err(error) => lastError = error
    }
  }

  Err(lastError)
}

/// Builds immutable subscriptions with scoped temporary mutation.
fn buildEvents() -> EventBus {
  let handlers = [
    async fn(event) {
      console.println("event: {event}")?
      Ok(())
    }
  ]

  EventBus(
    subscribers: Map.of(
      MapEntry(
        key: "booking.created",
        value: handlers
      )
    )
  )
}

/// Builds routes locally and freezes them before request tasks begin.
fn buildRouter(
  app: App,
  events: EventBus
) -> Router {
  var builder = RouterBuilder(routes: Vector.of())

  builder.get("/health", withObservability(app, async fn(request) {
    Ok(http.json(
      200,
      Map.of(MapEntry(key: "status", value: "ok"))
    ))
  }))

  builder.post("/bookings", withObservability(app, async fn(request) {
    let input = request.json<CreateBookingRequest>()?

    let booking = await retry(3, async fn(attempt) {
      app.repository.create(input, attempt)
    })?

    await events.emit(
      "booking.created",
      Event.BookingCreated(booking.id)
    )?

    Ok(http.json(201, booking))
  }))

  builder.finish()
}

/// Runs a server with immutable routes and structured background work.
export async fn main() -> Result<Unit, Error> {
  // The Host API schema declares BookingRepository task-safe.
  let repository = await BookingRepository.connect()?
  let metrics = Shared(Metrics(
    requests: 0,
    failures: 0
  ))
  let app = App(repository: repository, metrics: metrics)

  let events = buildEvents()
  let router = buildRouter(app, events)

  scope services {
    let reportTimer = services.spawn {
      clock.every(60s, async fn {
        app.metrics.lock(fn(metrics) {
          console.println(
            "requests={metrics.requests} failures={metrics.failures}"
          )
        })?
        Ok(())
      })
    }

    let server = services.spawn {
      http.serve(8080, router)
    }

    await server?
    reportTimer.cancel()
  }

  Ok(())
}
