use cq.json.Json
use cq.json.field
use cq.json.parse

/// One endpoint a run asks about, what its answer has to look like, and how
/// long the run waits for one.
///
/// Every condition is optional except the two that say which endpoint this
/// is. A check that writes none of them still says something -- that the
/// endpoint answers at all -- and that is the check most manifests start
/// with.
///
/// `expectStatus` is the condition every check has whether or not it writes
/// one. A check that leaves it out expects a success, which is any status
/// from 200 to 299, and a check that writes one expects that number exactly.
/// There is no way to say "any status at all", because a checker that
/// accepted any status would not be checking the thing an HTTP endpoint most
/// often gets wrong.
///
/// `timeoutMs` is not one of the conditions, and it is a separate field for
/// the same reason it is a separate paragraph: a condition says what an
/// answer has to look like, and this says how long an answer has to arrive
/// in before the run stops waiting for one. A check that leaves it out is
/// bounded by the default every other check is, which is what the `Option`
/// says and is why there is no number here meaning "no bound".
export struct Check {
  name: String
  url: String
  expectStatus: Option<Int>
  expect: Option<String>
  reject: Option<String>
  maxLength: Option<Int>
  timeoutMs: Option<Int>
}

/// Every check of one run, in the order the manifest wrote them.
///
/// The order is part of the manifest rather than an accident of it: it is
/// what the report comes back in, whatever order the checks finish in.
export struct Manifest {
  checks: Array<Check>
}

/// Reads a manifest out of the text of one file.
///
/// `source` is the file's name and appears in every message, because a
/// manifest that will not load is the first thing a person meets and the
/// message is the whole of what they get. There is no line number in it: the
/// manifest is one JSON document rather than a record per line, so what is
/// wrong is a path through that document and not a place in the file.
export fn readManifest(
  source: String,
  text: String,
) -> Result<Manifest, Error> {
  let document = match parse(text) {
    Ok(value) => value
    Err(detail) => return Err(Error("{source}: {detail.message}"))
  }
  let listed = match field(document, "checks") {
    Some(value) => value
    None => return Err(Error("{source}: this manifest has no `checks` field"))
  }
  let items = match listed {
    Json.Items(values) => values
    other => return Err(Error(
      "{source}: `checks` must be an array, and is {describe(other)}",
    ))
  }
  if items.isEmpty() {
    return Err(Error("{source}: `checks` is empty, so there is nothing to do"))
  }
  var checks = Vector.of()
  for at in 0..<items.length() {
    let entry = items.get(at).unwrapOr(Json.Null)
    match checkFrom(entry) {
      Ok(check) => checks.push(check)
      Err(error) => return Err(Error(
        "{source}: check {at + 1}: {error.message}",
      ))
    }
  }
  Ok(Manifest(checks: checks.freeze()))
}

/// Reads one entry of the `checks` array.
fn checkFrom(entry: Json) -> Result<Check, Error> {
  Ok(Check(name: text(entry, "name")?, url: url(entry)?, expectStatus: status(entry)?, expect: optionalText(entry, "expect")?, reject: optionalText(entry, "reject")?, maxLength: optionalCount(entry, "maxLength")?, timeoutMs: timeout(entry)?))
}

/// Reads the `expectStatus` field, which is a status and not just a count.
///
/// The count is `optionalCount`'s, so a fraction and a negative number are
/// refused there as they are for every other number a check may write. What
/// this adds is the range, and the range is what makes the field worth having
/// its own reader: `expectStatus: 20` and `expectStatus: 4004` are typing
/// mistakes for `200` and `404`, and a checker that took them would wait for
/// an answer that cannot arrive and report the endpoint as broken. HTTP
/// numbers its statuses from 100 to 599 and this refuses everything outside
/// that, which is a bound on the notation rather than a list of the statuses
/// this program knows: a check may name a `418` or a status invented next
/// year, because what an endpoint answers is the endpoint's business.
fn status(entry: Json) -> Result<Option<Int>, Error> {
  let written = optionalCount(entry, "expectStatus")?
  match written {
    Some(code) => {
      if code < 100 || code > 599 {
        return Err(Error("`expectStatus` is {code}, and an HTTP status is between 100 and 599"))
      }
    }
    None => ()
  }
  Ok(written)
}

/// Reads the `url` field, and refuses a scheme this program cannot fetch.
///
/// The `http` host speaks `http://` and nothing else, so an `https://` URL is
/// refused here rather than left to fail once per run against a host that
/// would have said the same thing later and one check at a time.
fn url(entry: Json) -> Result<String, Error> {
  let written = text(entry, "url")?
  if !written.startsWith("http://") {
    return Err(Error(
      "`url` is `{written}`, and this checker fetches `http://` only",
    ))
  }
  Ok(written)
}

/// Reads the required string field `name`.
fn text(entry: Json, name: String) -> Result<String, Error> {
  match required(entry, name)? {
    Json.Text(value) => Ok(value)
    other => Err(wrongType(name, "a string", other))
  }
}

/// Reads the string field `name`, which the entry may leave out.
fn optionalText(entry: Json, name: String) -> Result<Option<String>, Error> {
  match field(entry, name) {
    None => Ok(None)
    Some(Json.Text(value)) => Ok(Some(value))
    Some(other) => Err(wrongType(name, "a string", other))
  }
}

/// Reads the whole-number field `name`, which the entry may leave out.
///
/// JSON has one number type, so `4096` and `4096.0` arrive identically and
/// both are this field; `4096.5` is not, because neither a count of
/// characters nor a count of milliseconds nor a status is a fraction of one.
/// It reads every whole number a check may write, and whatever a particular
/// field will not take beyond being one is that field's own question rather
/// than this one's.
fn optionalCount(entry: Json, name: String) -> Result<Option<Int>, Error> {
  let number = match field(entry, name) {
    None => return Ok(None)
    Some(Json.Number(value)) => value
    Some(other) => return Err(wrongType(name, "a number", other))
  }
  let whole = match number.toInt() {
    Ok(rounded) => rounded
    Err(error) => return Err(Error("`{name}` is {number}: {error.message}"))
  }
  if whole.toFloat() != number {
    return Err(Error("`{name}` is {number}, which is not a whole number"))
  }
  if whole < 0 {
    return Err(Error("`{name}` is {whole}, and a bound cannot be negative"))
  }
  Ok(Some(whole))
}

/// Reads the `timeoutMs` field, which bounds a wait rather than a body.
///
/// The count is `optionalCount`'s, so a check that leaves the field out
/// answers `None` and is left to the default the runner keeps; a fraction of
/// a millisecond is refused as not a whole number; and a negative wait is
/// refused as a negative bound. Zero is the one value that reader takes and
/// this one does not, and it is refused for the reason `--concurrency 0` is:
/// a check given no time at all can only run out of it, so it would come back
/// `unchecked` however healthy its endpoint, and a person who wrote `0` meant
/// something else.
///
/// A count so large that its nanoseconds do not fit an `Int` is not refused
/// here. It stops the run where `Duration.millis` builds it, which is where
/// every duration that overruns an `Int` stops; a copy of that limit written
/// into this file would be a second one to keep true, and a manifest asking
/// for a timeout of a hundred million years is not the typing mistake `0` is.
fn timeout(entry: Json) -> Result<Option<Int>, Error> {
  let written = optionalCount(entry, "timeoutMs")?
  match written {
    Some(milliseconds) => {
      if milliseconds == 0 {
        return Err(Error(
          "`timeoutMs` is 0, and a check with no time cannot answer",
        ))
      }
    }
    None => ()
  }
  Ok(written)
}

/// The field `name`, or the error that says it is missing.
fn required(entry: Json, name: String) -> Result<Json, Error> {
  match field(entry, name) {
    Some(value) => Ok(value)
    None => Err(Error("this check has no `{name}` field"))
  }
}

/// The error for a field that is there and is the wrong kind of thing.
fn wrongType(name: String, expected: String, found: Json) -> Error {
  Error("`{name}` must be {expected}, and is {describe(found)}")
}

/// What kind of thing a value is, for a message that has to name it.
fn describe(value: Json) -> String {
  match value {
    Json.Null => "null"
    Json.Bool(_) => "a boolean"
    Json.Number(_) => "a number"
    Json.Text(_) => "a string"
    Json.Items(_) => "an array"
    Json.Fields(_) => "an object"
  }
}
