/// What one run of `covecheck` was asked to do.
///
/// The deadline is a `Duration` and not the number of seconds it was written
/// as, because `clock.timeout` takes a `Duration` and building it once, here,
/// is what keeps the unit the command line spelled it in from travelling any
/// further into the program. It sits beside the plan rather than in it
/// because `runAll` never reads it: it bounds the whole run, which is a thing
/// `main` does around `runAll` and not a thing `runAll` does to a window.
struct Options {
  manifest: String
  plan: Plan
  deadline: Duration
  format: Format
}

/// Reads the command line, or reports what is wrong with it.
///
/// Nothing here touches a host, so every message it can produce is pinned by
/// a test that needs no manifest, no clock, and no network.
fn readOptions(arguments: Array<String>) -> Result<Options, Error> {
  var manifest: Option<String> = None
  var concurrency = 4
  var stopAfter: Option<Int> = None
  var deadline = runBound()
  var format = Format.Text
  var at = 0
  while at < arguments.length() {
    let argument = arguments.get(at).unwrapOr("")
    match argument {
      "--concurrency" => {
        concurrency = concurrencyAfter(arguments, at)?
        at += 2
      }
      "--stop-after" => {
        stopAfter = Some(countAfter(arguments, at)?)
        at += 2
      }
      "--timeout" => {
        deadline = deadlineAfter(arguments, at)?
        at += 2
      }
      "--format" => {
        format = formatNamed(valueAfter(arguments, at)?)?
        at += 2
      }
      other => {
        if other.startsWith("--") {
          return Err(Error("`{other}` is not an option; run with `--help`"))
        }
        if manifest.isSome() {
          return Err(Error(
            "`{other}` is a second manifest; `covecheck` reads one file",
          ))
        }
        manifest = Some(other)
        at += 1
      }
    }
  }
  Ok(Options(
    manifest: match manifest {
      Some(path) => path
      None => return Err(Error("no manifest was named; run with `--help`"))
    },
    plan: Plan(concurrency: concurrency, stopAfter: stopAfter),
    deadline: deadline,
    format: format,
  ))
}

/// Whether `arguments` asks for the usage text rather than a run.
fn wantsHelp(arguments: Array<String>) -> Bool {
  for argument in arguments {
    if argument == "--help" || argument == "-h" {
      return true
    }
  }
  arguments.isEmpty()
}

/// The usage text.
fn usage() -> String {
  var lines = Vector.of()
  lines.push("covecheck -- a concurrent HTTP health and link checker")
  lines.push("")
  lines.push("usage: covecheck <manifest> [options]")
  lines.push("")
  lines.push("options:")
  lines.push(
    "  --concurrency <n>  how many checks may be in flight at once (default 4)",
  )
  lines.push(
    "  --stop-after <n>   start no more checks once this many have failed",
  )
  lines.push("  --timeout <n>      stop the whole run after this many seconds (default 30)")
  lines.push("  --format <name>    `text` or `json` (default `text`)")
  lines.push("  --help             this text")
  "\n".join(lines.freeze())
}

/// The concurrency after the option at `at`.
///
/// Zero is refused rather than taken to mean "no limit": a checker asked to
/// run no checks at a time would have nothing to do, and a person who wrote
/// `0` meant something else.
fn concurrencyAfter(arguments: Array<String>, at: Int) -> Result<Int, Error> {
  let count = countAfter(arguments, at)?
  if count == 0 {
    return Err(Error(
      "`--concurrency` cannot be 0; a run needs one check at a time",
    ))
  }
  Ok(count)
}

/// The whole-run deadline after the option at `at`.
///
/// The number is seconds and it leaves here as a `Duration`, built by
/// `Duration.seconds`, which makes it the same value `runBound` writes as
/// `30s` and the same thing to pass to `clock.timeout`. That is the whole
/// reason this option can exist: a bound a person types and a bound the
/// program wrote down are one type, and neither the deadline's unit nor where
/// it came from survives past this function.
///
/// Zero is refused for the reason `--concurrency` refuses it: a run given no
/// time at all stops before it has checked anything, and a person who wrote
/// `0` meant something else. A negative number was already refused by
/// `countAfter`, so the smallest run anybody can ask for is one second, and a
/// number of seconds too large to be nanoseconds in an `Int` stops the run
/// inside `Duration.seconds` rather than becoming some other deadline.
fn deadlineAfter(arguments: Array<String>, at: Int) -> Result<Duration, Error> {
  let seconds = countAfter(arguments, at)?
  if seconds == 0 {
    return Err(Error(
      "`--timeout` cannot be 0; a run needs time to check anything",
    ))
  }
  Ok(Duration.seconds(seconds))
}

/// The argument after the option at `at`, or the error that names what is
/// missing.
fn valueAfter(arguments: Array<String>, at: Int) -> Result<String, Error> {
  let option = arguments.get(at).unwrapOr("")
  match arguments.get(at + 1) {
    Some(value) => {
      if value.startsWith("--") {
        Err(Error("`{option}` needs a value, and `{value}` is another option"))
      } else {
        Ok(value)
      }
    }
    None => Err(Error("`{option}` needs a value, and the command line ended"))
  }
}

/// The count after the option at `at`.
fn countAfter(arguments: Array<String>, at: Int) -> Result<Int, Error> {
  let option = arguments.get(at).unwrapOr("")
  let text = valueAfter(arguments, at)?
  match Int.parse(text) {
    Ok(count) => {
      if count < 0 {
        Err(Error("`{option}` cannot be `{text}`, which is negative"))
      } else {
        Ok(count)
      }
    }
    Err(_) => Err(Error(
      "`{option}` cannot be `{text}`, which is not a whole number",
    ))
  }
}
