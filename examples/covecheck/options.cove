/// What one run of `covecheck` was asked to do.
struct Options {
  manifest: String
  plan: Plan
  format: Format
}

/// Reads the command line, or reports what is wrong with it.
///
/// Nothing here touches a host, so every message it can produce is pinned by
/// a test that needs no manifest, no clock, and no network.
fn readOptions(arguments: Array<String>) -> Result<Options, Error> {
  var manifest: Option<String> = None
  var concurrency = 4
  var stopAfter: Option<Int> = None
  var format = Format.Text
  var at = 0
  while at < arguments.length() {
    let argument = arguments.get(at).unwrapOr("")
    match argument {
      "--concurrency" => {
        concurrency = concurrencyAfter(arguments, at)?
        at += 2
      }
      "--stop-after" => {
        stopAfter = Some(countAfter(arguments, at)?)
        at += 2
      }
      "--format" => {
        format = formatNamed(valueAfter(arguments, at)?)?
        at += 2
      }
      other => {
        if other.startsWith("--") {
          return Err(Error("`{other}` is not an option; run with `--help`"))
        }
        if manifest.isSome() {
          return Err(Error(
            "`{other}` is a second manifest; `covecheck` reads one file",
          ))
        }
        manifest = Some(other)
        at += 1
      }
    }
  }
  Ok(Options(
    manifest: match manifest {
      Some(path) => path
      None => return Err(Error("no manifest was named; run with `--help`"))
    },
    plan: Plan(concurrency: concurrency, stopAfter: stopAfter),
    format: format,
  ))
}

/// Whether `arguments` asks for the usage text rather than a run.
fn wantsHelp(arguments: Array<String>) -> Bool {
  for argument in arguments {
    if argument == "--help" || argument == "-h" {
      return true
    }
  }
  arguments.isEmpty()
}

/// The usage text.
fn usage() -> String {
  var lines = Vector.of()
  lines.push("covecheck -- a concurrent HTTP health and link checker")
  lines.push("")
  lines.push("usage: covecheck <manifest> [options]")
  lines.push("")
  lines.push("options:")
  lines.push(
    "  --concurrency <n>  how many checks may be in flight at once (default 4)",
  )
  lines.push(
    "  --stop-after <n>   start no more checks once this many have failed",
  )
  lines.push("  --format <name>    `text` or `json` (default `text`)")
  lines.push("  --help             this text")
  "\n".join(lines.freeze())
}

/// The concurrency after the option at `at`.
///
/// Zero is refused rather than taken to mean "no limit": a checker asked to
/// run no checks at a time would have nothing to do, and a person who wrote
/// `0` meant something else.
fn concurrencyAfter(arguments: Array<String>, at: Int) -> Result<Int, Error> {
  let count = countAfter(arguments, at)?
  if count == 0 {
    return Err(Error(
      "`--concurrency` cannot be 0; a run needs one check at a time",
    ))
  }
  Ok(count)
}

/// The argument after the option at `at`, or the error that names what is
/// missing.
fn valueAfter(arguments: Array<String>, at: Int) -> Result<String, Error> {
  let option = arguments.get(at).unwrapOr("")
  match arguments.get(at + 1) {
    Some(value) => {
      if value.startsWith("--") {
        Err(Error("`{option}` needs a value, and `{value}` is another option"))
      } else {
        Ok(value)
      }
    }
    None => Err(Error("`{option}` needs a value, and the command line ended"))
  }
}

/// The count after the option at `at`.
fn countAfter(arguments: Array<String>, at: Int) -> Result<Int, Error> {
  let option = arguments.get(at).unwrapOr("")
  let text = valueAfter(arguments, at)?
  match Int.parse(text) {
    Ok(count) => {
      if count < 0 {
        Err(Error("`{option}` cannot be `{text}`, which is negative"))
      } else {
        Ok(count)
      }
    }
    Err(_) => Err(Error(
      "`{option}` cannot be `{text}`, which is not a whole number",
    ))
  }
}
