/// Turning a tree back into text.
///
/// This slice makes no layout decision: it walks the tree and writes what each
/// token said. That is not the formatter — a formatter chooses where a line
/// breaks and how far it is indented — but it is the half of one that has to
/// be right first, and it is the half that can be checked *now*.
///
/// The check is the repository itself. Every `.cove` file here passes
/// `cove fmt --check`, so every one of them is already what the formatter
/// should produce, and a formatter that is correct reproduces all 242 of them
/// byte for byte. `print(parse(source)) == source` is that, and it is a
/// stronger statement than the tiling: the tiling says the tree *covers* the
/// tokens, and this says a walk of it *reaches* them, in order, whole.
///
/// The output is built by pushing each piece and joining once. Appending with
/// an interpolation is quadratic — `examples/cq/README.md` measured that, and
/// on a 200 KB output it is 29 seconds against 56 milliseconds — and a
/// formatter's whole output is one append after another. Cove has no string
/// builder, and a `Vector<String>` joined once is the shape of one.
/// The text a tree prints as.
export fn print(source: String, held: Array<Token>, tree: Tree) -> String {
  var out = Vector.of()
  // `-1` is "nothing has been written", which is what makes a blank at the
  // very top of a file fall under the same rule as a blank at the top of a
  // block: both open on nothing.
  emit(source, held, tree, -1, 0, -1, var out)
  let text = "".join(out.freeze())
  // The alignment pass lexes its own output, which is the price of not
  // lining up on a `//` inside a string. It is only owed when there is a
  // trailing comment to line up, and whether there is one is already
  // readable here: this printer never moves a comment from its line, so a
  // source with none produces an output with none.
  if !holdsATrailingComment(source, held) {
    return text
  }
  aligned(text)
}

/// `text` with each run of consecutive trailing comments lined up.
///
/// `Out::finish` does this last of all, over the lines it has buffered: a run
/// of lines that each carry a trailing comment is padded to the widest code in
/// the run, and one space. So
///
/// ```text
/// let a = 1   // aligned
/// let bb = 2  // here
/// ```
///
/// keeps its column whatever stands either side of it. It is the one rule that
/// cannot be decided while writing, because it depends on lines that have not
/// been written yet.
///
/// The output is lexed again rather than searched for `//`, because a `//`
/// inside a string is not a comment and this would line up on it. What it does
/// *not* do is cut the text into lines: a corpus is twenty thousand of them
/// and almost none carry a trailing comment, so what is collected is the three
/// offsets each of those few needs.
fn aligned(text: String) -> String {
  let held = tokens(text)
  // For each line that carries one: where the line begins, where its code
  // ends, and where its comment begins.
  var opens = Vector.of<Int>()
  var ends = Vector.of<Int>()
  var comments = Vector.of<Int>()
  var lineFrom = 0
  var codeTo = 0
  var open = false
  var t = 0
  while t < held.length() {
    match held.get(t) {
      Some(token) => {
        if token.kind == Kind.Space {
          var at = token.from
          while at < token.to {
            if text.byteAt(at) == '\n' {
              lineFrom = at + 1
              open = false
            }
            at = at + 1
          }
        } else {
          // Trailing when something of this line already stands in front of
          // it. A comment that opens its line is placed by the indentation
          // rules and not by this one.
          if open && isAComment(token) {
            opens.push(lineFrom)
            ends.push(codeTo)
            comments.push(token.from)
          }
          codeTo = token.to
          open = true
        }
      }
      None => { }
    }
    t = t + 1
  }
  if opens.length() == 0 {
    return text
  }
  padded(text, opens.freeze(), ends.freeze(), comments.freeze())
}

/// Whether `token` is a comment of any of the three forms.
fn isAComment(token: Token) -> Bool {
  token.kind == Kind.LineComment || token.kind == Kind.BlockComment ||
    token.kind == Kind.DocComment
}

/// `text` with the space in front of each marked comment set so that a run of
/// them lines up.
///
/// A run is the marked lines that follow one another: `opens` holds where each
/// begins, and two are consecutive when the second begins where the first's
/// comment line ended.
fn padded(
  text: String,
  opens: Array<Int>,
  ends: Array<Int>,
  comments: Array<Int>,
) -> String {
  var out = Vector.of<String>()
  var copied = 0
  var i = 0
  while i < opens.length() {
    // The run this one opens, and the widest code in it.
    var stop = i
    var widest = 0
    while stop < opens.length() && follows(text, comments, opens, stop, i) {
      widest = wider(widest, at(ends, stop) - at(opens, stop))
      stop = stop + 1
    }
    var w = i
    while w < stop {
      match text.sliceBytes(copied, at(ends, w)) {
        Ok(piece) => out.push(piece)
        Err(_) => { }
      }
      out.push(spaces(widest - (at(ends, w) - at(opens, w)) + 1))
      copied = at(comments, w)
      w = w + 1
    }
    i = stop
  }
  match text.sliceBytes(copied, text.byteLength()) {
    Ok(rest) => out.push(rest)
    Err(_) => { }
  }
  "".join(out.freeze())
}

/// Whether the marked line at `stop` carries on the run that began at `first`.
///
/// Consecutive lines, and nothing else: a line with no comment between two
/// that have one ends the run, which is what `Out::finish`'s walk over its
/// buffered lines does by stopping at the first line with no comment.
fn follows(
  text: String,
  comments: Array<Int>,
  opens: Array<Int>,
  stop: Int,
  first: Int,
) -> Bool {
  if stop == first {
    return true
  }
  // The line before this one is marked, and its comment ran to the newline
  // this line begins after.
  let newline = at(opens, stop) - 1
  if newline < 0 {
    return false
  }
  let before = at(comments, stop - 1)
  before < newline && noNewlineBetween(text, before, newline)
}

/// Whether `[from, to)` holds no newline.
fn noNewlineBetween(text: String, from: Int, to: Int) -> Bool {
  var i = from
  while i < to {
    if text.byteAt(i) == '\n' {
      return false
    }
    i = i + 1
  }
  true
}

/// The value at `i`, or `0`.
fn at(values: Array<Int>, i: Int) -> Int {
  match values.get(i) {
    Some(value) => value
    None => 0
  }
}

/// The larger of two.
fn wider(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

/// `n` spaces.
fn spaces(n: Int) -> String {
  var out = Vector.of<String>()
  var i = 0
  while i < n {
    out.push(" ")
    i = i + 1
  }
  "".join(out.freeze())
}

/// Pushes the text of `tree` and everything under it.
///
/// A leaf is one token's run of source. A node is its children in order — and
/// because the children tile it, that is every token it covers and nothing
/// else.
fn emit(
  source: String,
  held: Array<Token>,
  tree: Tree,
  after: Int,
  depth: Int,
  reserved: Int,
  var out: Vector<String>,
) -> Int {
  if tree.children.length() == 0 {
    if tree.kind == Node.Leaf {
      match held.get(tree.from) {
        Some(token) => {
          if token.kind == Kind.Space {
            out.push(spacing(source, token, opensBlock(source, held, after), after < 0, depth, held, tree.from))
          } else {
            // A space the source has not got. Every other rule here rewrites
            // a run that is already there; two tokens written against each
            // other have no run to rewrite, and `n=1` stayed `n=1`.
            if after >= 0 && after == tree.from - 1 &&
              !isASpaceToken(held, after) &&
              wantsASpaceBetween(source, held, after, tree.from) {
              out.push(" ")
            }
            out.push(text(source, token))
          }
          return tree.from
        }
        None => { }
      }
    }
    return after
  }
  // Read once. Nothing of this node is written before the three places below
  // that ask for it, so they are all the same number — and `column` walks
  // back over the pieces of the line, reading every byte of each to find the
  // newline it does not hold. Asked four times it was four walks.
  let col = column(out)
  // Whether this group is written on one line, and whether it should be.
  //
  // # The decision propagates, and that is the whole of the rule
  //
  // `cove_syntax::format` is greedy from the outside in and never goes back:
  // every one of its ten width tests is `col + width(flat) <= MAX_WIDTH`,
  // write the flat form, return. When an outer group is written flat, the
  // groups inside it go out as part of that string and are never asked
  // anything.
  //
  // So a group left flat here returns without walking its children. That is
  // not an optimisation. `Ok(Check(name: …, url: …, …))` is 150 columns and
  // `cove fmt` leaves it alone, because breaking the `Ok` would leave the
  // `Check` just as long one step further in — and descending into it anyway
  // is how covefmt came to write `Ok(Check(` with the members below, which
  // is a line `cove fmt` never writes.
  //
  // Greedy is also *optimal* here, which is why no search is needed: a
  // group is flat or wholly broken with nothing in between, and breaking an
  // outer group only ever gives an inner one more room. There is no choice
  // upstream that a later line can regret.
  // A `(` that follows no callee is not an argument list — it is the
  // parentheses `expr` writes around an operand whose precedence is below the
  // one it is being written for. `cove_syntax::format` has no node for it and
  // no rule about it: the `(` and the `)` are written either side of the
  // operand and the operand is laid out at the *enclosing* indent, so nothing
  // inside one is ever a member on a line of its own.
  let bracketed = isParenthesised(source, held, tree)
  if indenting(tree.kind) && tree.kind != Node.Body && !bracketed &&
    isClosed(source, held, tree) && !isAPattern(source, held, tree) {
    // What is left of the line after the group, which `cove_syntax::format`
    // calls `reserved` and passes in: a parameter list that fits on its own
    // still breaks when the `-> Result<T, F> \{` behind it would not. The
    // rest of the line is the tokens from the group's end to the next
    // newline, which the tiling makes readable without a tree.
    // What is left of the line after the group, which `cove_syntax::format`
    // calls `reserved` and passes in. `-1` is "nobody said", and then the
    // source's own line is the best guess there is — right at the top of a
    // statement, where what the printer writes on this line is what the
    // source has on it.
    //
    // It is *not* right inside a group that has broken: the member is on a
    // line of the printer's own making and what follows it there is the
    // comma, however long the line it came from was. Reading the source there
    // put `event(census(world), hash(world))` — 29 columns with 75 to spare —
    // through as a group that did not fit.
    let rest = if reserved >= 0 {
      reserved
    } else {
      reservedFor(source, held, tree)
    }
    let room = maxWidth() - col - rest
    let fits = !mustBreak(source, held, tree) &&
      flatWidth(source, held, tree) <= room
    if isBroken(source, held, tree) {
      if fits {
        out.push(flattened(source, held, tree))
        return tree.to - 1
      }
    } else {
      // Already on one line. It stays there unless it is over the limit and
      // breaking would actually buy something, and either way the answer is
      // this group's *and everything inside it*.
      // An array is not an argument list and does not borrow its rules.
      // `expr` sends one that does not fit to `array_literal`, which writes
      // an element to a line and has neither `arg_list`'s lone-argument
      // escape nor `hug_last`: `[async fn(event) \{ … \}, …]` breaks where the
      // same shape written as a call would hug.
      let listed = isAnArray(source, held, tree)
      let hugs = !listed && hugsItsLast(source, held, tree, col)
      if fits || !listed && !worthBreaking(source, held, tree, depth) {
        // `flattened` and not `verbatim`: a group that keeps its line still
        // has the space inside it decided, and `f( x , y )` is `f(x, y)`
        // whether it was folded or left alone.
        out.push(flattened(source, held, tree))
      } else if hugs {
        writeHugged(source, held, tree, depth, var out)
      } else {
        writeBroken(source, held, tree, depth, var out)
      }
      return tree.to - 1
    }
  }
  // A chain of calls that is merely too long breaks before its dots, and
  // not inside its argument lists. `call` asks this before anything else it
  // would do — `judge(a, b).detail()` at 82 columns becomes the call on one
  // line and `.detail()` on the next, where breaking the arguments would
  // have made four lines of it.
  if tree.kind == Node.Member && !isBroken(source, held, tree) &&
    !mustBreak(source, held, tree) {
    let rest = if reserved >= 0 {
      reserved
    } else {
      0
    }
    if flatWidth(source, held, tree) > maxWidth() - col - rest &&
      breaksAtItsDots(source, held, tree) {
      writeChain(source, held, tree, depth, var out)
      return tree.to - 1
    }
  }
  // A `Node.Body` and a `Node.Params` indent what is inside them, and their
  // own brackets are not inside: the opener is written at the depth the node
  // *opens* at and the closer goes back to it. So the step is applied to the
  // children between them and the brackets are left where the enclosing
  // depth put them, which is what `cove_syntax::format` does by passing
  // `indent + INDENT` to the members and `indent` to `lead_close`.
  let indents = indenting(tree.kind) && !bracketed
  let inner = if indents {
    depth + 1
  } else {
    depth
  }
  // A body's *last two* children get the outer depth: the closing brace
  // itself, and the run of space in front of it that carries the newline the
  // brace's line begins on. Indentation is written by the space before a
  // line, so the depth a line is at is the depth of what comes *after* the
  // break — and what comes after the last break of a body is its `}`.
  // The count is read once. `length()` is a builtin call, and a `while` that
  // asks for it every turn asks once per child of every node in the file.
  let children = tree.children
  let count = children.length()
  var last = after
  var i = 0
  // The operators whose right operands this node is currently inside, and the
  // depth each of them broke at. Only ever used by a node holding a run of
  // leaves, which is the only place a continuation can happen.
  var opened: Vector<Int> = Vector.of()
  var nested: Vector<Int> = Vector.of()
  // Where this node starts, read before anything of it is written. The
  // question a trailing closure's body asks is whether the *expression* fit,
  // and `expr` asks that before `arg_list` has broken anything — by the time
  // the body is reached the column has come back to the closing bracket's,
  // and `) \{ http.fetch(check.url) \}` looks like it fits on a line it is
  // only on because the arguments above it broke.
  let began = col
  // Where this node's run of leaves must break, and at what depth. Empty for
  // everything that already fits, which is almost everything.
  var marks = Vector.of<Int>()
  var levels = Vector.of<Int>()
  // A node with no operator of its own has nothing to plan, and that is
  // almost every node. The width is measured only for the few that could.
  let span = expressionEnds(held, tree, tree.from)
  if continuing(tree.kind) && overflows(source, held, tree.from, span, began) &&
    loosestIn(source, held, tree.from, span) > 0 &&
    !holdsABrokenGroup(source, held, tree) {
    planBreaks(
      source,
      held,
      tree.from,
      span,
      began,
      depth,
      var marks,
      var levels,
    )
  }
  while i < count {
    match children.get(i) {
      Some(child) => {
        // The closing brace is the body's last child and belongs to the
        // depth the body opened at, not to the depth inside it.
        var at = if indents && i + 1 >= count ||
          indents && i + 2 >= count && isARunOfSpace(held, child) {
          depth
        } else {
          inner
        }
        // A line *inside* a run of leaves is a continuation: the statement
        // began on the line above and is still going, because it ended that
        // line on an operator or opens this one with a `.`. It is written a
        // step past the line it began on, which is what
        // `cove_syntax::format` does by giving a continued operand
        // `indent + INDENT`.
        //
        // The statement's nested bodies are the exception, and they are the
        // reason this is here rather than on the statement as a whole: an
        // `if`'s block *is* a `Node.Body`, its depth is known, and its lines
        // are its own. Only the leaves between the bodies continue.
        if holdsAGroup(tree.kind) && !indenting(child.kind) {
          // A line inside a `<…>`, a `use` path or a return type is still a
          // line this cannot place: those are runs of leaves the tree has not
          // split into members, so it does not know what encloses what. `-1`
          // says so and `spacing` leaves such a line as it found it.
          at = -1
        }
        if continuing(tree.kind) && !indenting(child.kind) {
          // A continuation is a break with something of this node's on *both*
          // sides of it. The other two kinds of break in here are not:
          //
          // - the leading trivia, which every item takes, is the newline that
          //   ended the item *above*. The line it begins is this node's first
          //   line, and that is at this node's own depth.
          // - the last child, where a statement stopped in front of the `}`
          //   that closes the body it is in. The line that break begins
          //   belongs to the brace, at the enclosing depth — which is the
          //   same reason a body hands its own last two children `depth`.
          //
          // `previousSignificant` is asked rather than the child's position,
          // because leading trivia is not one child: a doc comment, a
          // newline and a blank line are three, and only "is any of this
          // node's own content already behind me" tells them from a break in
          // the middle.
          // Only a child that *is* a break: a run of space between two of
          // this node's own tokens holding a newline. A space within a line
          // is not a continuation and must not be counted as one — counting
          // it put the space between `if` and `a` on the stack and every
          // continuation under it a step too deep.
          let begun = previousSignificant(held, child.from) >= tree.from
          // A break that is not there yet. `binary` writes the operator and
          // then asks whether its right operand fits on what is left of the
          // line; when it does not, the operand goes to a line of its own one
          // step in. This is that question, asked of the run of space behind
          // the operator, and it is the only place other than a body where
          // this printer puts a newline the source has not got.
          //
          // *Where* such a break goes is not a matter of filling lines from
          // the left. `binary` is handed the top of the expression — for a
          // left-associative chain that is the **last** operator — splits
          // there, and then asks the same question of the left half. So
          // `a && b && c` that does not fit keeps `a && b` together and moves
          // `c`, where filling greedily would have moved `b` as well.
          //
          // `planned` is that recursion, run once over this node's run of
          // leaves before any of it is written.
          let planned = if marks.length() == 0 {
            -1
          } else {
            levelPlanned(
              marks,
              levels,
              nextSignificant(held, child.to, tree.to),
            )
          }
          let makes = begun && i + 1 < count && isARunOfSpace(held, child) &&
            !breaksLine(source, held, child) && planned >= 0
          if begun && i + 1 < count && breaksLine(source, held, child) || makes {
            // How *far* a continuation is indented is decided by the operator
            // that broke the line. `cove_syntax::format`'s `binary` writes a
            // broken right operand at `indent + INDENT` and then writes that
            // operand *at* `indent + INDENT`, so a break inside it is a step
            // further again — and a break at a looser operator has left that
            // operand and is back where the looser one started.
            //
            // That is the whole of the nesting, and it needs the operators
            // rather than an expression tree: the stack below is `binary`'s
            // recursion, unrolled. `a && b +\n  c <\n  d` puts the `<` line
            // level with the `+` line rather than one past it, because `<`
            // binds looser and the `+` it follows is finished.
            let binds = bindingOf(
              source,
              held,
              previousSignificant(held, child.from),
            )
            while opened.length() > 0 && topOf(opened) >= binds {
              opened.pop()
              nested.pop()
            }
            at = if makes {
              planned
            } else if nested.length() > 0 {
              topOf(nested) + 1
            } else {
              depth + 1
            }
            opened.push(binds)
            nested.push(at)
            if makes {
              // The run of space is what the line break replaces, and what
              // follows it is a new segment: the operand written there is
              // split at *its* loosest operator, not at this one again.
              trimTrailing(var out)
              out.push("\n")
              out.push(indentOf(at))
              last = child.from
              i = i + 1
              continue
            }
          } else {
            // The leading trivia and the break a statement leaves in front of
            // a `}`. Neither can have a stack behind it: the first comes
            // before anything has been pushed, and the second is last.
            at = depth
          }
        }
        // A group that stands inside a continuation belongs to the line the
        // continuation made, not to the line the node started on.
        // `binary` writes a broken right operand *at* `indent + INDENT` and
        // everything in it from there, so an argument list two continuations
        // deep indents its members from two steps in.
        //
        // A *body* is not one of them. `if a ||\n  b \{` opens its block at
        // the `if`'s own depth however far the condition ran on, because
        // `if_expr` hands `block` the indent it was given and not the one the
        // condition ended at.
        if child.kind != Node.Body && indenting(child.kind) &&
          nested.length() > 0 {
          at = topOf(nested)
        }
        // A body that must break and was written on one line is the one
        // place this printer puts a newline where the source has none. Every
        // other rule rewrites a run of space that is already there.
        // A trailing closure's body breaks when the line it is on has run
        // out, whatever `trailing_breaks` says about its contents: `block` is
        // reached from `expr_broken`, so once the expression did not fit, the
        // body is written across lines. The statement holding
        // `clock.timeout(d) \{ await runAll(…) \}` is 112 columns and that is
        // the measurement; the one holding `inflight.spawn \{ await run(c) \}`
        // is 50 and keeps its line.
        //
        // The width is asked last and only of a body, because `&&` stops at
        // the first `false`: measured for every child of every node it is the
        // node's own size squared, and six seconds of the corpus.
        // What no rule claimed is written back byte for byte. Deciding the
        // space inside it would be deciding something about source this slice
        // has already said it does not understand — `%%% not a declaration`
        // came back as `% % % not a declaration`.
        if child.kind == Node.Error {
          out.push(verbatim(source, held, child))
          last = child.to - 1
          i = i + 1
          continue
        }
        if child.kind == Node.Body && writesBroken(source, held, child) &&
          (breaksAsABody(source, held, child, tree.from) ||
            overflows(source, held, tree.from, tree.to, began)) {
          writeBrokenBody(source, held, child, at, var out)
          last = child.to - 1
        } else {
          last = emit(source, held, child, last, at, reserved, var out)
        }
      }
      None => { }
    }
    i = i + 1
  }
  last
}

/// Whether printing the tree of `source` gives `source` back.
export fn roundTrips(source: String) -> Bool {
  let held = tokens(source)
  print(source, held, parse(source)) == source
}

/// A run of space, with the blanks a line ends on taken out.
///
/// The first layout decision this makes, and the one with no exceptions in
/// it: `cove_syntax::format` says *"no tabs, no trailing whitespace, one
/// trailing newline"*, and a blank before a newline is invisible in every
/// editor and meaningful to nothing.
///
/// It is the whole run and not each line separately, because a run of space
/// is one token and the newlines inside it are part of it. What is kept is
/// every newline and whatever indentation follows the last of them; what
/// goes is the space between a newline and the one before it.
///
/// A run holding no newline is untouched. Space between two things on a line
/// is not trailing, and deciding how much of it there should be is a
/// different rule that reads what is on either side.
fn spacing(
  source: String,
  token: Token,
  opening: Bool,
  leading: Bool,
  depth: Int,
  held: Array<Token>,
  index: Int,
) -> String {
  // The byte after the last newline. Everything from there to the end of the
  // run is the indentation of the line the run leaves behind, and everything
  // between two newlines was trailing.
  var lastBreak = -1
  var breaks = 0
  var at = token.from
  while at < token.to {
    if source.byteAt(at) == '\n' {
      lastBreak = at
      breaks = breaks + 1
    }
    at = at + 1
  }
  if lastBreak < 0 {
    // A run inside a line is not kept — it is decided. `cove fmt` writes
    // `f(x, y)` for `f( x , y )`, and the width of what stands either side of
    // the run is the whole of the question.
    return if wantsASpaceBetween(source, held, index - 1, index + 1) {
      " "
    } else {
      ""
    }
  }
  // `n` newlines leave `n - 1` blank lines behind them, and the formatter
  // keeps at most one: `cove_syntax::format`'s `pending_blank` is a `bool`,
  // so however many an author wrote, one is what comes back. Two newlines is
  // that one blank line.
  var most = maxBreaks()
  if opening {
    most = 1
  }
  if leading {
    // The very top of a file keeps no newline at all, where the top of a
    // block keeps the one that ends the brace's own line. `cove fmt` on
    // "\n\n\nfn f() ..." answers "fn f() ...", which is the rule read off
    // the tool rather than guessed at: `Out::newline` writes nothing when
    // `self.lines` is empty, so a file's first line has no line above it to
    // end.
    most = 0
  }
  if breaks > most {
    breaks = most
  }
  var out = Vector.of<String>()
  var written = 0
  while written < breaks {
    out.push("\n")
    written = written + 1
  }
  // The line this run leaves behind begins at the depth of whatever comes
  // next, which is the depth this run was written at: a run of space is a
  // child of the node whose members it separates, so `depth` is already that
  // node's inside. Two spaces a step — `cove_syntax::format`'s `INDENT`.
  //
  // `depth < 0` is "this tree does not know": a line inside a `(`, `[` or
  // `<` group is indented by the formatter too, and the tree has no node for
  // a group's members — a call's arguments are leaves of the statement that
  // holds them. Rewriting those from a depth of zero is how 85 files stopped
  // matching, so what the tree cannot decide it leaves as it found it.
  //
  // That is not a formatter yet. It is a formatter that has taken the
  // decisions it has the tree for and kept its hands off the rest, which is
  // what makes the count below go up as the tree gets deeper rather than
  // down.
  if breaks > 0 && depth >= 0 {
    var step = 0
    while step < depth {
      out.push("  ")
      step = step + 1
    }
  } else {
    match source.sliceBytes(lastBreak + 1, token.to) {
      Ok(indent) => out.push(indent)
      Err(_) => { }
    }
  }
  "".join(out.freeze())
}

/// How many newlines a run of space may keep: one to end the line, and one
/// more for the single blank line a formatter allows after it.
///
/// Cove has no module-level constant, so this is a function — and it is a
/// function rather than a literal written twice because the number is a
/// *rule*, and a rule with two spellings is a rule that can disagree with
/// itself.
fn maxBreaks() -> Int {
  2
}

/// Whether the token at `after` opens something a blank line has nothing to
/// separate a thing from.
///
/// `cove_syntax::format`'s `lead` takes an `allow_blank` that is false for
/// the first thing in a file and the first thing in a block — `i > 0` at
/// every call site that walks members. This is that rule read off the token
/// stream instead: a blank above the first thing is a blank under an opening
/// brace, or under nothing at all.
///
/// `after` is `-1` before anything has been written, which is the start of
/// the file and is the other half of the same answer.
fn opensBlock(source: String, held: Array<Token>, after: Int) -> Bool {
  if after < 0 {
    return true
  }
  match held.get(after) {
    Some(token) => {
      if token.kind != Kind.Punct || token.to - token.from != 1 {
        return false
      }
      source.byteAt(token.from) == '\{'
    }
    None => false
  }
}

/// Whether a node's own tokens are leaves the tree cannot see into.
///
/// A statement's tokens are leaves, and so are a parameter list's, a return
/// type's and a generic list's: what is inside them is a group — `(`, `[`,
/// `<` — and the tree has no node for a group's members. A line that a
/// formatter indents *inside* one of those is a line this cannot decide, so
/// it is left as it was found.
///
/// The bodies nested inside such a node are the exception and are not
/// opaque: an `if`'s block is a `Node.Body`, its depth is known, and its
/// lines are indented. Only the leaves between the bodies are unknown.
fn holdsAGroup(kind: Node) -> Bool {
  kind == Node.Stmt || kind == Node.Member || kind == Node.Returns ||
    kind == Node.Generics || kind == Node.TypeAlias || kind == Node.Use
}

/// Whether a line inside this node's leaves is a *continuation*: an
/// expression that ended the line above on an operator and is still going.
///
/// Only where an expression lives. The other four [`holdsAGroup`] kinds hold
/// a type or a path, and a line inside one of those is one this cannot place:
/// `fn f<\n  T,\n  E,\n>` breaks at commas the tree has not made members of,
/// and indenting the `>` as though it continued the `E,` above it is exactly
/// the mistake `-1` is there to avoid.
fn continuing(kind: Node) -> Bool {
  kind == Node.Stmt || kind == Node.Member
}

/// Whether a node decides the depth of the lines inside it.
///
/// The nodes a parser slice has taken apart far enough to know where their
/// members begin. Everything else is a run of leaves, and a line inside one
/// of those is a line with no depth to read — see [`holdsAGroup`].
fn indenting(kind: Node) -> Bool {
  kind == Node.Body || kind == Node.Params || kind == Node.Group
}

/// How wide `tree` is written on one line, in characters.
///
/// Exactly the length of what [`flattened`] would produce, and it has to be:
/// a width that does not match the string it predicts is a width that answers
/// a different question than the one the caller asked.
///
/// Every token it covers, with each run of space counted as the one space a
/// flattened line would have — which is what `cove_syntax::format`'s `flat`
/// builds by walking an expression and what this can read off the tokens
/// instead. The tiling is why: a node's tokens *are* its text, so its width
/// is their widths and no tree walk is needed to find them.
///
/// Characters and not bytes, because a column is what a width limit counts
/// and `—` is one column and three bytes. `Token.to - Token.from` is bytes,
/// so the text is measured rather than subtracted.
fn flatWidth(source: String, held: Array<Token>, tree: Tree) -> Int {
  var width = 0
  var at = tree.from
  while at < tree.to {
    match held.get(at) {
      Some(token) => {
        if token.kind == Kind.Space {
          // What [`flattened`] would write there, which is one space or none.
          // Counting every run as one made a group a column wider than the
          // line it would produce — `f(\n  a,\n)` measured as `f( a,)` — and
          // the two runs against the brackets are exactly the two a call has.
          if wantsASpace(source, held, at) {
            width = width + 1
          }
        } else if isTriviaKind(token.kind) {
          // A comment cannot be flattened at all — `breaks` says so and the
          // caller asks that first, so the width it would have is not a
          // question here.
          width = width + 1
        } else {
          width = width + text(source, token).length()
        }
      }
      None => { }
    }
    at = at + 1
  }
  // The comma a broken group ends its last member with, taken off once. Asked
  // of every token instead, it is two builtin calls per comma in the file and
  // measured 11% of the whole run.
  if endsOnATrailingComma(source, held, tree) {
    width - 1
  } else {
    width
  }
}

/// Whether `tree`'s closing bracket has a comma in front of it.
fn endsOnATrailingComma(
  source: String,
  held: Array<Token>,
  tree: Tree,
) -> Bool {
  var i = tree.to - 2
  while i > tree.from {
    match held.get(i) {
      Some(token) => {
        if token.kind != Kind.Space {
          return byteOfPunct(source, held, i) == ','
        }
      }
      None => { }
    }
    i = i - 1
  }
  false
}

/// Whether `kind` is space or a comment.
fn isTriviaKind(kind: Kind) -> Bool {
  kind == Kind.Space || kind == Kind.LineComment || kind == Kind.BlockComment ||
    kind == Kind.DocComment
}

/// Whether `tree` must be written across lines whatever its width.
///
/// `cove_syntax::format`'s `breaks`, and its own comment says what kind of
/// rule it is: *"This is a layout policy, not a limit: a declaration body, a
/// control flow body, and a lambda body always read better broken, and an
/// expression holding a comment can only keep it where it was written if it
/// breaks."*
///
/// Two of those three this can answer exactly. A comment is a token, so a
/// node holding one is found by looking; a block is a `Node.Body`, so a node
/// holding one that is not empty is found the same way. The third — which
/// *kind* of expression this is — the tree does not know, and it does not
/// need to: an `if`, a `match`, a `for`, a `while` and a `scope` all break
/// because they carry a body, and the body is what this sees.
fn mustBreak(source: String, held: Array<Token>, tree: Tree) -> Bool {
  var at = tree.from
  while at < tree.to {
    match held.get(at) {
      Some(token) => {
        if token.kind == Kind.LineComment || token.kind == Kind.BlockComment ||
          token.kind == Kind.DocComment {
          return true
        }
      }
      None => { }
    }
    at = at + 1
  }
  holdsABody(source, held, tree)
}

/// Whether `tree` holds a `Node.Body` with anything in it.
///
/// An empty one does not break: `cove_syntax::format` asks
/// `!block_is_empty(block)`, so `fn() \{ \}` stays on its line.
fn holdsABody(source: String, held: Array<Token>, tree: Tree) -> Bool {
  for child in tree.children {
    if child.kind == Node.Body && breaksAsABody(source, held, child, tree.from) {
      return true
    }
    if holdsABody(source, held, child) {
      return true
    }
  }
  false
}

/// Whether a body with no parameter list in front of it forces its
/// surroundings onto several lines.
///
/// Not every one does. `cove_syntax::format`'s `trailing_breaks`: *"A
/// trailing closure stays on one line when its body is a single expression
/// that fits, so `tasks.spawn \{ fetch() \}` reads as the one call it is."*
/// So a trailing closure of one statement is not a break, and
/// `running.push(inflight.spawn \{ await runCheck(check, tally) \})` keeps
/// its line — while `items.filter(fn(item) \{ … \})` does not, because a
/// *lambda* body always breaks and the `(item)` is what says it is one.
///
/// Counted rather than asked of a kind, because the tree has no node for
/// "the tail" — a body's children are its braces, its trivia and its
/// statements, and one statement between two braces is the shape the rule is
/// about.
fn breaksAsABody(
  source: String,
  held: Array<Token>,
  body: Tree,
  from: Int,
) -> Bool {
  // A lambda's brace follows its *parameter* list, and a lambda body always
  // breaks. A trailing closure's follows the call it trails, and one of a
  // single statement keeps its line.
  //
  // A `)` in front of the brace does not tell them apart. `clock.timeout(1s)
  // { render()? }` has one and is a trailing closure; what says `fn(item) { …
  // }` is a lambda is the `fn` in front of the `(` that the `)` closes. The
  // `)` alone was the test here until a body could be written broken, and
  // then it put `clock.timeout(1s) \{ render("bookings")? \}?` on three lines.
  if closesAParameterList(source, held, previousSignificant(held, body.from)) {
    return true
  }
  // A control flow body always breaks, whatever is in it. `breaks` says so —
  // "a declaration body, a control flow body, and a lambda body always read
  // better broken" — and the one-statement rule below is about a trailing
  // closure and only about one. `if outside { 0 }` has one statement too, and
  // reading it as a closure is how `Ok(Options(…, food: if outside { 0 } …))`
  // came out on whatever line it was written on.
  if closesAHeader(source, held, body, from) {
    return true
  }
  // A match arm's block. `match_expr` writes an arm whose body is a block
  // with `block`, which always breaks. The `=>` in front of the brace is what
  // says so, and it is also where `closesAHeader`'s walk stops — a header
  // cannot have started before an arrow — so the two do not overlap.
  if isAnArrowOrEquals(source, held, previousSignificant(held, body.from)) {
    return true
  }
  var statements = 0
  for child in body.children {
    if child.kind == Node.Stmt {
      statements = statements + 1
    }
  }
  statements > 1
}

/// The token at or before `at` that is not trivia.
fn previousSignificant(held: Array<Token>, at: Int) -> Int {
  var i = at - 1
  while i >= 0 {
    match held.get(i) {
      Some(token) => {
        if token.kind != Kind.Space && token.kind != Kind.LineComment &&
          token.kind != Kind.BlockComment && token.kind != Kind.DocComment {
          return i
        }
      }
      None => { }
    }
    i = i - 1
  }
  -1
}

/// The column the next character would be written at.
///
/// Read back out of what has been written rather than carried alongside it:
/// `emit` already threads the token it last wrote and the depth it is at,
/// and a third parameter for a number the output already holds is a third
/// thing to keep in step.
fn column(out: Vector<String>) -> Int {
  var col = 0
  var at = out.length() - 1
  while at >= 0 {
    match out.get(at) {
      Some(piece) => {
        let after = lastBreakIn(piece)
        if after >= 0 {
          return col + piece.length() - after
        }
        col = col + piece.length()
      }
      None => { }
    }
    at = at - 1
  }
  col
}

/// The character position just past the last newline of `piece`, or `-1`
/// where it holds none.
///
/// One number rather than an `Option`, for `Scan::at`'s reason: every caller
/// asks the same question of it and `-1` fails the test without a `match`.
fn lastBreakIn(piece: String) -> Int {
  var found = -1
  var at = 0
  let end = piece.byteLength()
  while at < end {
    if piece.byteAt(at) == '\n' {
      found = at + 1
    }
    at = at + 1
  }
  found
}

/// The line width a formatter keeps within, in columns.
///
/// `cove_syntax::format::MAX_WIDTH`, which is 80. Cove has no module-level
/// constant, so this is a function; see `maxBreaks` for the same shape and
/// the same reason.
fn maxWidth() -> Int {
  80
}

/// Whether `tree` ends on the bracket that closes it.
///
/// A group that reaches the end of the file without one is a file somebody
/// is in the middle of typing — `fn open(` and nothing after it — and it is
/// not foldable: folding replaces its newlines with spaces, and the newline
/// at the end of an unterminated group is the end of the file. The tiling
/// holds either way and the text would not.
///
/// It is the same promise `balanced` makes one level down, and the one
/// `printing_gives_back_source_that_does_not_parse` is about: what a
/// formatter does with a file that does not parse is give it back.
fn isClosed(source: String, held: Array<Token>, tree: Tree) -> Bool {
  let last = tree.to - 1
  let c = byteOfPunct(source, held, last)
  c == ')' || c == ']'
}

/// Whether `tree`'s own members are written on lines of their own.
///
/// A newline and not merely space: a group that is already laid out is left
/// alone rather than rebuilt, and that is not an optimisation. Rebuilding it
/// would be deciding the space *inside* it — `f(a,  b)` would become
/// `f(a, b)` — and how much space goes between two tokens is a rule this
/// slice has not got to. Asking about space rather than about newlines is how
/// `a_line_does_not_end_on_a_blank` started failing while this was being
/// written.
///
/// **Its own members, and not every token it covers.** A newline inside a
/// body one of the members holds is that body's layout and says nothing about
/// this group's: `Ok(Options(manifest: match … \{ … \}, plan: …))` written on
/// one line has a newline in the middle of it, and answering "already laid
/// out" to that meant the group was never offered a decision and kept
/// whatever line it came on. The runs of space between the members are the
/// ones this group put there.
fn isBroken(source: String, held: Array<Token>, tree: Tree) -> Bool {
  for child in tree.children {
    if breaksLine(source, held, child) {
      return true
    }
  }
  false
}

/// `tree` on one line: its tokens in order, each run of space one space.
///
/// A run of space becomes exactly one space and a run that stood against a
/// bracket becomes none, which is what a flattened argument list looks like:
/// `f(\n  a,\n  b,\n)` is `f(a, b)` and not `f( a, b, )`.
fn flattened(source: String, held: Array<Token>, tree: Tree) -> String {
  var out = Vector.of<String>()
  var at = tree.from
  while at < tree.to {
    match held.get(at) {
      Some(token) => {
        if token.kind == Kind.Space {
          if wantsASpace(source, held, at) {
            out.push(" ")
          }
        } else if !isATrailingComma(source, held, at, tree.to) {
          out.push(text(source, token))
        }
      }
      None => { }
    }
    at = at + 1
  }
  "".join(out.freeze())
}

/// Whether the token at `at` is the comma a broken group ends its last
/// member with.
///
/// A group written across lines puts a comma after every member, the last
/// one included, because each is on a line of its own. Flattened there is no
/// last line to end, and `f(a, b,)` is not what `cove fmt` writes — so the
/// comma that stands against the closing bracket goes with the line breaks.
fn isATrailingComma(
  source: String,
  held: Array<Token>,
  at: Int,
  end: Int,
) -> Bool {
  if byteOfPunct(source, held, at) != ',' {
    return false
  }
  var i = at + 1
  while i < end {
    match held.get(i) {
      Some(token) => {
        if token.kind != Kind.Space {
          return byteOfPunct(source, held, i) == ')' ||
            byteOfPunct(source, held, i) == ']'
        }
      }
      None => { }
    }
    i = i + 1
  }
  false
}

/// How many columns the tokens from `at` to the end of their line take.
///
/// What a *declaration's* parameter list has to leave room for: `param_list`
/// holds back `width(return_type) + 4 + 2`, and the rest of the source line
/// after the `)` is exactly that — the `-> Result<T, F> \{` is on the same
/// line as the `)` that closes the list, so a list that fits on its own can
/// still be one that does not fit.
///
/// Not what a *call* leaves room for. See [`trailingBrace`].
///
/// It stops at the first run of space holding a newline, and counts a run
/// that does not as the one space it is.
fn restOfLine(source: String, held: Array<Token>, at: Int) -> Int {
  var width = 0
  var i = at
  // A `?` straight after the group is not counted. `cove_syntax::format`
  // writes `Try(inner)` by writing `inner` and then the `?`, and `inner` is
  // asked the width question with the `?` not yet on the line — so
  // `println("…")?` at 81 columns keeps its line, because the `println(…)`
  // inside it is 80. Counting the `?` here made covefmt break eight files'
  // worth of lines that `cove fmt` leaves alone.
  if byteOfPunct(source, held, i) == '?' {
    i = i + 1
  }
  while i < held.length() {
    match held.get(i) {
      Some(token) => {
        if token.kind == Kind.Space {
          if endsLine(source, token) {
            return width
          }
          width = width + 1
        } else {
          width = width + text(source, token).length()
          // And it stops at the brace. `param_list` holds back
          // `width(return_type) + 4 + 2` — the `-> Result<T, F> \{` and no
          // more — where the source line may carry the whole body behind it
          // if that body happens to be written on one line. Counting it broke
          // `fn classify(n: Int) -> String \{ … \}` into a parameter to a line
          // when it was the body that needed to break.
          if byteOfPunct(source, held, i) == '\{' {
            return width
          }
        }
      }
      None => { }
    }
    i = i + 1
  }
  width
}

/// Whether the run of space at `at` survives being written on one line.
///
/// [`wantsASpaceBetween`] asked of what stands either side of the run. It was
/// two cases — against a bracket, in front of a comma — and every other pair
/// kept whatever the source had, so `f(a,  b)` flattened to `f(a,  b)`.
fn wantsASpace(source: String, held: Array<Token>, at: Int) -> Bool {
  wantsASpaceBetween(source, held, at - 1, at + 1)
}

/// The byte of a one-byte punctuation token at `at`, or zero.
fn byteOfPunct(source: String, held: Array<Token>, at: Int) -> Int {
  match held.get(at) {
    Some(token) => {
      if token.kind != Kind.Punct || token.to - token.from != 1 {
        return 0
      }
      source.byteAt(token.from)
    }
    None => 0
  }
}

/// `tree`'s tokens, exactly as they were written.
///
/// What a group left flat writes: there is no newline inside one, so none of
/// the rules that read a run of space have anything to say about it, and
/// leaving it alone is both the right answer and the whole answer. See the
/// note in `emit` about the decision propagating.
fn verbatim(source: String, held: Array<Token>, tree: Tree) -> String {
  var out = Vector.of<String>()
  var at = tree.from
  while at < tree.to {
    match held.get(at) {
      Some(token) => out.push(text(source, token))
      None => { }
    }
    at = at + 1
  }
  "".join(out.freeze())
}

/// Whether breaking `tree` would make any line shorter.
///
/// `cove_syntax::format` refuses one case, and it is narrow: *"Breaking a
/// lone argument that cannot itself break, and would not fit on a line of
/// its own either, only makes the call longer."* One argument, bare, that
/// does not break on its own account — `arg_list` tests
/// `indent + INDENT + width(&value) + 1 > MAX_WIDTH`.
///
/// This said it of *every* member and measured each against the room left on
/// the line the group is on now, on the reasoning that what is over the limit
/// inside a group is over it one step further in too. That reasoning is
/// wrong, and the corpus could not show it: a member is written from a column
/// the *indent* decides, not from where the group happens to start, so an
/// argument with 68 columns left beside it can have 76 on a line of its own.
/// Measured on source whose line breaks had been taken out, this left
/// `println("…74 characters…")` at 87 columns, which `cove fmt` breaks.
fn worthBreaking(
  source: String,
  held: Array<Token>,
  tree: Tree,
  depth: Int,
) -> Bool {
  var members = 0
  var only = tree
  for child in tree.children {
    if child.kind == Node.Member {
      members = members + 1
      only = child
    }
  }
  // `arg_list`'s escape is for one argument and for no other number of them.
  // An empty list has none and breaks like any other: `test fn aVeryLongName(`
  // and then `) -> Result<Unit, Error> \{` is two lines that fit where one did
  // not, and `param_list` writes exactly that — its loop over the entries
  // writes nothing and the `)` still goes on a line of its own.
  if members != 1 {
    return true
  }
  // `arg_list` asks for a *bare* lone argument: a labelled one, a `var` one
  // or a spread breaks anyway, and so does one that would break on its own
  // account whatever width it is at.
  if isLabelled(source, held, only) || mustBreak(source, held, only) {
    return true
  }
  // The width it would have on a line of its own, with the comma each broken
  // member ends on. `indent + INDENT + width(&value) + 1`, in steps.
  (depth + 1) * 2 + flatWidth(source, held, only) + 1 <= maxWidth()
}

/// Whether `tree` is an array literal rather than an argument list.
fn isAnArray(source: String, held: Array<Token>, tree: Tree) -> Bool {
  byteOfPunct(source, held, tree.from) == '['
}

/// Whether `tree`'s brackets are there for precedence rather than for a call
/// or a list.
///
/// A call's `(` stands against its callee, a parameter list's against the
/// name it belongs to, and an index's `[` against what it indexes. One that
/// follows an operator, a keyword or a `!` belongs to no such thing: it is
/// what `expr` writes around an operand of lower precedence, and what is
/// inside it is written at the indent outside it.
///
/// Read as a list, `if !(a(x) ||\n  b(y)) \{` put its second line in column
/// zero — the group was too wide to fold and had no comma to break at, so it
/// was kept exactly as written.
fn isParenthesised(source: String, held: Array<Token>, tree: Tree) -> Bool {
  if byteOfPunct(source, held, tree.from) != '(' {
    return false
  }
  let before = previousSignificant(held, tree.from)
  if before < 0 {
    return true
  }
  match held.get(before) {
    Some(token) => {
      if token.kind == Kind.Word {
        return false
      }
      let c = byteOfPunct(source, held, before)
      !(c == ')' || c == ']' || c == '>')
    }
    None => true
  }
}

/// Whether `tree` is the pattern of a match arm rather than a call.
///
/// `cove_syntax::format` has `pattern_flat` and nothing else: a pattern is
/// always written on one line, however long the arm it opens turns out to be.
/// `Ok(options) => "…"` at 89 columns is left at 89 columns.
///
/// The tree has no node for a pattern — `Ok(options)` is a name and a group,
/// which is what a call is — so the `=>` behind it is what says so. Nothing
/// else in the language is written with one.
fn isAPattern(source: String, held: Array<Token>, tree: Tree) -> Bool {
  let after = nextSignificant(held, tree.to, held.length())
  if after < 0 {
    return false
  }
  match held.get(after) {
    Some(token) => {
      token.kind == Kind.Punct && token.to - token.from == 2 &&
        source.byteAt(token.from) == '=' && source.byteAt(token.from + 1) == '>'
    }
    None => false
  }
}

/// Whether `member` is written with a name in front of it, as `name: value`.
fn isLabelled(source: String, held: Array<Token>, member: Tree) -> Bool {
  let first = nextSignificant(held, member.from, member.to)
  if first < 0 {
    return false
  }
  let second = nextSignificant(held, first + 1, member.to)
  second >= 0 && byteOfPunct(source, held, second) == ':'
}

/// The first token at or after `at` and before `to` that is not trivia, or
/// `-1` when there is none.
fn nextSignificant(held: Array<Token>, at: Int, to: Int) -> Int {
  var i = at
  while i < to {
    match held.get(i) {
      Some(token) => {
        if !isTriviaKind(token.kind) {
          return i
        }
      }
      None => { }
    }
    i = i + 1
  }
  -1
}

/// Writes `tree` one member to a line, at `depth`.
///
/// The shape `cove_syntax::format` writes once it has refused the flat form:
/// the opening bracket ends its line, every member is a line of its own one
/// step further in and ends with a comma — the last one included, because
/// each is a line — and the closing bracket is a line at the depth the group
/// opened at.
fn writeBroken(
  source: String,
  held: Array<Token>,
  tree: Tree,
  depth: Int,
  var out: Vector<String>,
) {
  match held.get(tree.from) {
    Some(token) => out.push(text(source, token))
    None => { }
  }
  var last = tree.from
  for child in tree.children {
    if child.kind == Node.Member {
      out.push("\n")
      out.push(indentOf(depth + 1))
      // The member is *emitted*, not flattened: a group inside it is asked
      // the same question this one was just asked, one step further in and
      // with a whole line to answer it. Flattened, a call that is still too
      // wide at `depth + 1` came out on one line inside a group that had
      // broken precisely because it did not fit on one.
      //
      // This is why the writing happens into the caller's `out` rather than
      // into a string of its own: `column` reads the columns back out of what
      // has been written, so a member deciding its own width has to be able
      // to see the indentation in front of it.
      last = emit(
        source,
        held,
        child,
        last,
        depth + 1,
        noReservation(),
        var out,
      )
      out.push(",")
    }
  }
  out.push("\n")
  out.push(indentOf(depth))
  match held.get(tree.to - 1) {
    Some(token) => out.push(text(source, token))
    None => { }
  }
}

/// `depth` steps of indentation, two spaces each.
fn indentOf(depth: Int) -> String {
  var out = Vector.of<String>()
  var step = 0
  while step < depth {
    out.push("  ")
    step = step + 1
  }
  "".join(out.freeze())
}

/// Whether the group keeps its head on one line and lets its last member
/// expand below it.
///
/// `cove_syntax::format`'s `hug_last`, and its own comment says what it is
/// for: *"A final closure, call, or array argument keeps the call's head on
/// one line and expands below it, which is how a callback and a struct
/// initializer read at the call site."*
///
/// `hug_head` names the three that can be hugged — a lambda, a non-empty
/// array, a call with arguments — and each is a shape this tree has: a
/// lambda is a `Node.Body` with a `)` in front of it, and the other two are
/// a `Node.Group` with members. So the question is answerable without
/// knowing which kind of expression the member is.
///
/// `col` is where the group's own `(` is written, which is what `hug_last`
/// reads from `self.out.col()`. Both of its width tests are about the line
/// the *head* ends up on, so neither can be asked of the room left beside the
/// group as a whole.
///
/// # Half of the rule is still missing, and it is a different half
///
/// [`hugged`] writes the form when what expands is a `Node.Group` — a nested
/// call or an array. When it is a `Node.Body` — a lambda, a trailing closure
/// — this still only declines to *break* the group, which keeps a source that
/// already hugs and does not produce one that does not. Writing that case
/// means writing the statements of a body, which is the emitting loop's job
/// and not `broken`'s.
fn hugsItsLast(
  source: String,
  held: Array<Token>,
  tree: Tree,
  col: Int,
) -> Bool {
  var last = tree
  var members = 0
  for child in tree.children {
    if child.kind == Node.Member {
      members = members + 1
      last = child
    }
  }
  if members == 0 {
    return false
  }
  // `hug_applies`: a *closure* last argument hugs wherever it is written,
  // and anything else — a non-empty array, a call with arguments — hugs only
  // when it is the call's sole argument. So `push(Route(…))` expands its
  // initializer in place and `write(path, render(…))` breaks one argument to
  // a line, which is the difference between a shape that reads as one call
  // and a list that happens to end in a call.
  if !(bottomsOutInAClosure(source, held, last) ||
    members == 1 && !isLabelled(source, held, last)) {
    return false
  }
  if !canBeHugged(source, held, last) {
    return false
  }
  // The head: the `(`, then every earlier member and the `, ` behind it.
  // They stay on the call's line, so `hug_last` refuses outright when one of
  // them breaks rather than measuring it.
  var seen = 0
  var prefix = 1
  for child in tree.children {
    if child.kind == Node.Member {
      seen = seen + 1
      if seen < members {
        if mustBreak(source, held, child) {
          return false
        }
        prefix = prefix + flatWidth(source, held, child) + 2
      }
    }
  }
  let at = col + prefix
  // The last member's own head has to fit beside all of that, or the line the
  // hug is supposed to keep whole is not whole.
  if at + headWidth(source, held, last) > maxWidth() {
    return false
  }
  // `hug_last`: *"Hugging only helps when the argument really does expand
  // below the head; one that still fits on this line would leave the call as
  // long as it already was."*
  if !mustBreak(source, held, last) &&
    at + flatWidth(source, held, last) <= maxWidth() {
    return false
  }
  true
}

/// The token index just past the bracket the last member expands below: the
/// `\{` of a lambda, or the `(` or `[` of a nested call or array.
///
/// A lambda is asked for first because it has both — `fn(value: Int) \{` is a
/// group and a body, and `hug_head` matches `Lambda` before `Call`. `-1` when
/// the member has no such bracket, which is `hug_head`'s `None`.
fn headEndOf(member: Tree) -> Int {
  for child in member.children {
    if child.kind == Node.Body {
      return child.from + 1
    }
  }
  for child in member.children {
    if child.kind == Node.Group && hasAMember(child) {
      return child.from + 1
    }
  }
  -1
}

/// How wide the last member's head is: everything from its own first token —
/// its label included — to the bracket it expands below.
fn headWidth(source: String, held: Array<Token>, member: Tree) -> Int {
  let stop = headEndOf(member)
  if stop < 0 {
    return 0
  }
  widthBetween(source, held, member.from, stop)
}

/// The width of the tokens in `[from, to)`, written flat.
fn widthBetween(source: String, held: Array<Token>, from: Int, to: Int) -> Int {
  var width = 0
  var at = from
  while at < to {
    match held.get(at) {
      Some(token) => {
        width = width + if isTriviaKind(token.kind) {
          1
        } else {
          text(source, token).length()
        }
      }
      None => { }
    }
    at = at + 1
  }
  width
}

/// Whether what the last member expands below is a group rather than a body —
/// the case [`hugged`] can write.
fn headIsAGroup(tree: Tree) -> Bool {
  var last = tree
  var members = 0
  for child in tree.children {
    if child.kind == Node.Member {
      members = members + 1
      last = child
    }
  }
  if members == 0 {
    return false
  }
  // A lambda has both — `fn(value: Int) \{` is a group and a body — so the
  // body is asked for first, the way `headEndOf` and `hug_head` ask.
  for child in last.children {
    if child.kind == Node.Body {
      return false
    }
  }
  for child in last.children {
    if child.kind == Node.Group && hasAMember(child) {
      return true
    }
  }
  false
}

/// `tree` with its last member expanded below the call's head.
///
/// `hug_last` writes the head — the `(`, the earlier arguments flat, and the
/// last argument up to its own opening bracket — and then writes that last
/// argument **at the call's own indent**: `self.expr(&last.value, …, indent)`,
/// not `indent + INDENT`. So the nested group's members land one step in and
/// its closing bracket comes back to the call's own depth, where this call's
/// `)` joins it and the line reads `))`.
fn writeHugged(
  source: String,
  held: Array<Token>,
  tree: Tree,
  depth: Int,
  var out: Vector<String>,
) {
  match held.get(tree.from) {
    Some(token) => out.push(text(source, token))
    None => { }
  }
  var members = 0
  for child in tree.children {
    if child.kind == Node.Member {
      members = members + 1
    }
  }
  var seen = 0
  for child in tree.children {
    if child.kind == Node.Member {
      seen = seen + 1
      if seen < members {
        out.push(flattened(source, held, child))
        out.push(", ")
      } else {
        writeHug(source, held, child, depth, var out)
      }
    }
  }
  match held.get(tree.to - 1) {
    Some(token) => out.push(text(source, token))
    None => { }
  }
}

/// The last member, written with the group inside it broken: its own head,
/// then that group one member to a line, then whatever it is followed by.
///
/// The tail is what makes this take the member rather than the group: `f(g(a,
/// b)?)` has a `?` after the group and it belongs on the closing line.
fn writeHug(
  source: String,
  held: Array<Token>,
  member: Tree,
  depth: Int,
  var out: Vector<String>,
) {
  // A lambda or a trailing closure is written where it stands, its body
  // placed by the emitting loop rather than rebuilt. `hug_last` writes the
  // last argument with `self.expr(…, indent)`, at the call's own depth, which
  // is the depth this was handed.
  if isAClosure(member) {
    emit(source, held, member, member.from, depth, noReservation(), var out)
    return
  }
  for child in member.children {
    if child.kind == Node.Group && hasAMember(child) {
      out.push(decided(source, held, member.from, child.from))
      // A hug inside a hug: `withObservability(app, async fn(request) \{ … \})`
      // keeps its own head whole and expands *its* last argument, which is
      // what makes `hug_head`'s recursion visible in the output.
      if hugsInto(source, held, child) {
        writeHugged(source, held, child, depth, var out)
      } else {
        writeBroken(source, held, child, depth, var out)
      }
      out.push(decided(source, held, child.to, member.to))
      return
    }
  }
  out.push(flattened(source, held, member))
}

/// The tokens in `[from, to)`, exactly as they were written.
fn tokensBetween(
  source: String,
  held: Array<Token>,
  from: Int,
  to: Int,
) -> String {
  var out = Vector.of<String>()
  var at = from
  while at < to {
    match held.get(at) {
      Some(token) => out.push(text(source, token))
      None => { }
    }
    at = at + 1
  }
  "".join(out.freeze())
}

/// Whether `member` has a head to hug at all: a lambda's or trailing
/// closure's brace, a non-empty array's `[`, or the `(` of a call that takes
/// arguments. `hug_head` answers `None` for everything else, and a call whose
/// last argument is a name or a literal has nothing to expand below it.
fn canBeHugged(source: String, held: Array<Token>, member: Tree) -> Bool {
  // `hug_head` matches on the expression's *own* kind, so a member that is
  // something else is not huggable however many calls are buried in it.
  // `stopped.lock(fn(it) \{ … \}) <= rounds()` is a comparison and
  // `hug_head` answers `None` for a `Binary`, so `assert(…)` around it breaks
  // one argument to a line.
  if splitsAtAnOperator(source, held, member) {
    return false
  }
  // The bracket a call or an array expands below is the one the member *ends*
  // on. `judge(a, b).detail()` ends on `detail()`, whose `args.is_empty()`
  // makes `hug_head` answer `None` — reading the first group instead found
  // the `(a, b)` and hugged a call that `cove fmt` breaks.
  var head = member
  var found = false
  for child in member.children {
    if child.kind == Node.Body || child.kind == Node.Group {
      head = child
      found = true
    }
  }
  if !found {
    return false
  }
  head.kind == Node.Body || hasAMember(head)
}

/// Whether `member` is a binary expression: an operator of its own, outside
/// anything bracketed.
fn splitsAtAnOperator(
  source: String,
  held: Array<Token>,
  member: Tree,
) -> Bool {
  for child in member.children {
    if child.kind == Node.Leaf && bindingOf(source, held, child.from) > 0 {
      return true
    }
  }
  false
}

/// Whether `member` is a lambda or a trailing closure — what `hug_head`
/// reports as `closure`, and the only shape that hugs when it is not the
/// call's sole argument.
fn isAClosure(member: Tree) -> Bool {
  for child in member.children {
    if child.kind == Node.Body {
      return true
    }
  }
  false
}

/// Whether `member`'s head bottoms out in a closure — `hug_head`'s second
/// answer, and the reason that function calls itself.
///
/// `builder.get("/health", withObservability(app, async fn(request) \{ … \}))`
/// is a hug inside a hug. The outer call's last argument is not a closure; it
/// is a call. But *its* last argument is one, and it hugs, so the outer head
/// runs all the way to the lambda's brace and the whole thing keeps its line.
///
/// Asked one level deep the answer is no, and the outer call then breaks one
/// argument to a line — which is what covefmt wrote before this, on four
/// files of the corpus.
fn bottomsOutInAClosure(
  source: String,
  held: Array<Token>,
  member: Tree,
) -> Bool {
  if isAClosure(member) {
    return true
  }
  for child in member.children {
    if child.kind == Node.Group && hasAMember(child) {
      return hugsInto(source, held, child) &&
        bottomsOutInAClosure(source, held, lastMemberOf(child))
    }
  }
  false
}

/// Whether `group`'s own last member is one it would hug — `hug_head`'s
/// inner test, which is `hug_applies` and the refusal to hug past an earlier
/// argument that breaks.
///
/// The two width tests are not here. They belong to `hug_last`, which decides
/// whether the outermost call hugs at all; this one only asks what shape the
/// head has.
fn hugsInto(source: String, held: Array<Token>, group: Tree) -> Bool {
  var members = 0
  for child in group.children {
    if child.kind == Node.Member {
      members = members + 1
    }
  }
  if members == 0 {
    return false
  }
  let last = lastMemberOf(group)
  if !canBeHugged(source, held, last) {
    return false
  }
  if !(bottomsOutInAClosure(source, held, last) ||
    members == 1 && !isLabelled(source, held, last)) {
    return false
  }
  var seen = 0
  for child in group.children {
    if child.kind == Node.Member {
      seen = seen + 1
      if seen < members && mustBreak(source, held, child) {
        return false
      }
    }
  }
  true
}

/// `group`'s last member, which every caller here has already checked it has.
fn lastMemberOf(group: Tree) -> Tree {
  var last = group
  for child in group.children {
    if child.kind == Node.Member {
      last = child
    }
  }
  last
}

/// Whether `tree` has a `Node.Member` among its children.
fn hasAMember(tree: Tree) -> Bool {
  for child in tree.children {
    if child.kind == Node.Member {
      return true
    }
  }
  false
}

/// The top of a stack of depths, which is never asked of an empty one.
fn topOf(stack: Vector<Int>) -> Int {
  match stack.get(stack.length() - 1) {
    Some(top) => top
    None => 0
  }
}

/// How tightly the operator at token `j` binds, loosest first, and `0` for
/// anything that is not a binary operator.
///
/// `binary_prec`'s order, used here for what that order is for: telling a
/// break that has descended into an operand from one that has climbed back
/// out of it.
///
/// A `0` — a comma, an `=`, a leading `.` — is looser than everything, so it
/// clears the stack and indents one step from the statement. That is right
/// for all three: none of them is written inside a binary operand.
fn bindingOf(source: String, held: Array<Token>, j: Int) -> Int {
  match held.get(j) {
    Some(token) => {
      if token.kind == Kind.Word {
        return if isWord(source, held, j, "is") {
          3
        } else {
          0
        }
      }
      if token.kind != Kind.Punct {
        return 0
      }
      let width = token.to - token.from
      let a = source.byteAt(token.from)
      if width == 2 {
        let b = source.byteAt(token.from + 1)
        if a == '|' && b == '|' {
          return 1
        }
        if a == '&' && b == '&' {
          return 2
        }
        // `==`, `!=`, `<=`, `>=`. A `+=` is an assignment and not one of
        // these, and its first byte is what says so.
        if b == '=' && (a == '=' || a == '!' || a == '<' || a == '>') {
          return 3
        }
        return 0
      }
      if width != 1 {
        return 0
      }
      if a == '<' || a == '>' {
        return 3
      }
      if a == '+' || a == '-' {
        return 4
      }
      if a == '*' || a == '/' || a == '%' {
        return 5
      }
      0
    }
    None => 0
  }
}

/// Whether `child` is a run of space, newline or not.
///
/// Asked of a body's second-to-last child, which is the space in front of the
/// closing brace *when there is one*. A statement that stopped in front of a
/// `\}` on its own line leaves that space behind; one that stopped in front of
/// a `\}` on the *same* line took it with it, and then the statement itself is
/// second-to-last and must not be given the brace's depth.
fn isARunOfSpace(held: Array<Token>, child: Tree) -> Bool {
  if child.to - child.from != 1 {
    return false
  }
  match held.get(child.from) {
    Some(token) => token.kind == Kind.Space
    None => false
  }
}

/// Whether `child` is a run of space holding a newline.
fn breaksLine(source: String, held: Array<Token>, child: Tree) -> Bool {
  if child.to - child.from != 1 {
    return false
  }
  match held.get(child.from) {
    Some(token) => token.kind == Kind.Space && endsLine(source, token)
    None => false
  }
}

/// What a *statement* leaves room for, which nobody here knows: the rest of
/// its own line, which [`reservedFor`] reads from the source.
///
/// `writeBrokenBody` writes statements and must hand this down rather than
/// the member's zero. Handing down the zero let
/// `fn toEndOfLine(var self, …) -> Tree \{` keep its parameters on an
/// 82-column line, because the `-> Tree \{` behind them was no longer
/// reserved.
fn asksTheLine() -> Int {
  -1
}

/// What a member of a broken group leaves room for, which is nothing.
///
/// It is written on a line of its own and the comma goes behind it, and
/// `cove fmt` lets that comma sit in column 81: `expr`'s width test is
/// `self.out.col() + width(&flat) <= MAX_WIDTH` with no reservation at all,
/// and `readOptions([…])?.program.name(),` is 81 columns in the corpus and
/// left there.
///
/// `arg_list` does reserve one, in the *other* test — the lone-argument
/// escape is `indent + INDENT + width(&value) + 1 > MAX_WIDTH`, which
/// [`worthBreaking`] has. The two are different questions and only one of
/// them counts the comma.
fn noReservation() -> Int {
  0
}

/// How much of the line this group has to leave for what comes after it.
///
/// `cove_syntax::format` has two answers and they are not the same:
///
/// - `param_list`, for a *declaration's* parameters, holds back
///   `width(return_type) + 4 + 2` — the `-> Result<T, F> \{` sits on the same
///   line as the `)`, so a list that fits on its own can still be one that
///   does not fit. The rest of the source line after the `)` is exactly that,
///   which is what [`restOfLine`] reads.
/// - `arg_list`, for a *call's* arguments, holds back *"Two more columns for
///   the ` \{` of a trailing closure"* and nothing else. Not the `.name()`
///   behind it, not the `\{` of an `if`'s block, not the `&&` and the operand
///   after that. Whatever is out there is asked its own width question when
///   it is reached, and that is what makes the outside-in walk greedy rather
///   than a lookahead.
///
/// Reading the rest of the line for both made a call reserve two columns for
/// every `if` header's brace, and `cove fmt` leaves one of those at 81
/// columns rather than break what is in front of it.
///
/// Which one a group is cannot be asked of its kind. A method inside an
/// `impl` has its parameters taken by `grouped`, because a declaration's
/// members are read one to a line and the `(` on the way is a group like any
/// other — so `Node.Params` is only some of them. The `->` behind it is what
/// every parameter list has and no call does.
fn reservedFor(source: String, held: Array<Token>, tree: Tree) -> Int {
  if tree.kind == Node.Params {
    return restOfLine(source, held, tree.to)
  }
  let after = nextSignificant(held, tree.to, held.length())
  if after < 0 {
    return 0
  }
  match held.get(after) {
    Some(token) => {
      if token.kind == Kind.Punct && token.to - token.from == 2 &&
        source.byteAt(token.from) == '-' && source.byteAt(token.from + 1) == '>' {
        return restOfLine(source, held, tree.to)
      }
      if byteOfPunct(source, held, after) == '\{' &&
        !opensAHeader(source, held, tree) {
        return 2
      }
      0
    }
    None => 0
  }
}

/// Whether the `\{` behind this group closes a *header* rather than trailing
/// the call.
///
/// `arg_list` is told `has_trailing` by the tree it walks. This one cannot
/// be: `spawn(deadline) \{ … \}` and `if a != b.length() \{ … \}` both put a
/// `\{` after a `)`, and the token before it says nothing. What does say it is
/// the word the *line* opens on — `if`, `while`, `for`, `match`, `else` — and
/// a header's brace belongs to the control flow, which `if_expr` writes after
/// the condition without holding back a column for it.
///
/// Reserving those two columns anyway broke
/// `if token.kind != Kind.Punct || token.to - token.from != mark.byteLength() \{`
/// after the `()`, which is one column over and which `cove fmt` leaves.
fn opensAHeader(source: String, held: Array<Token>, tree: Tree) -> Bool {
  var i = tree.from - 1
  var first = -1
  while i >= 0 {
    match held.get(i) {
      Some(token) => {
        if token.kind == Kind.Space && endsLine(source, token) {
          i = -1
        } else {
          if !isTriviaKind(token.kind) {
            first = i
          }
          i = i - 1
        }
      }
      None => {
        i = i - 1
      }
    }
  }
  if first < 0 {
    return false
  }
  match held.get(first) {
    Some(token) => {
      if token.kind != Kind.Word {
        return false
      }
      match source.sliceBytes(token.from, token.to) {
        Ok(word) => {
          word == "if" || word == "while" || word == "for" || word == "match" ||
            word == "else"
        }
        Err(_) => false
      }
    }
    None => false
  }
}

/// Whether the `\{` at `body.from` opens a body that always breaks: a
/// declaration's, a control flow header's, or a lambda's.
///
/// The tree has no node for a header, so the tokens are read instead: from
/// the node the body belongs to, up to the brace, looking for one of the
/// words that open such a body at the *outside* of any bracket.
///
/// # Forward, and not backward
///
/// This walked back from the brace to the first word it met, stopping where a
/// header could not have begun — at a label, a comma, an assignment. Every
/// one of those stops turned out to have a case where it was wrong, and each
/// cost a family of the corpus: `if i % 7 == 0 \{` stopped at the `==`,
/// `fn isEmpty<K, V>(…)` at the comma between its type parameters, and
/// `fn headline<T: Summary>(…)` at the colon of its bound.
///
/// Going forward there is nothing to stop at. A keyword outside every bracket
/// is a keyword that governs this brace, and a trailing closure —
/// `tasks.spawn \{ … \}`, `clock.timeout(d) \{ … \}` — has none: the words in
/// front of its brace are a receiver and a method. The lambda inside a call
/// is reached with its own `fn` at depth zero, because the node it belongs to
/// begins there.
fn closesAHeader(
  source: String,
  held: Array<Token>,
  body: Tree,
  from: Int,
) -> Bool {
  var depth = 0
  var i = from
  while i < body.from {
    match held.get(i) {
      Some(token) => {
        let c = byteOfPunct(source, held, i)
        if c == '(' || c == '[' {
          depth = depth + 1
        } else if c == ')' || c == ']' {
          depth = depth - 1
        } else if depth <= 0 && token.kind == Kind.Word &&
          opensABody(source, token) {
          return true
        }
      }
      None => { }
    }
    i = i + 1
  }
  false
}

/// Whether `token` is one of the words a body that always breaks opens on.
///
/// `breaks`: *"a declaration body, a control flow body, and a lambda body
/// always read better broken."*
fn opensABody(source: String, token: Token) -> Bool {
  match source.sliceBytes(token.from, token.to) {
    Ok(text) => {
      text == "if" || text == "while" || text == "for" || text == "match" ||
        text == "else" || text == "fn" || text == "impl" || text == "trait" ||
        text == "struct" || text == "enum"
    }
    Err(_) => false
  }
}

/// Whether the token at `i` is `=`, `=>`, or a compound assignment.
fn isAnArrowOrEquals(source: String, held: Array<Token>, i: Int) -> Bool {
  match held.get(i) {
    Some(token) => {
      if token.kind != Kind.Punct {
        return false
      }
      let width = token.to - token.from
      if width != 1 && width != 2 {
        return false
      }
      let a = source.byteAt(token.from)
      if width == 1 {
        return a == '='
      }
      let b = source.byteAt(token.from + 1)
      // A compound assignment, and not a comparison. `==`, `!=`, `<=` and
      // `>=` are two bytes ending in `=` as well, and reading one of those as
      // an assignment stopped the walk in `if i % 7 == 0 \{` before it reached
      // the `if` — so a one-statement `if` among several kept its line, on
      // half the corpus.
      b == '=' && (a == '+' || a == '-' || a == '*' || a == '/' || a == '%') ||
        a == '=' && b == '>'
    }
    None => false
  }
}

/// Whether `body` is one this can lay out.
///
/// It has to have statements: `block` writes `\{ \}` for an empty one and does
/// not break it.
///
/// A comment is no longer a reason to refuse. [`writeBrokenBody`] writes every
/// child of the body and only *forces* the gaps between them to be lines, so a
/// comment stays where it was written, and a line comment is guaranteed the
/// break behind it that keeps it from eating what follows.
fn writesBroken(source: String, held: Array<Token>, body: Tree) -> Bool {
  var statements = 0
  for child in body.children {
    if child.kind == Node.Stmt {
      statements = statements + 1
    }
  }
  statements > 0
}

/// Writes `body` with a statement to a line, at `depth`.
///
/// `block`'s shape: the `\{` ends its line, every statement is a line of its
/// own one step further in, and the `\}` is a line at the depth the body
/// opened at.
///
/// What it writes is not the body rebuilt from its statements — it is the
/// body's own children, with the *gaps* between them forced to be lines. That
/// is what lets it run over a body that is only partly on one line, which is
/// what a `\}` pulled up onto the line above leaves: `impl Format \{` on its
/// own line and `\} \}` at the end.
fn writeBrokenBody(
  source: String,
  held: Array<Token>,
  body: Tree,
  depth: Int,
  var out: Vector<String>,
) {
  let children = body.children
  let count = children.length()
  var last = body.from
  var i = 0
  for child in children {
    let closing = i + 1 == count
    // The run of space in front of the closing brace is the line that brace
    // begins on, so it is written at the body's own depth — and only when it
    // *is* a run of space. A statement that stopped in front of a `\}` on the
    // same line took that space with it, and is then second-to-last itself.
    let beforeTheClose = i + 2 == count && isARunOfSpace(held, child)
    let at = if beforeTheClose {
      depth
    } else {
      depth + 1
    }
    if i == 0 || closing {
      // The braces, at the depth the body opened at. The closer needs a line
      // of its own, and gets one here when what stands in front of it was not
      // a run of space to put it on.
      if closing && !isARunOfSpace(held, childAt(children, i - 1)) {
        trimTrailing(var out)
        out.push("\n")
        out.push(indentOf(depth))
      }
      last = emit(source, held, child, last, depth, asksTheLine(), var out)
    } else if isARunOfSpace(held, child) && !breaksLine(source, held, child) {
      // A gap that is not a line becomes one. The runs that already hold a
      // newline go through `spacing` as they always did, which is what keeps
      // a blank line between two statements to the one it is allowed.
      trimTrailing(var out)
      out.push("\n")
      out.push(indentOf(at))
    } else {
      last = emit(source, held, child, last, at, asksTheLine(), var out)
    }
    i = i + 1
  }
}

/// The child at `i`, or a placeholder leaf when there is none.
fn childAt(children: Array<Tree>, i: Int) -> Tree {
  match children.get(i) {
    Some(child) => child
    None => leafAt(0)
  }
}

/// Drops the pieces at the end of `out` that are nothing but space.
fn trimTrailing(var out: Vector<String>) {
  while out.length() > 0 {
    let done = match out.get(out.length() - 1) {
      Some(piece) => {
        if isOnlySpace(piece) {
          out.pop()
          false
        } else {
          true
        }
      }
      None => true
    }
    if done {
      return
    }
  }
}

/// Whether `piece` is a non-empty run of spaces and tabs.
fn isOnlySpace(piece: String) -> Bool {
  let n = piece.byteLength()
  if n == 0 {
    return false
  }
  var at = 0
  while at < n {
    let c = piece.byteAt(at)
    if c != ' ' && c != '\t' {
      return false
    }
    at = at + 1
  }
  true
}

/// Whether the token at `at` is a `)` closing a `fn(…)` parameter list.
///
/// Walks back to the `(` it closes and asks what stands in front of it. The
/// brackets in between are counted, so `fn(a: Array<Int>, b: (Int, Int))`
/// answers about its own `(` and not about one of the pairs inside it.
fn closesAParameterList(source: String, held: Array<Token>, at: Int) -> Bool {
  if byteOfPunct(source, held, at) != ')' {
    return false
  }
  var depth = 0
  var i = at
  while i >= 0 {
    let c = byteOfPunct(source, held, i)
    if c == ')' || c == ']' {
      depth = depth + 1
    } else if c == '(' || c == '[' {
      depth = depth - 1
      if depth == 0 {
        return isWord(source, held, previousSignificant(held, i), "fn")
      }
    }
    i = i - 1
  }
  false
}

/// Whether the `fn` at `at` is a lambda's rather than a declaration's.
///
/// A declaration is `fn name(…)` and a lambda is `fn(…)`, so the token after
/// the word is the whole of the difference.
fn opensALambda(source: String, held: Array<Token>, at: Int) -> Bool {
  byteOfPunct(source, held, nextSignificant(held, at + 1, held.length())) == '('
}

/// Whether the word at `i` is one a declaration may be written in front of.
///
/// `export fn greeting(…) -> String \{` opens on `export`, and the word that
/// says what the body is belongs behind it. Left in, the walk reached the
/// modifier and answered that nothing declared this.
fn isAModifier(source: String, held: Array<Token>, i: Int) -> Bool {
  isWord(source, held, i, "export") || isWord(source, held, i, "test") ||
    isWord(source, held, i, "async") || isWord(source, held, i, "opaque")
}

/// Whether `member` is a chain long enough to break before its dots.
///
/// `call`: *"A chain of calls that is merely too long breaks before its
/// dots."* It applies when `call_count(&ops) >= 2` and `chain_break_points`
/// found one — a field access that follows a call, which is what makes
/// `a.b().c` a chain rather than a path.
fn breaksAtItsDots(source: String, held: Array<Token>, member: Tree) -> Bool {
  var calls = 0
  var dots = 0
  var afterACall = false
  for child in member.children {
    if child.kind == Node.Group && byteOfPunct(source, held, child.from) == '(' {
      calls = calls + 1
      afterACall = true
    } else if child.kind == Node.Leaf &&
      byteOfPunct(source, held, child.from) == '.' && afterACall {
      dots = dots + 1
    }
  }
  calls >= 2 && dots > 0
}

/// `member` written with a line before each dot that follows a call.
///
/// `chain` writes the base and then each operator in turn: at a break point
/// it starts a line one step in, and every argument list from there on is
/// written at that step. The argument lists themselves are not flattened —
/// `readOptions([…])?` may still break its array while the `.format` below it
/// goes on a line of its own.
fn writeChain(
  source: String,
  held: Array<Token>,
  member: Tree,
  depth: Int,
  var out: Vector<String>,
) {
  var last = member.from
  var afterACall = false
  var level = depth
  for child in member.children {
    if afterACall && child.kind == Node.Leaf &&
      byteOfPunct(source, held, child.from) == '.' {
      level = depth + 1
      // Whatever space stood in front of the dot is what the line break is
      // replacing, and on a line of its own it would be trailing.
      trimTrailing(var out)
      out.push("\n")
      out.push(indentOf(level))
    }
    last = emit(source, held, child, last, level, noReservation(), var out)
    if child.kind == Node.Group && byteOfPunct(source, held, child.from) == '(' {
      afterACall = true
    }
  }
}

/// Where the run of leaves holding `at` ends: the first body after it, or the
/// end of the node.
///
/// An expression's right operand stops in front of the `\{` that opens the
/// block behind it. `if_expr` writes the condition and *then* the block, and
/// the condition's width question never sees the brace.
fn expressionEnds(held: Array<Token>, tree: Tree, at: Int) -> Int {
  for child in tree.children {
    if child.kind == Node.Body && child.from >= at {
      // And in front of the run of space that puts the brace on the line, for
      // the same reason: `if a || b \{` at 82 columns is a condition of 80
      // and `cove fmt` leaves the brace hanging over.
      return child.from - 1
    }
  }
  // A statement that stopped in front of a `\}` on the same line took the run
  // of space between them with it, and that space is not part of what has to
  // fit: `\{ f(a) == '(' \}` re-opened is an 80-column line, and counting the
  // space in front of the brace made it 81 and split it.
  if isARunOfSpace(held, childAt(tree.children, tree.children.length() - 1)) {
    return tree.to - 1
  }
  tree.to
}

/// The loosest binary operator in `[from, to)` that is outside every bracket,
/// or `0` when there is none.
///
/// `binary` is handed the top of the expression, which is the loosest
/// operator in it, and splits there before anything tighter is considered.
fn loosestIn(source: String, held: Array<Token>, from: Int, to: Int) -> Int {
  var loosest = 0
  var depth = 0
  var angles = 0
  var i = from
  while i < to {
    let c = byteOfPunct(source, held, i)
    if c == '(' || c == '[' || c == '\{' {
      depth = depth + 1
    } else if c == ')' || c == ']' || c == '\}' {
      depth = depth - 1
    } else if c == '<' && opensAGenericList(held, i) {
      // `Array<EventHandler>` is a type and not two comparisons. Counted as
      // one, the plan split `let handlers: Array<EventHandler> = […]` at the
      // `>`.
      angles = angles + 1
    } else if c == '>' && angles > 0 {
      angles = angles - 1
    } else if depth <= 0 && angles <= 0 {
      let binds = bindingOf(source, held, i)
      if binds > 0 && (loosest == 0 || binds < loosest) {
        loosest = binds
      }
    }
    i = i + 1
  }
  loosest
}

/// The depth a token is planned to begin a line at, or `-1`.
fn levelPlanned(marks: Vector<Int>, levels: Vector<Int>, at: Int) -> Int {
  var i = 0
  while i < marks.length() {
    if marks.get(i) == Some(at) {
      return match levels.get(i) {
        Some(level) => level
        None => -1
      }
    }
    i = i + 1
  }
  -1
}

/// Where the leaves in `[from, to)` have to break, written into `marks` and
/// `levels`.
///
/// `binary`, unrolled. The expression is split at its top operator — the
/// **last** of the loosest, because the language associates to the left — and
/// the two halves are asked the same question: the left at the column this
/// one started at, the right either behind the operator or on a line of its
/// own one step in.
///
/// It is only ever called for a run of leaves that does not fit, which is why
/// a list of the few positions it finds costs less than a mark for every
/// token in the file.
fn planBreaks(
  source: String,
  held: Array<Token>,
  from: Int,
  to: Int,
  col: Int,
  level: Int,
  var marks: Vector<Int>,
  var levels: Vector<Int>,
) {
  if col + widthBetween(source, held, from, to) <= maxWidth() {
    return
  }
  let op = lastLoosest(source, held, from, to)
  if op < 0 {
    return
  }
  if op <= from {
    return
  }
  let lhsEnd = op + 1
  // The left half is asked without the operator in it. Left in, the search
  // finds the same operator again and the recursion never ends.
  planBreaks(source, held, from, op, col, level, var marks, var levels)
  let rhs = nextSignificant(held, lhsEnd, to)
  if rhs < 0 {
    return
  }
  let after = columnAfter(source, held, from, lhsEnd, col, level, marks, levels)
  // The operand, and not the run of space behind it that the *next* operator
  // stands on. `binary` writes that operator after the operand without asking
  // anything, which is how `cove fmt` comes to leave an 83-column line: the
  // fit it checked was the 80 in front of it.
  let operand = lastSignificantIn(held, rhs, to)
  if after + 1 + widthBetween(source, held, rhs, operand) > maxWidth() {
    marks.push(rhs)
    levels.push(level + 1)
    planBreaks(
      source,
      held,
      rhs,
      to,
      (level + 1) * 2,
      level + 1,
      var marks,
      var levels,
    )
  } else {
    planBreaks(source, held, rhs, to, after + 1, level, var marks, var levels)
  }
}

/// The column the leaves in `[from, to)` leave behind, written out one token
/// at a time.
///
/// Not the sum of their widths. A break already planned inside them starts the
/// line again at its own indent, and so does a *group* that cannot fit: after
/// `widthBetween(\n  …,\n  )` the line is back at the closing bracket, however
/// wide the call would have been on one line.
///
/// Reading it as a sum put `) > maxWidth() \{` on two lines — the `>` looked
/// as though it stood at column 70 when it stands at column 7.
fn columnAfter(
  source: String,
  held: Array<Token>,
  from: Int,
  to: Int,
  col: Int,
  level: Int,
  marks: Vector<Int>,
  levels: Vector<Int>,
) -> Int {
  var c = col
  var i = from
  while i < to {
    let planned = levelPlanned(marks, levels, i)
    if planned >= 0 {
      c = planned * 2
    }
    let byte = byteOfPunct(source, held, i)
    if byte == '(' || byte == '[' {
      let close = closerOf(source, held, i, to)
      if close < 0 {
        return c + widthBetween(source, held, i, to)
      }
      let flat = widthBetween(source, held, i, close + 1)
      c = if c + flat <= maxWidth() {
        c + flat
      } else {
        // Broken: one member to a line, and the closing bracket on a line of
        // its own at the depth the group opened at.
        level * 2 + 1
      }
      i = close + 1
      continue
    }
    c = c + widthBetween(source, held, i, i + 1)
    i = i + 1
  }
  c
}

/// The index of the bracket closing the one at `at`, or `-1`.
fn closerOf(source: String, held: Array<Token>, at: Int, to: Int) -> Int {
  var depth = 0
  var i = at
  while i < to {
    let c = byteOfPunct(source, held, i)
    if c == '(' || c == '[' {
      depth = depth + 1
    } else if c == ')' || c == ']' {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  -1
}

/// The last operator of the loosest binding in `[from, to)`, outside every
/// bracket, or `-1`.
fn lastLoosest(source: String, held: Array<Token>, from: Int, to: Int) -> Int {
  let loosest = loosestIn(source, held, from, to)
  if loosest == 0 {
    return -1
  }
  var at = -1
  var depth = 0
  var angles = 0
  var i = from
  while i < to {
    let c = byteOfPunct(source, held, i)
    if c == '(' || c == '[' || c == '\{' {
      depth = depth + 1
    } else if c == ')' || c == ']' || c == '\}' {
      depth = depth - 1
    } else if c == '<' && opensAGenericList(held, i) {
      // `Array<EventHandler>` is a type and not two comparisons. Counted as
      // one, the plan split `let handlers: Array<EventHandler> = […]` at the
      // `>`.
      angles = angles + 1
    } else if c == '>' && angles > 0 {
      angles = angles - 1
    } else if depth <= 0 && angles <= 0 && bindingOf(source, held, i) == loosest {
      at = i
    }
    i = i + 1
  }
  at
}

/// Whether the `<` at `i` opens a generic list rather than comparing.
///
/// It is written against the name it belongs to — `Array<Token>`, never
/// `Array <Token>` — and a comparison has a space on each side, which
/// `cove_syntax::format` guarantees. The same heuristic `parse.cove`'s
/// `opensGenerics` makes, and its doc says what it costs.
fn opensAGenericList(held: Array<Token>, i: Int) -> Bool {
  match held.get(i - 1) {
    Some(token) => token.kind == Kind.Word
    None => false
  }
}

/// Whether one of `tree`'s own groups is already written across lines.
///
/// The plan measures flat widths, and a group that is already broken is not
/// written flat: after `widthBetween(\n  …,\n)` the line begins again at the
/// closing bracket, wherever the sum of the tokens said it would be. So when
/// there is one, the breaks the source has are the ones it keeps.
fn holdsABrokenGroup(source: String, held: Array<Token>, tree: Tree) -> Bool {
  for child in tree.children {
    if indenting(child.kind) && child.kind != Node.Body &&
      isBroken(source, held, child) {
      return true
    }
  }
  false
}

/// Whether the leaves in `[from, to)` run past the limit when written from
/// `col`.
///
/// The same question as `col + widthBetween(…) > maxWidth()` and not the same
/// cost: it stops as soon as the answer is yes, so a line that is far too long
/// is decided in eighty tokens rather than in all of them. Asked of every
/// statement and every member in the corpus, that is the difference between a
/// scan of the node and a scan of the line.
fn overflows(
  source: String,
  held: Array<Token>,
  from: Int,
  to: Int,
  col: Int,
) -> Bool {
  var width = col
  var at = from
  while at < to {
    match held.get(at) {
      Some(token) => {
        width = width + if token.kind == Kind.Space {
          if wantsASpace(source, held, at) {
            1
          } else {
            0
          }
        } else if isTriviaKind(token.kind) {
          1
        } else {
          text(source, token).length()
        }
        if width > maxWidth() {
          return true
        }
      }
      None => { }
    }
    at = at + 1
  }
  false
}

/// Whether a space goes between the tokens at `l` and `r`.
///
/// `cove_syntax::format` has no table for this — it writes each piece and the
/// spaces fall out of the writers — so the table is read off what it produces.
/// One space between two things, and none in these places:
///
/// - inside a bracket against the bracket: `f(x, y)`, `[1, 2]`;
/// - in front of a `,`, a `:`, a `?`;
/// - either side of a `.`, and either side of a range;
/// - between a callee and the `(` of its call, or a name and the `[` of an
///   index — but *not* in front of the `(` that `expr` writes for precedence,
///   which is [`isParenthesised`]'s question;
/// - inside a generic list, and between one and what it belongs to;
/// - after a prefix `!` or `-`.
///
/// The generic list and the prefix operator are told apart the way the rest
/// of this slice tells them apart: by what stands immediately against them.
/// `Vector<T>` writes its `<` against the name and `a > b` does not, which is
/// something `cove fmt` guarantees about every file this reads.
fn wantsASpaceBetween(
  source: String,
  held: Array<Token>,
  l: Int,
  r: Int,
) -> Bool {
  let a = byteOfPunct(source, held, l)
  let b = byteOfPunct(source, held, r)
  if a == '(' || a == '[' || b == ')' || b == ']' {
    return false
  }
  if b == ',' || b == ':' || b == '?' {
    return false
  }
  if a == '.' || b == '.' {
    return false
  }
  if isARange(source, held, l) || isARange(source, held, r) {
    return false
  }
  // `f(` and `v[`, against what they belong to. A `(` that `expr` wrote for
  // precedence belongs to nothing and keeps its space: `return (a || b)`.
  if b == '(' && !opensForPrecedence(source, held, r) {
    return false
  }
  if b == '[' && holdsSomething(source, held, l) {
    return false
  }
  // `Vector<T>`, and the `(` or the `,` behind its `>`.
  if a == '<' && closesAgainst(held, l) || b == '<' && closesAgainst(held, r) {
    return false
  }
  if b == '>' && closesAgainst(held, r) {
    return false
  }
  !prefixed(source, held, l)
}

/// Whether the token at `at` is `..` or `..<`.
fn isARange(source: String, held: Array<Token>, at: Int) -> Bool {
  match held.get(at) {
    Some(token) => {
      // `..` and `..<`, and not `...`: a variadic's ellipsis is written
      // against the type in front of it and takes a space behind it.
      token.kind == Kind.Punct && source.byteAt(token.from) == '.' &&
        (token.to - token.from == 2 ||
          token.to - token.from == 3 && source.byteAt(token.from + 2) == '<')
    }
    None => false
  }
}

/// Whether the token at `at` is written against the one before it, with no
/// run of space between.
///
/// What tells `Vector<T>` from `a > b`, and `f(x)` from `if (x)`.
fn closesAgainst(held: Array<Token>, at: Int) -> Bool {
  match held.get(at - 1) {
    Some(token) => token.kind != Kind.Space
    None => false
  }
}

/// Whether the `(` at `at` is the one `expr` writes for precedence rather
/// than a call's.
fn opensForPrecedence(source: String, held: Array<Token>, at: Int) -> Bool {
  !holdsSomething(source, held, previousSignificant(held, at))
}

/// Whether the token at `at` is something a `(` or a `[` can be written
/// against: a name, or the close of one.
fn holdsSomething(source: String, held: Array<Token>, at: Int) -> Bool {
  match held.get(at) {
    Some(token) => {
      if token.kind == Kind.Word {
        // A keyword is not a callee: `if (a || b) \{` keeps its space where
        // `f(a)` does not. The lexer does not tell a keyword from a name —
        // by design, it has no list — so the list is here, and it is only
        // the words a `(` can follow.
        return !isTheWord(source, token, "if") &&
          !isTheWord(source, token, "while") && !isTheWord(source, token, "for") &&
          !isTheWord(source, token, "match") &&
          !isTheWord(source, token, "else") &&
          !isTheWord(source, token, "return") && !isTheWord(source, token, "in") &&
          !isTheWord(source, token, "is") && !isTheWord(source, token, "break")
      }
      let c = byteOfPunct(source, held, at)
      c == ')' || c == ']' || c == '>' || c == '?'
    }
    None => false
  }
}

/// Whether the token at `at` is a prefix operator — a `!`, or a `-` with
/// nothing in front of it for it to subtract from.
fn prefixed(source: String, held: Array<Token>, at: Int) -> Bool {
  let c = byteOfPunct(source, held, at)
  if c == '!' {
    return true
  }
  if c != '-' {
    return false
  }
  // A `-` that opens its line has nothing in front of it to subtract from.
  // `previousSignificant` walks over the newline and finds the end of the
  // line above — the `)` of the arm before `-1 => …` — and read that as a
  // subtraction.
  if opensItsLine(source, held, at) {
    return true
  }
  let before = previousSignificant(held, at)
  !holdsSomething(source, held, before) && !isALiteral(held, before)
}

/// Whether the token at `at` is a number, a string or a character.
fn isALiteral(held: Array<Token>, at: Int) -> Bool {
  match held.get(at) {
    Some(token) => {
      token.kind == Kind.Number || token.kind == Kind.Str ||
        token.kind == Kind.Char
    }
    None => false
  }
}

/// Whether the token at `at` is a run of space.
fn isASpaceToken(held: Array<Token>, at: Int) -> Bool {
  match held.get(at) {
    Some(token) => token.kind == Kind.Space
    None => false
  }
}

/// Whether `token` is exactly `word`.
fn isTheWord(source: String, token: Token, word: String) -> Bool {
  match source.sliceBytes(token.from, token.to) {
    Ok(text) => text == word
    Err(_) => false
  }
}

/// The tokens in `[from, to)` with the space between them decided.
///
/// What a hug writes either side of the group it expands: `tally: ` in front
/// of it and a `?` behind. Copied byte for byte it kept whatever run of space
/// the source had there, which is the one thing this printer no longer does.
fn decided(source: String, held: Array<Token>, from: Int, to: Int) -> String {
  var out = Vector.of<String>()
  var at = from
  while at < to {
    match held.get(at) {
      Some(token) => {
        if token.kind == Kind.Space {
          if wantsASpace(source, held, at) {
            out.push(" ")
          }
        } else {
          out.push(text(source, token))
        }
      }
      None => { }
    }
    at = at + 1
  }
  "".join(out.freeze())
}

/// `text` without the spaces it ends on.
fn withoutTrailingSpace(text: String) -> String {
  var to = text.byteLength()
  while to > 0 && (text.byteAt(to - 1) == ' ' || text.byteAt(to - 1) == '\t') {
    to = to - 1
  }
  match text.sliceBytes(0, to) {
    Ok(kept) => kept
    Err(_) => text
  }
}

/// Whether the token at `at` is the first thing on its line.
fn opensItsLine(source: String, held: Array<Token>, at: Int) -> Bool {
  match held.get(at - 1) {
    Some(token) => token.kind == Kind.Space && endsLine(source, token)
    None => true
  }
}

/// One past the last token in `[from, to)` that is not a run of space.
fn lastSignificantIn(held: Array<Token>, from: Int, to: Int) -> Int {
  var at = to
  while at > from {
    match held.get(at - 1) {
      Some(token) => {
        if token.kind != Kind.Space {
          return at
        }
      }
      None => { }
    }
    at = at - 1
  }
  from
}

/// Whether any comment in `held` has something of its line in front of it.
fn holdsATrailingComment(source: String, held: Array<Token>) -> Bool {
  var open = false
  var i = 0
  while i < held.length() {
    match held.get(i) {
      Some(token) => {
        if token.kind == Kind.Space {
          if endsLine(source, token) {
            open = false
          }
        } else {
          if open && isAComment(token) {
            return true
          }
          open = true
        }
      }
      None => { }
    }
    i = i + 1
  }
  false
}
