/// What the tree promises.
/// The kinds of a file's items, as one line.
fn items(source: String) -> String {
  let tree = parse(source)
  var parts = Vector.of()
  var i = 0
  while i < tree.children.length() {
    match tree.children.get(i) {
      Some(child) => parts.push(nodeNamed(child.kind))
      None => { }
    }
    i = i + 1
  }
  " ".join(parts.toArray())
}

/// What a node kind is called, so a failure names what it saw.
fn nodeNamed(kind: Node) -> String {
  match kind {
    Node.File => "file"
    Node.Use => "use"
    Node.Fn => "fn"
    Node.Struct => "struct"
    Node.Enum => "enum"
    Node.Impl => "impl"
    Node.Trait => "trait"
    Node.TypeAlias => "type"
    Node.Name => "name"
    Node.Generics => "generics"
    Node.Params => "params"
    Node.Returns => "returns"
    Node.Body => "body"
    Node.Stmt => "stmt"
    Node.Group => "group"
    Node.Member => "member"
    Node.Trivia => "trivia"
    Node.Leaf => "leaf"
    Node.Error => "error"
  }
}

/// The kinds of one item's children.
fn parts(source: String) -> String {
  let tree = parse(source)
  var out = Vector.of()
  match tree.children.get(0) {
    Some(item) => {
      var i = 0
      while i < item.children.length() {
        match item.children.get(i) {
          Some(child) => {
            if child.kind != Node.Leaf {
              out.push(nodeNamed(child.kind))
            }
          }
          None => { }
        }
        i = i + 1
      }
    }
    None => { }
  }
  " ".join(out.toArray())
}

/// Whether the tree covers every token of `source`.
fn whole(source: String) -> Bool {
  let tree = parse(source)
  covers(tree, 0, tokens(source).length())
}

/// A file is a list of declarations, and the words in front of one belong to
/// it rather than standing alone.
///
/// The trailing `trivia` is the newline after the last declaration. It has to
/// live somewhere for the tree to be lossless, and an item of its own is
/// where: attaching it to the declaration before it would make a formatter
/// that moved that declaration move the file's last line with it.
test fn a_file_is_a_list_of_declarations() -> Result<Unit, Error> {
  let source = "\n".join([
    "use console.println",
    "",
    "export fn main() -> Int \{",
    "  1",
    "\}",
    "",
  ])
  assertEqual(items(source), "use fn trivia")?
  Ok(())
}

/// A function is taken apart into the header a formatter has to lay out.
test fn a_function_is_a_name_parameters_an_answer_and_a_body(
) -> Result<Unit, Error> {
  assertEqual(
    parts("fn twice(n: Int) -> Int \{ n * 2 \}"),
    "name params returns body",
  )?
  Ok(())
}

/// Generics are their own node, and the angle brackets are counted alone: a
/// `<` after a name is a bracket, and everywhere else it is a comparison.
test fn generics_are_their_own_node() -> Result<Unit, Error> {
  assertEqual(
    parts("fn first<T>(xs: Array<T>) -> Option<T> \{ xs.get(0) \}"),
    "name generics params returns body",
  )?
  Ok(())
}

/// A method a trait only declares has no body, and the answer ends at the
/// line rather than running into the next declaration.
test fn a_declaration_without_a_body_ends_at_its_line() -> Result<Unit, Error> {
  let source = "\n".join([
    "trait Show \{",
    "  fn show(self) -> String",
    "\}",
    "",
  ])
  assertEqual(items(source), "trait trivia")?
  assert(whole(source))?
  Ok(())
}

/// A `use` and a `type` end at a line, so the next declaration is a
/// declaration of its own.
test fn a_line_ended_declaration_does_not_swallow_the_next(
) -> Result<Unit, Error> {
  let source = "\n".join(["use console.println", "use clock", "export type Handler = fn(x: Int) -> Int", "struct S \{ n: Int \}", ""])
  assertEqual(items(source), "use use type struct trivia")?
  Ok(())
}

/// A brace that closes nothing ends the body rather than swallowing the rest
/// of the file: one typo should cost one declaration.
test fn an_unbalanced_brace_costs_one_declaration() -> Result<Unit, Error> {
  let source = "\n".join(["fn a() -> Int \{ 1 \}", "fn b() -> Int \{ 2 \}", ""])
  assertEqual(items(source), "fn fn trivia")?
  Ok(())
}

/// Text no rule claims becomes an `Error`, and the tree still covers it.
test fn text_no_rule_claims_is_still_in_the_tree() -> Result<Unit, Error> {
  let source = "\n".join(["%%% not a declaration", "fn a() -> Int \{ 1 \}", ""])
  assertEqual(items(source), "error fn trivia")?
  assert(whole(source))?
  Ok(())
}

/// The property the tree exists for: its children tile it, all the way down,
/// so a walk of it reaches every token — every comment and every blank line
/// included.
test fn the_tree_covers_every_token() -> Result<Unit, Error> {
  let source = "\n".join(["/// Doubles `n`.", "use console.println", "", "// a comment between declarations", "", "export struct Point \{", "  x: Int", "  y: Int", "\}", "", "impl Point \{", "  /// Moves it.", "  fn shift(self, by: Int) -> Point \{", "    Point(x: self.x + by, y: self.y)", "  \}", "\}", "", "export fn main() -> Result<Unit, Error> \{", "  console.println(\"hello\")?", "  Ok(())", "\}", ""])
  assert(whole(source))?
  Ok(())
}

/// Nothing parses to a file of nothing, and that covers nothing.
test fn an_empty_source_is_an_empty_file() -> Result<Unit, Error> {
  assertEqual(parse("").children.length(), 0)?
  assert(whole(""))?
  Ok(())
}

/// The strongest thing this front end can say: a walk of the tree reaches
/// every token, in order, whole — so the text comes back.
test fn printing_the_tree_gives_the_source_back() -> Result<Unit, Error> {
  let source = "\n".join(["/// Doubles `n`.", "use console.println", "", "// a comment between declarations", "", "export struct Point \{", "  x: Int", "  y: Int", "\}", "", "impl Point \{", "  /// Moves it.", "  fn shift(self, by: Int) -> Point \{", "    Point(x: self.x + by, y: self.y)", "  \}", "\}", "", "export async fn main() -> Result<Unit, Error> \{", "  console.println(\"an — dash\")?", "  Ok(())", "\}", ""])
  assert(roundTrips(source))?
  Ok(())
}

/// Including source that does not parse: what an `Error` node holds comes
/// back exactly as it went in, which is what a formatter must do with a file
/// somebody is in the middle of typing.
test fn printing_gives_back_source_that_does_not_parse(
) -> Result<Unit, Error> {
  assert(roundTrips("%%% not a declaration\nfn a() -> Int \{ 1 \}\n"))?
  assert(roundTrips("fn open(\n"))?
  assert(roundTrips(""))?
  Ok(())
}

/// The kinds of a body's children, so a body's shape reads as one line.
fn bodyShape(source: String) -> String {
  let tree = parse(source)
  var out = Vector.of<String>()
  for item in tree.children {
    for child in item.children {
      if child.kind == Node.Body {
        for part in child.children {
          out.push(nodeNamed(part.kind))
        }
      }
    }
  }
  " ".join(out.toArray())
}

/// **A body is statements, and a statement ends where the language says.**
///
/// `docs/LANGUAGE_REFERENCE.md` gives the rule in four parts and each line
/// below is one of them. They are asserted together because they interact:
/// the continuation rules are what stop the line rule from cutting an
/// expression in half, and a test of the line rule alone would pass on a
/// parser that had neither.
test fn a_body_is_statements() -> Result<Unit, Error> {
  // The plain rule: a statement ends at the end of its line.
  assertEqual(
    bodyShape("fn f() \{\n  let a = 1\n  let b = 2\n  a\n\}\n"),
    "leaf leaf stmt leaf stmt leaf stmt leaf leaf",
  )?
  // An operator at the end of a line carries the statement on, so the two
  // lines below are one statement and not two.
  assertEqual(
    bodyShape("fn f() \{\n  let a = 1 +\n    2\n  a\n\}\n"),
    "leaf leaf stmt leaf stmt leaf leaf",
  )?
  // A line beginning with `.` continues the chain above it.
  assertEqual(
    bodyShape("fn f() \{\n  let a = x\n    .y()\n  a\n\}\n"),
    "leaf leaf stmt leaf stmt leaf leaf",
  )?
  // A line break inside `(` or `[` ends nothing, which is what lets an
  // argument list span lines.
  assertEqual(
    bodyShape("fn f() \{\n  g(\n    1,\n    2,\n  )\n\}\n"),
    "leaf leaf stmt leaf leaf",
  )?
  Ok(())
}

/// A `{ ... }` inside a body is a body of its own, so an `if`'s block holds
/// statements rather than a run of leaves.
///
/// This is the half that makes the tree worth deepening: a formatter laying
/// out an `if` needs to know where its block's statements are, and a block
/// of leaves would make it find them again.
test fn a_nested_block_is_a_body() -> Result<Unit, Error> {
  assertEqual(
    bodyShape("fn f() \{\n  if a \{\n    b\n  \}\n  c\n\}\n"),
    "leaf leaf stmt leaf stmt leaf leaf",
  )?
  assert(roundTrips("fn f() \{\n  if a \{\n    b\n    c\n  \} else \{\n    d\n  \}\n  e\n\}\n"))?
  Ok(())
}

/// **The first layout decision: a line does not end on a blank.**
///
/// `cove_syntax::format` says *"no tabs, no trailing whitespace, one trailing
/// newline"*, and this is the half of that with no exceptions in it. It is
/// asserted on source that *has* trailing whitespace, because the corpus
/// check cannot see it: every file in this repository already passes
/// `cove fmt --check`, so a rule that correctly changes nothing there is
/// indistinguishable from a rule that does nothing at all.
test fn a_line_does_not_end_on_a_blank() -> Result<Unit, Error> {
  let held = tokens("fn f() \{   \n  1\n\}   \n")
  let tree = parseTokens("fn f() \{   \n  1\n\}   \n", held)
  assertEqual(
    print("fn f() \{   \n  1\n\}   \n", held, tree),
    "fn f() \{\n  1\n\}\n",
  )?
  // Space *within* a line is not trailing, and this rule leaves it alone:
  // how much of it there should be is a different decision that reads what
  // stands on either side.
  assert(roundTrips("fn f(a: Int,  b: Int) -> Int \{ a \}\n"))?
  // A blank line is blank, not indented.
  let blank = "fn f() \{\n  1\n   \n  2\n\}\n"
  let heldBlank = tokens(blank)
  assertEqual(
    print(blank, heldBlank, parseTokens(blank, heldBlank)),
    "fn f() \{\n  1\n\n  2\n\}\n",
  )?
  Ok(())
}

/// **Blank lines collapse to one.**
///
/// `cove_syntax::format` keeps blank lines in a `pending_blank: bool`, so
/// however many an author wrote between two things, one is what comes back.
/// Three newlines in a row are two blank lines and become one.
///
/// On its own test rather than only on the corpus, for the reason the
/// trailing-whitespace rule needed one: every file in this repository is
/// already `cove fmt`'s output, so it holds no run of blank lines for a
/// correct rule to collapse — and a rule that collapsed nothing would pass
/// there just as well.
test fn blank_lines_collapse_to_one() -> Result<Unit, Error> {
  let many = "fn a() \{ 1 \}\n\n\n\n\nfn b() \{ 2 \}\n"
  let held = tokens(many)
  assertEqual(
    print(many, held, parseTokens(many, held)),
    "fn a() \{ 1 \}\n\nfn b() \{ 2 \}\n",
  )?
  // One blank line is already one, and stays.
  assert(roundTrips("fn a() \{ 1 \}\n\nfn b() \{ 2 \}\n"))?
  // No blank line stays none: the rule is a ceiling, not a floor.
  assert(roundTrips("fn a() \{ 1 \}\nfn b() \{ 2 \}\n"))?
  // Inside a body too, and the indentation after the last newline is kept —
  // what the rule takes out is newlines, not the line they leave behind.
  let inside = "fn f() \{\n  1\n\n\n  2\n\}\n"
  let heldInside = tokens(inside)
  assertEqual(
    print(inside, heldInside, parseTokens(inside, heldInside)),
    "fn f() \{\n  1\n\n  2\n\}\n",
  )?
  Ok(())
}

/// A blank line at the top of a block is not kept.
///
/// `cove_syntax::format`'s `lead` takes an `allow_blank`, and it is `false`
/// for the first thing in a file and the first thing in a block: `i > 0` at
/// every call site that walks members. A blank there separates a thing from
/// the brace above it, which is nothing to separate it from.
test fn a_block_does_not_open_on_a_blank() -> Result<Unit, Error> {
  let source = "fn f() \{\n\n  1\n\}\n"
  let held = tokens(source)
  assertEqual(
    print(source, held, parseTokens(source, held)),
    "fn f() \{\n  1\n\}\n",
  )?
  Ok(())
}

/// A file does not open on a blank either, which is the same rule reaching
/// the other end of `allow_blank`.
///
/// It is the same question asked of "nothing has been written yet" rather
/// than of a brace, and `print` starts the walk at `-1` so that both are one
/// answer instead of two.
test fn a_file_does_not_open_on_a_blank() -> Result<Unit, Error> {
  let source = "\n\n\nfn f() \{ 1 \}\n"
  let held = tokens(source)
  assertEqual(
    print(source, held, parseTokens(source, held)),
    "fn f() \{ 1 \}\n",
  )?
  Ok(())
}

/// **A body indents what is inside it, two spaces a step.**
///
/// `cove_syntax::format`'s `INDENT` is 2, and a body's members are written at
/// `indent + INDENT` while its closing brace goes back to `indent`. Nesting
/// multiplies: a block inside a block is four.
///
/// On its own test rather than only on the corpus, for the reason the two
/// rules before it needed one: every file in this repository is already
/// `cove fmt`'s output, so it holds no misindented line for a correct rule to
/// straighten, and a rule that straightened nothing would pass there too.
test fn a_body_indents_what_is_inside_it() -> Result<Unit, Error> {
  let flat = "fn f() \{\nlet x = 1\nx\n\}\n"
  let held = tokens(flat)
  assertEqual(
    print(flat, held, parseTokens(flat, held)),
    "fn f() \{\n  let x = 1\n  x\n\}\n",
  )?
  // Nesting multiplies, and the closing braces walk back out.
  let nested = "fn f() \{\nif a \{\nb\n\}\nc\n\}\n"
  let heldNested = tokens(nested)
  assertEqual(
    print(nested, heldNested, parseTokens(nested, heldNested)),
    "fn f() \{\n  if a \{\n    b\n  \}\n  c\n\}\n",
  )?
  // Over-indentation is straightened too: the rule sets the depth rather
  // than adding to what was there.
  let deep = "fn f() \{\n        let x = 1\n\}\n"
  let heldDeep = tokens(deep)
  assertEqual(
    print(deep, heldDeep, parseTokens(deep, heldDeep)),
    "fn f() \{\n  let x = 1\n\}\n",
  )?
  Ok(())
}

/// What is still left exactly as it was found, and why that is a choice.
///
/// `(` and `[` are groups the tree can see into now, and their lines are
/// decided. `<` is not: a generic list is a run of leaves, because the lexer
/// cannot tell `<` the bracket from `<` the comparison without the parser's
/// help, and this slice has not given it that help.
///
/// A `use` is a run of leaves for a different reason — it is taken to the end
/// of a line and never taken apart — and `Node.Returns` for a third: it is
/// whatever stands between `->` and the body.
///
/// A `type` used to be on that list and no longer is: it takes its `(` as a
/// group like a statement does, so the second case below now *decides* and
/// the answer it gives is `cove fmt`'s — checked by running it.
///
/// Written down so that it is a boundary and not an oversight. What the tree
/// can decide it decides; the count against `cove fmt` goes up as the tree
/// gets deeper, never down.
test fn what_the_tree_cannot_see_is_left_alone() -> Result<Unit, Error> {
  assert(roundTrips("fn f<\n  T,\n  E,\n>(a: T) -> T \{\n  a\n\}\n"))?
  // `cove fmt` on the left-hand source answers the right-hand one.
  let broken = "export type H = fn(\n  a: Int\n) -> Int\n"
  let held = tokens(broken)
  assertEqual(
    print(broken, held, parseTokens(broken, held)),
    "export type H = fn(a: Int) -> Int\n",
  )?
  Ok(())
}

/// **A parameter list indents its members.**
///
/// The first group the tree can see into, and the first line inside a `(` it
/// can decide. `cove_syntax::format` writes a parameter at `indent + INDENT`
/// and the closing `)` back at `indent`; a `Node.Params` is now the members
/// between its brackets, so covefmt can say the same thing.
///
/// It and `an_argument_list_indents_its_members` are two cases of one rule,
/// kept apart because the nodes are: a formatter has rules for a
/// declaration's parameters that it does not have for a call's arguments,
/// and a test each is where those will go.
test fn a_parameter_list_indents_its_members() -> Result<Unit, Error> {
  // Long enough that it does not fold, so what is being asserted is the
  // indentation and not the width rule.
  let flat = "\n".join(["fn aRatherLongFunctionName(", "firstParameter: String,", "secondParameter: String,", ") -> Result<Unit, Error> \{", "  Ok(())", "\}", ""])
  let want = "\n".join(["fn aRatherLongFunctionName(", "  firstParameter: String,", "  secondParameter: String,", ") -> Result<Unit, Error> \{", "  Ok(())", "\}", ""])
  let held = tokens(flat)
  assertEqual(print(flat, held, parseTokens(flat, held)), want)?
  Ok(())
}

/// **An argument list indents its members too.**
///
/// The same node one level in: a `(` written inside a statement is a
/// `Node.Group`, its members are `Node.Member`, and the depth of a line
/// inside it is the depth of the group plus one. 79 of this repository's 246
/// files hold such a line and 2,080 lines are inside a group; before this
/// they were the lines covefmt left exactly as it found them.
test fn an_argument_list_indents_its_members() -> Result<Unit, Error> {
  // A comment keeps the group broken whatever its width — see
  // `a_body_never_folds` — so the indentation can be asserted without the
  // width rule answering first.
  let flat = "fn f() \{\n  g(\n// why\n1,\n2,\n)\n\}\n"
  let held = tokens(flat)
  assertEqual(
    print(flat, held, parseTokens(flat, held)),
    "fn f() \{\n  g(\n    // why\n    1,\n    2,\n  )\n\}\n",
  )?
  // Nesting multiplies here as it does for a body.
  let nested = "fn f() \{\n  g(\n// why\nh(\n1,\n),\n)\n\}\n"
  let heldNested = tokens(nested)
  assertEqual(
    print(nested, heldNested, parseTokens(nested, heldNested)),
    "fn f() \{\n  g(\n    // why\n    h(1),\n  )\n\}\n",
  )?
  Ok(())
}

/// **A group that fits goes back onto one line.**
///
/// `cove_syntax::format` writes the flat form of a call when nothing in its
/// arguments breaks and the flat form fits, and this is that read off the
/// tokens: their widths are the flat width, because the tokens *are* the
/// text. No tree walk builds a string to measure.
///
/// The trailing comma goes with the line breaks. A group written across
/// lines ends every member with one, the last included, because each is on a
/// line of its own; flattened there is no last line to end.
test fn a_group_that_fits_goes_back_on_one_line() -> Result<Unit, Error> {
  let broken = "fn f() \{\n  g(\n    1,\n    2,\n  )\n\}\n"
  let held = tokens(broken)
  assertEqual(
    print(broken, held, parseTokens(broken, held)),
    "fn f() \{\n  g(1, 2)\n\}\n",
  )?
  // A generic list folds too, which is the `<` case `cove fmt` settles by
  // width rather than by structure.
  let params = "fn f(\n  a: Int,\n  b: Int,\n) -> Int \{\n  a\n\}\n"
  let heldParams = tokens(params)
  assertEqual(
    print(params, heldParams, parseTokens(params, heldParams)),
    "fn f(a: Int, b: Int) -> Int \{\n  a\n\}\n",
  )?
  Ok(())
}

/// **What does not fit stays broken, and the rest of the line counts.**
///
/// A parameter list that fits on its own can still be one that does not fit:
/// the `-> Result<T, F> \{` behind it is on the same line as the `)` that
/// closes it. `cove_syntax::format` passes that in as `reserved`, and
/// leaving it out is how 17 files folded a line past 80 columns while this
/// was being written.
test fn what_does_not_fit_stays_broken() -> Result<Unit, Error> {
  // 84 columns flattened, so it stays as it was written.
  let long = "\n".join(["fn aRatherLongFunctionName(", "  firstParameter: String,", "  secondParameter: String,", ") -> Result<Unit, Error> \{", "  Ok(())", "\}", ""])
  assert(roundTrips(long))?
  Ok(())
}

/// **A body never folds, however short it is.**
///
/// `cove_syntax::format`'s `breaks` calls itself a layout policy and not a
/// limit: *"a declaration body, a control flow body, and a lambda body
/// always read better broken"*. A lambda written as an argument is the case
/// that catches a formatter out — `items.filter(fn(item) \{\n  item > 0\n\})`
/// is short enough to fit and does not fold.
test fn a_body_never_folds() -> Result<Unit, Error> {
  assert(roundTrips("fn f() \{\n  items.filter(fn(item) \{\n    item > 0\n  \}).length()\n\}\n"))?
  assert(roundTrips("fn f() \{\n  if a \{\n    b\n  \}\n\}\n"))?
  // A comment can only stay where it was written if the group breaks.
  assert(roundTrips("fn f() \{\n  g(\n    // why\n    1,\n  )\n\}\n"))?
  Ok(())
}

/// **A group that does not fit is written one member to a line.**
///
/// The other direction of the fold, and the same question answered the other
/// way. `cove_syntax::format` writes the broken form once its flat form is
/// refused: the opening bracket ends its line, every member is a line of its
/// own one step further in and ends with a comma — the last one included —
/// and the closing bracket is a line at the depth the group opened at.
test fn a_group_that_does_not_fit_is_broken() -> Result<Unit, Error> {
  let long = "\n".join(["fn f() -> Int \{", "  someFunction(aLongArgument, anotherLongArgument, aThirdOne, andYetMoreHereTools)", "\}", ""])
  let want = "\n".join(["fn f() -> Int \{", "  someFunction(", "    aLongArgument,", "    anotherLongArgument,", "    aThirdOne,", "    andYetMoreHereTools,", "  )", "\}", ""])
  let held = tokens(long)
  assertEqual(print(long, held, parseTokens(long, held)), want)?
  Ok(())
}

/// **A break that buys nothing is not made, and the decision propagates.**
///
/// `cove_syntax::format` is greedy from the outside in: every one of its ten
/// width tests writes the flat form and returns, so a group written flat
/// carries the groups inside it out as part of that string and they are
/// never asked anything.
///
/// `Ok(Check(name: …, url: …, …))` is the case that shows why it matters. It
/// is 150 columns and `cove fmt` leaves it alone — breaking the `Ok` would
/// leave the `Check` just as long one step further in — and descending into
/// it anyway is how covefmt came to write `Ok(Check(`, a line `cove fmt`
/// never writes.
///
/// Greedy is also optimal here, which is why no search is wanted: a group is
/// flat or wholly broken with nothing in between, and breaking an outer
/// group only ever gives an inner one more room. There is no choice upstream
/// that a later line can regret.
test fn a_break_that_buys_nothing_is_not_made() -> Result<Unit, Error> {
  let held = "\n".join(["fn f(entry: Int) -> Int \{", "  Ok(Check(name: aaaaaaaaaaaaaaaa, url: bbbbbbbbbbbbbbbbbb, expect: cccccccccccccccc))", "\}", ""])
  assert(roundTrips(held))?
  Ok(())
}

/// **A trailing closure of one statement keeps its line; a lambda does not.**
///
/// `cove_syntax::format`'s `trailing_breaks`: *"A trailing closure stays on
/// one line when its body is a single expression that fits, so
/// `tasks.spawn \{ fetch() \}` reads as the one call it is."* A lambda body
/// always breaks, and the `(item)` in front of the brace is what tells the
/// two apart.
test fn a_trailing_closure_of_one_statement_keeps_its_line(
) -> Result<Unit, Error> {
  assert(roundTrips("fn f() \{\n  running.push(inflight.spawn \{ await run(check) \})\n\}\n"))?
  assert(roundTrips("fn f() \{\n  items.filter(fn(item) \{\n    item > 0\n  \})\n\}\n"))?
  Ok(())
}

/// **A call whose last argument can expand keeps its head on one line.**
///
/// `cove_syntax::format`'s `hug_last`: *"A final closure, call, or array
/// argument keeps the call's head on one line and expands below it, which is
/// how a callback and a struct initializer read at the call site."*
///
/// So a call past the limit is not always broken one argument to a line. The
/// case below is 82 columns and `cove fmt` leaves it exactly as written —
/// checked by running it rather than by reading this implementation, which
/// is the rule `a_file_does_not_open_on_a_blank` was nearly got wrong by.
///
/// `hug_head` names the three shapes that can be hugged and each is one this
/// tree has: a lambda is a `Node.Body` with a `)` in front of it, and a call
/// or a non-empty array is a `Node.Group` with members.
test fn a_call_hugs_a_last_argument_that_expands() -> Result<Unit, Error> {
  let hugged = "\n".join(["fn f(tasks: Int) -> Int \{", "  spawnSomething(firstArgument, fn(value: Int) -> Int \{ value * 2 + someMoreHere \})", "\}", ""])
  assert(roundTrips(hugged))?
  // Without a huggable last argument the same width does break.
  let plain = "\n".join(["fn f() -> Int \{", "  someFunction(aLongArgument, anotherLongArgument, aThirdOne, andYetMoreHereTools)", "\}", ""])
  let held = tokens(plain)
  assert(print(plain, held, parseTokens(plain, held)) != plain)?
  Ok(())
}
