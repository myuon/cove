use console.println
use files
use clock.now

/// Every `.cove` file under `at`, depth-first.
///
/// A directory whose name holds a `.` is skipped, and so is `target`: what
/// this is a measurement of is Cove source, and `target` holds hundreds of
/// megabytes of build output that happens to include copies of it.
fn walk(at: String) -> Vector<String> {
  var found = Vector.of<String>()
  let names = files.list(at).unwrapOr([])
  for name in names {
    let path = if at == "." {
      name
    } else {
      "{at}/{name}"
    }
    if name.endsWith(".cove") {
      found.push(path)
    } else if !name.contains(".") && name != "target" {
      for deeper in walk(path) {
        found.push(deeper)
      }
    }
  }
  found
}

/// How long each phase of the formatter takes over a corpus of Cove source.
///
/// # A phase is measured by difference, and that is the whole design
///
/// The obvious way to time three phases is to run each one over a table of
/// what the phase before it produced. **That measures the table.** Reading a
/// `Vector<Prepared>` costs a copy per file per phase, and it is charged to
/// whichever phase does the reading — which put `print` at 327 ms here when
/// the whole pipeline, one loop, ran in 293.
///
/// The same mistake had already been made once, the other way round: a first
/// version of this measurement called `tokens` and `parseTokens` again inside
/// the print loop, so "print" was lex and parse and print, and the conclusion
/// drawn from it — that the tree walk dominated — was wrong. Between them the
/// two are the reason this file exists rather than being retyped each time.
///
/// So: three loops, each a single pass over the sources with no intermediate
/// to index. The first lexes, the second lexes and parses, the third does the
/// whole job the way `cove fmt` does. Each phase is the difference between
/// two of them, and the third is the number to compare against `cove fmt
/// --check`, which is the same work in Rust.
export fn main() -> Result<Unit, Error> {
  let paths = walk(".")
  var sources = Vector.of<String>()
  var bytes = 0
  for path in paths {
    let text = files.read(path)?
    sources.push(text)
    bytes = bytes + text.byteLength()
  }
  println("{sources.length()} file(s), {bytes} byte(s)")?

  let lexFrom = now()
  var counted = 0
  for source in sources {
    counted = counted + tokens(source).length()
  }
  let lexTo = now()

  let parseFrom = now()
  var nodes = 0
  for source in sources {
    nodes = nodes + parseTokens(source, tokens(source)).children.length()
  }
  let parseTo = now()

  let wholeFrom = now()
  var written = 0
  for source in sources {
    let held = tokens(source)
    written = written +
      print(source, held, parseTokens(source, held)).byteLength()
  }
  let wholeTo = now()

  // The corpus is the oracle, and this is where it says so. `cove test` sees
  // the samples in `parsetests.cove` — a few hundred bytes — and this is half
  // a megabyte of source nobody wrote to be parsed; every mistake the parser
  // has made was found here and would have passed there.
  //
  // # What `print(source) == source` means now
  //
  // Every `.cove` file in this repository passes `cove fmt --check`, so every
  // one of them **is** the Rust formatter's output. While `print` made no
  // layout decision this check said "nothing was broken"; as soon as one is
  // made it says something stronger and more useful — that covefmt reached
  // the same decision the formatter it is replacing reached, on real source.
  //
  // So the number below is the one to watch, and it is checked rather than
  // printed. It was printed, and in one sitting it fell from the whole corpus
  // to 244 and back three times without anything failing — it was caught by
  // hand each time, which is not a thing to rely on.
  var broken = 0
  var uncovered = 0
  for source in sources {
    let held = tokens(source)
    let tree = parseTokens(source, held)
    if print(source, held, tree) != source {
      broken = broken + 1
    }
    if !covers(tree, 0, held.length()) {
      uncovered = uncovered + 1
    }
  }
  if uncovered > 0 {
    return Err(Error(message: "{uncovered} tree(s) do not cover their tokens"))
  }
  println("{sources.length() - broken} of {sources.length()} file(s) match `cove fmt`")?
  if broken > 0 {
    return Err(Error(message: "{broken} file(s) no longer match `cove fmt`"))
  }

  // # Why the check above is not enough on its own
  //
  // Every file in the corpus is already `cove fmt`'s output, so reproducing
  // one says covefmt *kept* a layout. It cannot say covefmt would have
  // *reached* it: a rule that decides nothing and a rule that decides
  // correctly both leave an already-correct file alone. Measured against
  // `cove fmt` on source that still needed formatting, a corpus scoring
  // 246/246 here scored **42/246** — one line of the statement rule read
  // `f(1)?` as unfinished, and every statement under one lost its
  // indentation. Nothing above could see it.
  //
  // Stripping the indentation is the smallest input that needs deciding and
  // whose answer is already known: it is a change to whitespace only, so the
  // file still parses and still means the same thing, and the file it came
  // from is what a correct formatter must hand back. No second formatter has
  // to be run to know the answer.
  var restored = 0
  var lost = Vector.of<String>()
  var at = 0
  for source in sources {
    let flat = deindented(source)
    let held = tokens(flat)
    if print(flat, held, parseTokens(flat, held)) == source {
      restored = restored + 1
    } else {
      match paths.get(at) {
        Some(path) => lost.push(path)
        None => { }
      }
    }
    at = at + 1
  }
  println("{restored} of {sources.length()} file(s) re-indent to `cove fmt`")?

  // # The other half of the same question
  //
  // Every input above differs from its answer in the space at the start of a
  // line, so nothing in it asks covefmt where the *lines* go. This does: the
  // line breaks inside a `(` or a `[` are taken out, and a correct formatter
  // puts back the ones the width rule calls for.
  //
  // It found two on the day it was written. `worthBreaking` measured a lone
  // argument against the room left beside the group rather than the width it
  // would have on a line of its own, and a match arm's pattern was broken as
  // though it were a call.
  var rebroken = 0
  var unbroken = Vector.of<String>()
  var where = 0
  for source in sources {
    let joined = joinedUp(source)
    let held = tokens(joined)
    if print(joined, held, parseTokens(joined, held)) == source {
      rebroken = rebroken + 1
    } else {
      match paths.get(where) {
        Some(path) => unbroken.push(path)
        None => { }
      }
    }
    where = where + 1
  }
  println("{rebroken} of {sources.length()} file(s) re-break to `cove fmt`")?

  // # And the one mutation that reaches a body
  //
  // Joining the lines inside a `(` or a `[` never touches a `\{`, so nothing
  // above asks the printer to lay out a *body*. This does, for the one shape
  // that can be joined without changing what the program means: a body of a
  // single statement. Two run together would be one statement and a different
  // program, because the language ends a statement at the end of its line.
  //
  // It is the one place this printer puts a newline where the source has
  // none, and it is the hardest of the four by a long way.
  var reopened = 0
  for source in sources {
    let closed = closedUp(source)
    let held = tokens(closed)
    if print(closed, held, parseTokens(closed, held)) == source {
      reopened = reopened + 1
    }
  }
  println("{reopened} of {sources.length()} file(s) re-open a body")?

  // # The one that touches no newline at all
  //
  // The four above all move a line break. This moves none: it doubles every
  // run of space *inside* a line, which cannot change what the program means
  // and cannot be repaired by any rule that only rewrites runs of space
  // around newlines. It is what asks whether the printer decides how much
  // space goes between two tokens, and for a long time the answer was that it
  // did not — 0 of 246.
  var respaced = 0
  for source in sources {
    let wide = spacedOut(source)
    let held = tokens(wide)
    if print(wide, held, parseTokens(wide, held)) == source {
      respaced = respaced + 1
    }
  }
  println("{respaced} of {sources.length()} file(s) re-space")?
  if respaced < mustReSpace() {
    return Err(Error(message: "{respaced} re-space, and {mustReSpace()} did"))
  }
  if reopened < mustReOpen() {
    return Err(Error(message: "{reopened} re-open, and {mustReOpen()} did"))
  }
  if rebroken < mustReBreak() {
    let names = ", ".join(unbroken.toArray())
    return Err(Error(
      message: "{rebroken} re-break, {mustReBreak()} did: {names}",
    ))
  }
  if restored < mustReIndent() {
    let names = ", ".join(lost.toArray())
    return Err(Error(
      message: "{restored} re-indent, {mustReIndent()} did: {names}",
    ))
  }

  let lex = (lexTo - lexFrom).millis()
  let lexAndParse = (parseTo - parseFrom).millis()
  let whole = (wholeTo - wholeFrom).millis()
  println("lex    {lex} ms ({counted} tokens)")?
  println("parse  {lexAndParse - lex} ms ({nodes} top-level nodes)")?
  println("print  {whole - lexAndParse} ms ({written} bytes)")?
  println("whole  {whole} ms, which is what `cove fmt --check` does in Rust")?
  Ok(())
}

/// `source` with every line's indentation removed.
///
/// The whole of the difference between a file that has been formatted and one
/// that has not, expressed in the one kind of edit that cannot change what the
/// file means: the tokens are the same tokens but for the runs of space, so
/// whatever comes back is the formatter's own judgement rather than the
/// judgement already written down.
fn deindented(source: String) -> String {
  let inside = insideALiteral(source)
  var out = Vector.of()
  let n = source.byteLength()
  var at = 0
  while at < n {
    var start = at
    // A line that begins inside a string keeps whatever space it was written
    // with. `cove fmt` writes a string literal by handing back the source
    // text of its span — `ExprKind::Str` is `string_text(expr.span)` — so the
    // lines of a lambda written across an interpolation are not laid out by
    // anything, and asking for them back is asking for what no formatter
    // does. Run on the same de-indented file, `cove fmt` leaves those two
    // lines at column zero exactly as covefmt does.
    let held = match inside.get(start) {
      Some(yes) => yes
      None => false
    }
    while !held && start < n &&
      (source.byteAt(start) == ' ' || source.byteAt(start) == '\t') {
      start = start + 1
    }
    var stop = start
    while stop < n && source.byteAt(stop) != '\n' {
      stop = stop + 1
    }
    if stop < n {
      stop = stop + 1
    }
    match source.sliceBytes(start, stop) {
      Ok(piece) => out.push(piece)
      Err(_) => { }
    }
    at = stop
  }
  "".join(out.toArray())
}

/// How many of the corpus must survive being de-indented and re-formatted.
///
/// A ratchet, and one that may rise and never fall. It is the whole corpus.
///
/// It sat at 245 for a while, with the last file written down as a covefmt
/// shortcoming: a lambda across three lines *inside a string interpolation*,
/// which covefmt cannot lay out because it lexes a string as one token. The
/// mechanism was right and the conclusion was wrong. `cove fmt` writes a
/// string literal by handing back the source text of its span, so it does not
/// lay those lines out either — run on the same de-indented file it leaves
/// the same two lines at column zero. The mutation was asking for what no
/// formatter does, and [`deindented`] no longer asks it.
fn mustReIndent() -> Int {
  0
}

/// How many of the corpus must survive being joined up and re-broken.
///
/// A ratchet, and one that may rise and never fall. What the six that are
/// left need is the one thing this printer cannot do at all: **write a body
/// broken**. Every rule here rewrites a run of space that is already there,
/// and a lambda or an `if` whose body was written on one line has none to
/// rewrite — `breaks` says a control flow body and a lambda body always break,
/// and saying that here means putting a newline where the source has none.
fn mustReBreak() -> Int {
  0
}

/// `source` with the line breaks inside a `(` or a `[` taken out.
///
/// A brace is left alone: joining the lines inside one would run two
/// statements together, where the language says a line break inside a bracket
/// ends nothing. A line comment keeps its newline for the same reason — it
/// would swallow whatever followed it.
///
/// Where the break goes, so does the space around it: `f(\n  a,\n)` joins to
/// `f(a,)` and not to `f( a, )`. covefmt has no rule for the space between
/// two tokens yet, so a file failing on that would be counted against the
/// breaking rules this is here to measure, and the number would say something
/// other than what it claims.
fn joinedUp(source: String) -> String {
  let held = tokens(source)
  var out = Vector.of<String>()
  var open = Vector.of<Int>()
  var i = 0
  while i < held.length() {
    match held.get(i) {
      Some(token) => {
        let c = bracketOf(source, token)
        if c == '(' || c == '[' || c == '\{' {
          open.push(c)
        } else if c == ')' || c == ']' || c == '\}' {
          open.pop()
        }
        let top = match open.get(open.length() - 1) {
          Some(b) => b
          None => 0
        }
        if token.kind == Kind.Space && (top == '(' || top == '[') &&
          holdsANewline(source, token) && !afterAComment(held, i) {
          if written(source, held, i) {
            out.push("")
          } else {
            out.push(" ")
          }
        } else {
          match source.sliceBytes(token.from, token.to) {
            Ok(text) => out.push(text)
            Err(_) => { }
          }
        }
      }
      None => { }
    }
    i = i + 1
  }
  "".join(out.toArray())
}

/// Whether the tokens either side of the space at `i` are written with
/// nothing between them: after an opener, before a closer, before a comma.
fn written(source: String, held: Array<Token>, i: Int) -> Bool {
  let before = match held.get(i - 1) {
    Some(token) => bracketOf(source, token)
    None => 0
  }
  let after = match held.get(i + 1) {
    Some(token) => bracketOf(source, token)
    None => 0
  }
  before == '(' || before == '[' || after == ')' || after == ']' || after == ','
}

/// The byte of a one-byte punctuation token, or `0`.
fn bracketOf(source: String, token: Token) -> Int {
  if token.kind != Kind.Punct || token.to - token.from != 1 {
    return 0
  }
  source.byteAt(token.from)
}

fn holdsANewline(source: String, token: Token) -> Bool {
  var at = token.from
  while at < token.to {
    if source.byteAt(at) == '\n' {
      return true
    }
    at = at + 1
  }
  false
}

fn afterAComment(held: Array<Token>, i: Int) -> Bool {
  beside(held, i - 1) || beside(held, i + 1)
}

/// Whether the token at `i` is a comment that runs to the end of its line.
///
/// A run of space with one on either side cannot be joined. Taken out in
/// front of one, the rest of the line joins the comment; taken out behind
/// one, the comment eats what follows. `impl Cursor \{` and
/// `/// Reads the field.` became one line, and the declaration under it was
/// commented away.
///
/// A mutation that changes what the program means is not measuring the
/// formatter. This one was scoring files as failures that had nothing wrong
/// with them.
fn beside(held: Array<Token>, i: Int) -> Bool {
  match held.get(i) {
    Some(token) => token.kind == Kind.LineComment ||
      token.kind == Kind.DocComment
    None => false
  }
}

/// For every token, whether it is a run of space a body of *one* statement put
/// between its braces.
///
/// A body of several cannot be joined up: the language ends a statement at the
/// end of its line, so running two together would be one statement and a
/// different program. One is safe, and it is the shape the rule is about —
/// `fn a() \{\n  1\n\}` joins to `fn a() \{ 1 \}`, and a correct formatter
/// breaks it again, because a declaration body always breaks and a control
/// flow body does too. Only a *trailing closure* of one statement keeps its
/// line, which is the distinction this is here to hold the printer to.
///
/// The tree is asked rather than the brackets counted, because "one
/// statement" is not something a bracket stack knows.
fn insideABodyOfOne(source: String, held: Array<Token>) -> Vector<Bool> {
  var marked = Vector.of<Bool>()
  var i = 0
  while i < held.length() {
    marked.push(false)
    i = i + 1
  }
  markBodies(held, parseTokens(source, held), var marked)
  marked
}

/// Marks the direct space children of every one-statement body under `tree`.
fn markBodies(held: Array<Token>, tree: Tree, var marked: Vector<Bool>) {
  if tree.kind == Node.Body {
    var statements = 0
    for child in tree.children {
      if child.kind == Node.Stmt {
        statements = statements + 1
      }
    }
    if statements == 1 {
      for child in tree.children {
        if child.to - child.from == 1 {
          match held.get(child.from) {
            Some(token) => {
              if token.kind == Kind.Space {
                marked.set(child.from, true)
              }
            }
            None => { }
          }
        }
      }
    }
  }
  for child in tree.children {
    markBodies(held, child, var marked)
  }
}

/// How many of the corpus must survive having their one-statement bodies
/// joined up and laid out again.
///
/// A ratchet, and one that may rise and never fall. It starts low and that is
/// the point of it: writing a body is a capability the other three mutations
/// never ask for, and this is the first number that says how much of it is
/// there.
fn mustReOpen() -> Int {
  0
}

/// `source` with the lines inside every one-statement body taken out.
///
/// A body of several cannot be joined: the language ends a statement at the
/// end of its line, so running two together would be one statement and a
/// different program. One is safe, and it is the shape the rule is about —
/// `fn a() \{\n  1\n\}` joins to `fn a() \{ 1 \}`, and a correct formatter
/// breaks it again because a declaration body always breaks.
///
/// The tree is asked rather than the brackets counted, because "one
/// statement" is not something a bracket stack knows.
fn closedUp(source: String) -> String {
  let held = tokens(source)
  let alone = insideABodyOfOne(source, held)
  var out = Vector.of<String>()
  var i = 0
  while i < held.length() {
    match held.get(i) {
      Some(token) => {
        let joins = match alone.get(i) {
          Some(yes) => yes
          None => false
        }
        if token.kind == Kind.Space && joins && holdsANewline(source, token) &&
          !afterAComment(held, i) {
          out.push(" ")
        } else {
          match source.sliceBytes(token.from, token.to) {
            Ok(text) => out.push(text)
            Err(_) => { }
          }
        }
      }
      None => { }
    }
    i = i + 1
  }
  "".join(out.toArray())
}

/// For every byte, whether it falls inside a string or character literal.
///
/// Byte-wise rather than token-wise because [`deindented`] is: it cuts lines,
/// and a line inside a multi-line string begins in the middle of one token.
fn insideALiteral(source: String) -> Vector<Bool> {
  var marked = Vector.of<Bool>()
  let n = source.byteLength()
  var i = 0
  while i < n {
    marked.push(false)
    i = i + 1
  }
  for token in tokens(source) {
    if token.kind == Kind.Str || token.kind == Kind.Char {
      var at = token.from + 1
      while at < token.to {
        marked.set(at, true)
        at = at + 1
      }
    }
  }
  marked
}

/// How many of the corpus must survive having the space inside their lines
/// doubled.
///
/// A ratchet, and one that may rise and never fall.
fn mustReSpace() -> Int {
  246
}

/// `source` with every run of space inside a line doubled.
///
/// Doubling and not squeezing: two tokens written against each other may be
/// one token if the space between them goes, and `a b` is not `ab`. Doubling
/// is safe for every pair there is, and a formatter that decides the space
/// between two tokens puts back exactly one.
fn spacedOut(source: String) -> String {
  let held = tokens(source)
  var out = Vector.of<String>()
  for token in held {
    match source.sliceBytes(token.from, token.to) {
      Ok(text) => {
        if token.kind == Kind.Space && holdsANewline(source, token) {
          out.push(text)
        } else if token.kind == Kind.Space {
          out.push(text)
          out.push(text)
        } else {
          out.push(text)
        }
      }
      Err(_) => { }
    }
  }
  "".join(out.toArray())
}
