/// A source and how far into it a rule has read.
///
/// Cove source is UTF-8 *text*, so a lexer needs bytes and code points and not
/// a byte array: `codePointAtByte` answers the scalar at an offset and
/// `sliceBytes` cuts a run back out, both of them `String`'s own. A `Bytes`
/// type would buy this nothing — a formatter never sees a byte that is not
/// part of a character.
struct Scan {
  source: String
  size: Int
}

// The bytes below are written as code-point literals, which are `Int`s
// (ADR 0047), so a rule reads as the character it is about. They are inline
// rather than named: Cove has no module-level constant, and a zero-argument
// function per byte would be a call per byte in the hottest loop there is.

/// Whether `c` can begin a word: a letter or an underscore.
fn startsWord(c: Int) -> Bool {
  c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

/// Whether `c` can continue one: that, or a digit.
fn continuesWord(c: Int) -> Bool {
  startsWord(c) || isDigit(c)
}

/// Whether `c` is a decimal digit.
fn isDigit(c: Int) -> Bool {
  c >= '0' && c <= '9'
}

/// How many bytes the character `c` takes in UTF-8.
///
/// A rule that consumes *anything* until a terminator — a comment, a string —
/// has to step by this rather than by one. `codePointAtByte` answers `None`
/// at an offset that is not a character boundary, and [`Scan::at`] reports
/// that as `-1`, so a scanner stepping one byte at a time ended its token in
/// the middle of the first character that was not ASCII. It happened on a
/// `—` inside a comment and the whole repository has them.
///
/// The width is computed from the scalar rather than found by probing,
/// because probing is a second `codePointAtByte` per character and this is
/// arithmetic on a number already read.
fn utf8Width(c: Int) -> Int {
  if c < 128 {
    return 1
  }
  if c < 2048 {
    return 2
  }
  if c < 65536 {
    return 3
  }
  4
}

/// Whether `c` is space, tab, carriage return or newline.
fn isSpace(c: Int) -> Bool {
  c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

impl Scan {
  /// The code point at `at`, or `-1` past the end.
  ///
  /// One number for "there is nothing here" rather than an `Option`, because
  /// every caller asks the same question of it and `-1` fails every class test
  /// above without a `match` at each one. It is also the hottest call in the
  /// lexer: `Option::unwrapOr` is `std.option.unwrapOr`, a Cove call with a
  /// frame of its own, and measured at 23% of this loop.
  fn at(self, at: Int) -> Int {
    if at >= self.size {
      return -1
    }
    match self.source.codePointAtByte(at) {
      Some(c) => c
      None => -1
    }
  }

  /// The end of the run of spaces beginning at `from`.
  fn space(self, from: Int) -> Int {
    var at = from
    while isSpace(self.at(at)) {
      at = at + 1
    }
    at
  }

  /// The end of the word beginning at `from`.
  fn word(self, from: Int) -> Int {
    var at = from
    while continuesWord(self.at(at)) {
      at = at + 1
    }
    at
  }

  /// The end of the number beginning at `from`.
  ///
  /// A digit run, an optional fraction, and an optional suffix, so that
  /// `500ms` is one token and `1.5` is one. What a number *means* — which
  /// suffixes name a `Duration`, whether the fraction makes it a `Float` — is
  /// the parser's, and a lexer that decided it would be deciding it twice.
  fn number(self, from: Int) -> Int {
    var at = from
    while isDigit(self.at(at)) {
      at = at + 1
    }
    if self.at(at) == '.' && isDigit(self.at(at + 1)) {
      at = at + 1
      while isDigit(self.at(at)) {
        at = at + 1
      }
    }
    while startsWord(self.at(at)) {
      at = at + 1
    }
    at
  }

  /// The end of the interpolation beginning at the `{` at `from`.
  ///
  /// Braces nest and a literal inside one is a literal: a `"` opens a string
  /// whose own braces are its business, and a `'` opens a code point whose
  /// braces are characters. Ending at the first `}` would end
  /// `"\{ if c == '\}' \{ 1 \} else \{ 2 \} \}"` at the code point.
  fn interpolation(self, from: Int) -> Int {
    var at = from + 1
    var depth = 1
    while depth > 0 {
      let c = self.at(at)
      if c < 0 {
        return at
      }
      if c == '"' || c == '\'' {
        at = self.quoted(at, c)
      } else if c == '\{' {
        depth = depth + 1
        at = at + 1
      } else if c == '\}' {
        depth = depth - 1
        at = at + 1
      } else {
        at = at + utf8Width(c)
      }
    }
    at
  }

  /// The end of the `//` comment beginning at `from`, the newline excluded:
  /// the newline is space, and space is a token of its own.
  fn line(self, from: Int) -> Int {
    var at = from
    while true {
      let c = self.at(at)
      if c < 0 || c == '\n' {
        return at
      }
      at = at + utf8Width(c)
    }
    at
  }

  /// The end of the `/* ... */` beginning at `from`, nesting included.
  ///
  /// An unterminated one ends at the end of the file rather than failing.
  /// Every rule here answers a range, because the tiling has to hold for a
  /// file that does not lex — which is every file, while it is being typed.
  fn block(self, from: Int) -> Int {
    var at = from + 2
    var depth = 1
    while depth > 0 {
      let c = self.at(at)
      if c < 0 {
        return at
      }
      if c == '/' && self.at(at + 1) == '*' {
        depth = depth + 1
        at = at + 2
      } else if c == '*' && self.at(at + 1) == '/' {
        depth = depth - 1
        at = at + 2
      } else {
        at = at + utf8Width(c)
      }
    }
    at
  }

  /// The end of the literal beginning at `from` and ending at `closer`.
  ///
  /// One rule for `"..."` and `'...'`, because they differ only in which
  /// character ends them: a backslash escapes the next byte in both, so
  /// neither `\"` nor `\'` closes anything. An unterminated one runs to the
  /// end of the file, for `block`'s reason.
  ///
  /// A `{` inside a `"` opens an interpolation, and what is in one is Cove —
  /// including more strings. `"\"\{field.replace("\"", "\"\"")\}\""` is one
  /// literal, and a rule that ended at the first unescaped quote ended it in
  /// the middle. `\{` is not an interpolation; the escape above it takes that
  /// case before this one sees it.
  fn quoted(self, from: Int, closer: Int) -> Int {
    var at = from + 1
    while true {
      let c = self.at(at)
      if c < 0 {
        return at
      }
      if c == '\\' {
        // The escaped character may be wider than the backslash.
        at = at + 1 + utf8Width(self.at(at + 1))
      } else if c == '\{' && closer == '"' {
        at = self.interpolation(at)
      } else if c == closer {
        return at + 1
      } else {
        at = at + utf8Width(c)
      }
    }
    at
  }
}
