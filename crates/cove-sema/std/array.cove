/// Whether this array holds nothing.
///
/// This is here to be here: `isEmpty` used to be a Rust arm in each
/// evaluator, both of them computing `length() == 0` and neither saying so
/// in as many words. It is the first builtin method moved into the standard
/// library, in Cove, checked and lowered like any call a program writes —
/// proof that a builtin's body need not be Rust at all.
export fn isEmpty<T>(items: Array<T>) -> Bool {
  items.length() == 0
}

/// Whether any element is `==` to `element`.
///
/// `==` is the language's value equality, so an element equal to `element` is
/// found whether or not it is the one that was put there: a string by its
/// bytes, a struct field by field, an array element by element, and a `Float`
/// by IEEE-754, so a `NaN` is never found. An empty array holds nothing.
///
/// A loop over the elements and nothing else. It was a Rust walk in each
/// evaluator, and ADR 0058 (#378) moved it here: what an `Int` or a `String`
/// element costs is now one comparison instruction, and what a wider element
/// costs is the machine's value equality once per element rather than once
/// per search — `benches/seqsearch` is where both are measured.
export fn contains<T>(items: Array<T>, element: T) -> Bool {
  for item in items {
    if item == element {
      return true
    }
  }
  false
}

/// The position of the **first** element `==` to `element`, or `None`.
///
/// The same equality [`contains`] asks, so the two cannot disagree about
/// whether an element is there. `None` answers both a value that is not there
/// and an empty array, which is `get`'s answer to a position that is not there.
///
/// The `None` is a `return` rather than the body's last expression, as
/// `std.string.sliceBytes`' answer is and for its reason: an answer in tail
/// position is built aside and copied into the location the call answers in,
/// which was a copy per instantiation that the `return` does not make.
export fn indexOf<T>(items: Array<T>, element: T) -> Option<Int> {
  var at = 0
  for item in items {
    if item == element {
      return Some(at)
    }
    at += 1
  }
  return None
}

/// The elements at indices `from` up to but not including `to`, as a new
/// array.
///
/// Both bounds are clamped into `0..length()`, and a `to` at or below `from`
/// answers an empty array, so no argument stops the program: a negative bound,
/// a bound past the end and a reversed pair are each answered. That decision
/// is this body's; the copy beneath it is a core intrinsic, ADR 0058's run
/// slice, which is handed a range already inside the array.
export fn slice<T>(items: Array<T>, from: Int, to: Int) -> Array<T> {
  let length = items.length()
  let start = if from < 0 {
    0
  } else if from > length {
    length
  } else {
    from
  }
  let end = if to < start {
    start
  } else if to > length {
    length
  } else {
    to
  }
  core.arraySlice(items, start, end - start)
}

/// A new vector holding a copy of these elements, with no spare room.
///
/// The elements are copied as they are rather than snapshotted, so the
/// sequence is separated and nothing inside it is. The body is one core
/// intrinsic: the store, the copy and the vector around them.
export fn toVector<T>(items: Array<T>) -> Vector<T> {
  core.arrayToVector(items)
}

/// The elements `keep` answers `true` for, in the order they were in.
///
/// A loop and a `Vector` that is frozen at the end, which is what the walk
/// instruction this replaces did with an array it filled to the receiver's
/// length and then sliced. That difference is the whole of what the move
/// costs, and it was measured before it was made: the mechanism is about a
/// quarter slower on a benchmark that does nothing else two million times,
/// and `myuon/the-cove` — a real application, and the one whose Cove code
/// used `filter` more than anything else — runs 2% slower end to end with
/// its twenty golden world-hashes unchanged.
export fn filter<T>(items: Array<T>, keep: fn(item: T) -> Bool) -> Array<T> {
  var out: Vector<T> = Vector.of()
  for item in items {
    if keep(item) {
      out.push(item)
    }
  }
  out.freeze()
}

/// `initial`, with `step` applied to it once per element, left to right.
///
/// Allocates nothing, which is why it costs less to have moved than
/// [`filter`] did — 1.13x against 1.24x on the same benchmark.
export fn fold<T, A>(
  items: Array<T>,
  initial: A,
  step: fn(acc: A, item: T) -> A,
) -> A {
  var acc = initial
  for item in items {
    acc = step(acc, item)
  }
  acc
}
