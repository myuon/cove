/// How many characters this string is.
///
/// Characters and not bytes: a two-byte character counts one here and two in
/// [`byteLength`]. That difference is the whole of the line between them, and
/// it is why this walks the text where `byteLength` reads a header word.
///
/// A `String` is valid UTF-8 in its shortest form — nothing makes one from
/// anything else — so the lead byte alone says how wide the character it
/// begins is, and the continuation bytes after it need not be looked at at
/// all: below 128 is one byte, below 224 is two, below 240 is three, and
/// anything left is four. A lead byte of `11111xxx` cannot occur, so the last
/// case needs no test of its own — [`codePointAtByte`]'s reasoning, used here
/// to skip a character rather than to decode one. The loop advances by the
/// width it read, so it lands on a lead byte every time and never asks a
/// continuation byte how wide it is.
///
/// It was `chars().count()` in Rust, one `IntrinsicCall` per call and the
/// most-called one in the repository. ADR 0064 moves it here: a character
/// count is a policy over a representation, not an operation of the machine,
/// and the bound below it is `core.byteLength` — a header load — with one run
/// load a character over it. A loop the native tier compiles, in place of a
/// call it can only cross back out of.
export fn length(text: String) -> Int {
  let bytes = core.byteLength(text)
  var at = 0
  var count = 0
  while at < bytes {
    let lead = text.byteAt(at)
    if lead < 128 {
      at += 1
    } else if lead < 224 {
      at += 2
    } else if lead < 240 {
      at += 3
    } else {
      at += 4
    }
    count += 1
  }
  count
}

/// Whether this string is the empty one.
///
/// `core.byteLength` rather than [`length`]: a string has no characters
/// exactly when it has no bytes, because every character is at least one byte
/// and no character is none. So the question is one header load, where
/// `length() == 0` would walk the whole text to answer something its first
/// byte already settles — which it would not have done while `length` was a
/// primitive, and does now that ADR 0064 has made it a loop.
export fn isEmpty(text: String) -> Bool {
  core.byteLength(text) == 0
}

/// Whether this string ends with `suffix`.
///
/// The comparison is of **bytes**: the last `suffix.byteLength()` bytes of the
/// text against the whole of the suffix, one byte at a time, stopping at the
/// first pair that differs. A suffix longer than the text is answered on the
/// two lengths alone, before a byte of either is read.
///
/// Nothing here asks whether the offset the comparison starts at begins a
/// character, and that is not an omission — it is the reason a byte loop is
/// allowed to answer a question about text at all. **UTF-8 is
/// self-synchronizing.** A continuation byte is `10xxxxxx`, 128 through 191,
/// and no character begins with one; a `String` is valid UTF-8 in its shortest
/// form — nothing makes one from anything else — so a suffix's first byte is a
/// lead byte and never a continuation byte. If every byte from `n - m` onwards
/// matches, then in particular the byte at `n - m` equals the suffix's first
/// byte, so it is a lead byte too, and a lead byte in valid UTF-8 is the start
/// of a character. A byte match at `n - m` is therefore a match at a character
/// boundary by construction, and a character-by-character comparison would
/// find exactly what this finds. That is [`codePointAtByte`]'s fact read in
/// the other direction: there it says the lead byte alone decides a
/// character's width, here it says a match cannot land inside one.
///
/// An empty suffix answers `true`, because the loop does not run — which is
/// what `str::ends_with("")` answers, and `tests/e2e/values_string_ends_with`
/// asserts it rather than leaving it to be obvious.
///
/// It was `str::ends_with` in Rust, one `IntrinsicCall` per call. ADR 0064
/// moves it here: `endsWith` is a method's name and would have to be renamed
/// the day the method was, which is Decision 2's test, and what is left
/// underneath is `core.byteLength` — a header load — with one run load a byte
/// over it. A loop the native tier compiles, in place of a call it can only
/// cross back out of.
///
/// Each question is an `if` of its own and the answer is a `return`, for the
/// reasons [`sliceBytes`] gives.
export fn endsWith(text: String, suffix: String) -> Bool {
  let suffixLength = core.byteLength(suffix)
  let textLength = core.byteLength(text)
  if suffixLength > textLength {
    return false
  }
  let start = textLength - suffixLength
  var at = 0
  while at < suffixLength {
    if text.byteAt(start + at) != suffix.byteAt(at) {
      return false
    }
    at += 1
  }
  return true
}

/// How many bytes this string's UTF-8 encoding is.
///
/// Bytes and not characters: a two-byte character counts two here and one in
/// `length()`. It is the range `byteAt`, `codePointAtByte` and `sliceBytes`
/// take their offsets in, and what a `StringBuilder` copies when it appends
/// the whole of a string.
///
/// The count is the header of the object that holds the bytes, which is a fact
/// about representation this file cannot state — so the body is one core
/// intrinsic and nothing else, and the lowering expands it wherever it is
/// called. See ADR 0058.
export fn byteLength(text: String) -> Int {
  core.byteLength(text)
}

/// The Unicode scalar value of the character that begins at byte `offset`, or
/// `None` when no character begins there.
///
/// Before the start, at or past the end, and inside a character are one answer
/// on purpose: a scanner that advances by the width of what it read reaches
/// none of them, and telling them apart would cost a `Result` on the one path
/// this exists for.
///
/// A `String` is valid UTF-8 in its shortest form — nothing makes one from
/// anything else — so the lead byte alone says how wide the character is and
/// every byte after it is a continuation byte that is there: `10xxxxxx`, whose
/// low six bits are the next six bits of the scalar. That is why this reads
/// only as many bytes as the character has, and checks neither that they are
/// continuation bytes nor that the string is long enough to hold them; a lead
/// byte of `11111xxx` cannot occur, so the last case needs no test of its own.
///
/// It was a Rust decode in each evaluator. ADR 0058 (#378, Q5.9) moved it here
/// over `byteAt`, which is one run load, and each question is an `if` of its own
/// with a `return` for the reason [`sliceBytes`] gives. ASCII, the case a lexer
/// is almost always in, is decided after one load and two comparisons.
export fn codePointAtByte(text: String, offset: Int) -> Option<Int> {
  if offset < 0 {
    return None
  }
  if offset >= core.byteLength(text) {
    return None
  }
  let lead = text.byteAt(offset)
  if lead < 128 {
    return Some(lead)
  }
  // A continuation byte, 128 through 191, is the inside of a character.
  if lead < 192 {
    return None
  }
  let second = text.byteAt(offset + 1) - 128
  if lead < 224 {
    return Some((lead - 192) * 64 + second)
  }
  let third = text.byteAt(offset + 2) - 128
  if lead < 240 {
    return Some(((lead - 224) * 64 + second) * 64 + third)
  }
  let fourth = text.byteAt(offset + 3) - 128
  return Some((((lead - 240) * 64 + second) * 64 + third) * 64 + fourth)
}

/// The text between two byte offsets, or why there is none.
///
/// Both offsets are **byte** offsets — the ones `byteLength`, `byteAt` and
/// `codePointAtByte` deal in — and the range they name has to be in the string,
/// run forwards, and begin and end at the start of a character (the end of the
/// string counts as one). It refuses rather than clamps, which is where it parts
/// from `slice`: an offset outside the string or inside a character is one this
/// type never handed out, and moving it to the nearest legal one would answer a
/// question nobody asked.
///
/// The range is decided here, in Cove, and the copy beneath it is a core
/// intrinsic: ADR 0058's run slice over packed bytes, which allocates the answer
/// at exactly its length and validates nothing. It needs to validate nothing
/// because of the checks above it — a run of valid UTF-8 cut at two character
/// boundaries is valid UTF-8 — so the order below is not a courtesy to the
/// copy, it is the copy's precondition.
///
/// The success path asks only whether `0 <= from <= to <= length` and whether
/// the byte at each end is a continuation byte; which of the five things is
/// wrong, and in what words, is [`refuseRange`]'s, so the common path
/// carries no message.
///
/// **Each question is an `if` of its own rather than one condition joined by
/// `&&` or `||`**, and that is for the machine rather than the reader. A
/// comparison that is all an `if` branches on is one instruction (ADR 0054),
/// but the arms of `a || b` meet at a shared test that nothing can fuse, so
/// joining the five range and byte questions cost this body three more
/// dispatches per call — on a method `examples/covefmt` calls 870 thousand
/// times. The answer is a `return` rather than the body's last expression for
/// the same reason: an `Ok` in tail position is built aside and copied into the
/// answer, which was two dispatches more.
export fn sliceBytes(
  text: String,
  from: Int,
  to: Int,
) -> Result<String, Error> {
  let length = core.byteLength(text)
  if from < 0 {
    return refuseRange(text, from, to)
  }
  if from > to {
    return refuseRange(text, from, to)
  }
  if to > length {
    return refuseRange(text, from, to)
  }
  // A continuation byte is `10xxxxxx`, 128 through 191, and an ASCII byte is
  // below both; the end of the string is a boundary and has no byte to look at.
  if from < length {
    let first = text.byteAt(from)
    if first >= 128 {
      if first < 192 {
        return refuseRange(text, from, to)
      }
    }
  }
  if to < length {
    let last = text.byteAt(to)
    if last >= 128 {
      if last < 192 {
        return refuseRange(text, from, to)
      }
    }
  }
  return Ok(core.stringSlice(text, from, to - from))
}

/// The `Err` that says what is wrong with the byte range `from` to `to` of
/// `text`, which [`sliceBytes`] has already found to be wrong.
///
/// Five things can be wrong, asked in the order a reader would ask them: is
/// `from` an offset into this string at all, is `to`, do they run forwards, and
/// does each begin a character. A range that is wrong in several ways is told
/// about the first. The sentences are the ones `StringBuilder.appendSlice` stops
/// a run with, word for word — a builder's append holds its range to this rule
/// too.
///
/// A function of its own so that the path that succeeds carries no
/// interpolation, and the whole `Result` rather than its `Error` so that each
/// refusal in [`sliceBytes`] is a call answered straight into what that body
/// returns, with nothing built around it afterwards.
fn refuseRange(text: String, from: Int, to: Int) -> Result<String, Error> {
  let length = core.byteLength(text)
  let message = if from < 0 || from > length {
    "`from` is `{from}`, and a byte offset into this string is 0 to {length}"
  } else if to < 0 || to > length {
    "`to` is `{to}`, and a byte offset into this string is 0 to {length}"
  } else if from > to {
    "`from` is `{from}` and `to` is `{to}`, so this range runs backwards"
  } else if from < length && text.byteAt(from) >= 128 && text.byteAt(from) < 192 {
    "`from` is `{from}`, which is inside a character rather than at the start of one"
  } else {
    "`to` is `{to}`, which is inside a character rather than at the start of one"
  }
  return Err(Error(message))
}
