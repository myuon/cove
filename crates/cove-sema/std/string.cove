}

/// The uppercase answers that are more than one character, as UTF-8.
///
/// **317 bytes for 102 expansions**, because an answer that is already a
/// substring of the text is not written again: `ﬀ` is `FF` and `ﬃ` is `FFI`,
/// and the first is inside the second. [`caseMappingOf`]'s negative answer is
/// an offset and a length into this, and [`writeMapping`] copies the run.
///
/// It is readable on purpose. `SS` is `ß`; `ԵՒ` is `և`; the long Greek middle
/// is the `U+1F80` block, each an uppercase letter followed by an iota; and
/// `FF FI FL FFI FFL ST` at the end are the Latin ligatures.
fn upperExpansions() -> String {
  "SSʼNJ̌Ϊ́Ϋ́ԵՒH̱T̈W̊Y̊AʾΥ̓Υ̓̀Υ̓́Υ̓͂ἈΙἉΙἊΙἋΙἌΙἍΙἎΙἏΙἨΙἩΙἪΙἫΙἬΙἭΙἮΙἯΙὨΙὩΙὪΙὫΙὬΙὭΙὮΙὯΙᾺΙΑΙΆΙΑ͂Α͂ΙῊΙΗΙΉΙΗ͂Η͂ΙΪ̀Ι͂Ϊ͂Ϋ̀Ρ̓Υ͂Ϋ͂ῺΙΩΙΏΙΩ͂Ω͂ΙFFFIFLFFLSTՄՆՄԵՄԻՎՆՄԽ"
}

/// The lowercase answers that are more than one character, as UTF-8.
///
/// **Three bytes, and one entry.** `U+0130` — the Turkish dotted capital I —
/// lowercases to `i` followed by `U+0307` COMBINING DOT ABOVE, and it is the
/// only code point in Unicode whose lowercase mapping is longer than one
/// character. The table exists for it alone, and it exists rather than being
/// special-cased so that [`toLower`] and [`toUpper`] read the same record
/// format.
fn lowerExpansions() -> String {
  "i̇"
}

/// Unicode 17.0.0's `Cased`, **less** `Case_Ignorable`, as ranges.
///
/// **151 records of seven base-32 symbols, 1,057 bytes**, covering 4,364 code
/// points. [`inPackedRanges`] is the reader.
///
/// The subtraction is the whole point and [`sigmaIsFinal`] argues it: 268 code
/// points are in both Unicode sets, and the scan skips ignorable characters
/// before it asks about cased ones, so a character in both is skipped. Holding
/// the difference here rather than the full set makes the two tables disjoint
/// and the scan's order irrelevant.
fn casedRanges() -> String {
  "000210J000310J0005:010005E010005J01000600G0006H0O0007H63000=L04000>46@000DF0J000K@04000KF02000KK03000KO01000L601000L803000L<01000L>0D000M32C000OG4;0014:560019A16001;019004501600467010046=010046@1;0047M03004M02F004OH06007400;0074@1;0075M03007801<007;;0=007;I12007@08F007HH06007I016007J806007J@08007JI01007JK01007JM01007JO0O007L01E007MF07007MN01007N203007N607007N@04007NF06007O00=007OB03007OF07008820100887010088:0:0088E010088I050089401008960100898010089:040089?060089I010089L04008:505008:>01008;010008<3020095F1D00;003L00;3N3700;7;0400;7B0200;801600;970100;9=01019B01>019D00L019I22>019KA0G019L;04019L@2=019OE02019OJ0101:I@1;01:K00901:K@2@01NH00701NHC0501OI10J01OJ10J021002@0215@140216H14021;@0;021;L0?021<<07021<D02021<G0;021=30?021=C07021=K02023401C023601C023:@0F023;@0F026502002KB02002KE00I02KEK0I03E002E03E2F2703E4N0203E520103E550203E590403E5>0<03E5K0103E5M0703E652103E870403E8=0803E8F0703E8N0L03E9K0403E:00503E:60103E::0703E:B:D03EE80I03EF20I03EFL0O03EGL0I03EHF0O03EIF0I03EJ@0O03EK@0I03EL:0O03EM:0I03EN40803GH00:03GH;0D03GI50603J802403L9@0J03L:@0J03L;@0J"
}

/// Unicode 17.0.0's `Case_Ignorable`, as ranges.
///
/// **464 records, 3,248 bytes**, covering 2,794 code points — the largest of
/// the six tables and 30% of the asset, for a rule that fires only at a `Σ`.
/// Combining marks, format characters, modifier letters, and the three word
/// characters `'`, `’` and `.`.
///
/// It is not shrinkable by dropping what looks unlikely: `"ΑΣ\u{00AD}"` ends in
