/// Whether this set holds nothing.
export fn isEmpty<T>(items: Set<T>) -> Bool {
  items.length() == 0
}

/// Whether `element` is one of this set's members.
///
/// A member equal to `element` in the order the set keeps is found whether or
/// not it is the one that was put there: a string by its bytes, a struct field
/// by field. An element that cannot be a member at all — a `Float`, a `Vector`,
/// or anything holding one — is refused before anything is compared, so an
/// empty set refuses it as loudly as a full one.
///
/// A binary search in Cove over the set's ascending run (ADR 0059, #378). It
/// was one in Rust; what moved is the search, and what stayed beneath it is the
/// order a step compares by and the admission of the element, which are
/// questions about a value's layout this file cannot ask.
export fn contains<T>(items: Set<T>, element: T) -> Bool {
  core.admitKey(element, "Set.contains", "set element")
  return seekSet(items, element) >= 0
}

/// Where `element` is among `items`' ascending members: its position when it
/// is there, and `-(where it would go) - 1` when it is not.
///
/// So a found position is never negative and a missing one always is, and the
/// insertion point is still in the answer — `slice::binary_search`'s `Ok` and
/// `Err` in one `Int`. The midpoint cannot overflow: a run's length is a
/// header word no larger than a `u32`.
fn seekSet<T>(items: Set<T>, element: T) -> Int {
  var low = 0
  var high = items.length()
  while low < high {
    let at = (low + high) / 2
    let order = core.order(core.memberAt(items, at), element)
    if order < 0 {
      low = at + 1
    } else if order > 0 {
      high = at
    } else {
      return at
    }
  }
  return -low - 1
}
