/// Whether this set holds nothing.
export fn isEmpty<T>(items: Set<T>) -> Bool {
  items.length() == 0
}

/// Whether `element` is one of this set's members.
///
/// A member equal to `element` in the order the set keeps is found whether or
/// not it is the one that was put there: a string by its bytes, a struct field
/// by field. An element that cannot be a member at all — a `Float`, a `Vector`,
/// or anything holding one — is refused before anything is compared, so an
/// empty set refuses it as loudly as a full one.
///
/// A binary search in Cove over the set's ascending run (ADR 0059, #378). It
/// was one in Rust; what moved is the search, and what stayed beneath it is the
/// order a step compares by and the admission of the element, which are
/// questions about a value's layout this file cannot ask.
export fn contains<T>(items: Set<T>, element: T) -> Bool {
  core.admitKey(element, "Set.contains", "set element")
  return seekSet(items, element) >= 0
}

/// This set with `element` in it, as a new set.
///
/// An element already there answers **this set**, unchanged: nothing about
/// it would differ, and a set is immutable, so which object answers is not
/// something a program can ask (#378, Q4.9). Otherwise the answer is built
/// once, at exactly its length — the members below where `element` goes,
/// `element`, and the members above — ascending because it was built in
/// order and never because anything sorted it. The same refusal
/// [`contains`] makes of an element that cannot be a member comes first.
///
/// Cove over a growable run of the member's words (ADR 0059, P4-6): the two
/// ranges are word copies out of the old run, and the finish relabels the
/// vector's store into the new set without copying it again.
export fn inserted<T>(items: Set<T>, element: T) -> Set<T> {
  core.admitKey(element, "Set.inserted", "set element")
  let at = seekSet(items, element)
  if at >= 0 {
    return items
  }
  let gap = -at - 1
  let length = items.length()
  let out: Vector<T> = core.vectorWithCapacity(length + 1)
  core.extendFromSet(out, items, 0, gap)
  core.vectorPush(out, element)
  core.extendFromSet(out, items, gap, length - gap)
  return core.setFinish(out)
}

/// This set without `element`, as a new set.
///
/// An element that is not there answers **this set**, unchanged, for
/// [`inserted`]'s reason. Otherwise the answer is the members below it and
/// the members above it, copied into a run of exactly one fewer.
export fn removed<T>(items: Set<T>, element: T) -> Set<T> {
  core.admitKey(element, "Set.removed", "set element")
  let at = seekSet(items, element)
  if at < 0 {
    return items
  }
  let length = items.length()
  let out: Vector<T> = core.vectorWithCapacity(length - 1)
  core.extendFromSet(out, items, 0, at)
  core.extendFromSet(out, items, at + 1, length - at - 1)
  return core.setFinish(out)
}

/// Where `element` is among `items`' ascending members: its position when it
/// is there, and `-(where it would go) - 1` when it is not.
///
/// So a found position is never negative and a missing one always is, and the
/// insertion point is still in the answer — `slice::binary_search`'s `Ok` and
/// `Err` in one `Int`. The midpoint cannot overflow: a run's length is a
/// header word no larger than a `u32`.
fn seekSet<T>(items: Set<T>, element: T) -> Int {
  var low = 0
  var high = items.length()
  while low < high {
    let at = (low + high) / 2
    let order = core.order(core.memberAt(items, at), element)
    if order < 0 {
      low = at + 1
    } else if order > 0 {
      high = at
    } else {
      return at
    }
  }
  return -low - 1
}
