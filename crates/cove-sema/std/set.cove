/// Whether this set holds nothing.
export fn isEmpty<T>(items: Set<T>) -> Bool {
  items.length() == 0
}

/// Whether `element` is one of this set's members.
///
/// A member equal to `element` in the order the set keeps is found whether or
/// not it is the one that was put there: a string by its bytes, a struct field
/// by field. An element that cannot be a member at all — a `Float`, a `Vector`,
/// or anything holding one — is refused before anything is compared, so an
/// empty set refuses it as loudly as a full one.
///
/// A binary search in Cove over the set's ascending run (ADR 0059, #378). It
/// was one in Rust; what moved is the search, and what stayed beneath it is the
/// order a step compares by and the admission of the element, which are
/// questions about a value's layout this file cannot ask.
export fn contains<T>(items: Set<T>, element: T) -> Bool {
  core.admitKey(element, "Set.contains", "set element")
  return seekSet(items, element) >= 0
}

/// A set of `items`, in ascending order whatever order they were written in.
///
/// Each element is admitted, searched for among the members placed so far, and
/// placed where it belongs, so the run is ascending at every step and is
/// finished into the set without sorting (ADR 0059, #378 P4-8). A duplicate is
/// refused rather than collapsed — a literal with the same element twice is a
/// mistake and not an intent — and the one named is the first found again in
/// argument order. The run has exactly one member per argument, so its room is
/// allocated once.
///
/// `Set.of()` with nothing in it does not reach here where the element type is
/// known: the lowering allocates the empty set itself.
export fn of<T>(items: T...) -> Set<T> {
  let out: Vector<T> = core.vectorWithCapacity(items.length())
  for element in items {
    core.admitKey(element, "Set.of", "set element")
    let at = seekPlaced(out, element)
    if at >= 0 {
      core.refuse(duplicateElement(element), duplicateRule(), duplicateHelp())
    }
    placeAt(out, -at - 1, element)
  }
  core.setFinish(out)
}

/// What [`of`] says of an element it was given twice.
///
/// [`std.map.of`]'s refusal with this type's two words, and raised the same
/// way: in [`of`]'s own frame, on the line that found the duplicate, out of
/// sentences built by calls that have returned, so the diagnostic blames what
/// it blamed when the sentence was the runtime's.
fn duplicateElement<T>(element: T) -> String {
  "`Set.of` was given the element `{element}` more than once"
}

/// The rule every duplicate in a literal is refused under; [`std.map.of`]
/// states it too, word for word.
fn duplicateRule() -> String {
  "A literal with two identical keys is a mistake, not an intent; duplicate keys are rejected rather than silently resolved by keeping the last one."
}

/// What [`of`] suggests instead.
fn duplicateHelp() -> String {
  "remove the duplicate, or give it a different element"
}

/// This set with `element` in it, as a new set.
///
/// An element already there answers **this set**, unchanged: nothing about
/// it would differ, and a set is immutable, so which object answers is not
/// something a program can ask (#378, Q4.9). Otherwise the answer is built
/// once, at exactly its length — the members below where `element` goes,
/// `element`, and the members above — ascending because it was built in
/// order and never because anything sorted it. The same refusal
/// [`contains`] makes of an element that cannot be a member comes first.
///
/// Cove over a growable run of the member's words (ADR 0059, P4-6): the two
/// ranges are word copies out of the old run, and the finish relabels the
/// vector's store into the new set without copying it again.
export fn inserted<T>(items: Set<T>, element: T) -> Set<T> {
  core.admitKey(element, "Set.inserted", "set element")
  let at = seekSet(items, element)
  if at >= 0 {
    return items
  }
  let gap = -at - 1
  let length = items.length()
  let out: Vector<T> = core.vectorWithCapacity(length + 1)
  copyFromSet(out, items, 0, gap)
  let end = core.vectorLength(out)
  core.vectorEnsure(out, 1)
  core.vectorStore(out, end, element)
  core.vectorCommit(out, 1)
  copyFromSet(out, items, gap, length - gap)
  return core.setFinish(out)
}

/// This set without `element`, as a new set.
///
/// An element that is not there answers **this set**, unchanged, for
/// [`inserted`]'s reason. Otherwise the answer is the members below it and
/// the members above it, copied into a run of exactly one fewer.
export fn removed<T>(items: Set<T>, element: T) -> Set<T> {
  core.admitKey(element, "Set.removed", "set element")
  let at = seekSet(items, element)
  if at < 0 {
    return items
  }
  let length = items.length()
  let out: Vector<T> = core.vectorWithCapacity(length - 1)
  copyFromSet(out, items, 0, at)
  copyFromSet(out, items, at + 1, length - at - 1)
  return core.setFinish(out)
}

/// The members of this set as an `Array`, in ascending order.
///
/// Which is the order they are already in, so this copies rather than sorts:
/// ascending is how a set is stored, and `toArray()` is where a program says
/// it wants that order to be its own. One run slice of the whole set (ADR 0058,
/// #378 P4-7) — a set's run read as the array of its members it already is,
/// at the member's stride.
export fn toArray<T>(items: Set<T>) -> Array<T> {
  core.setSlice(items, 0, items.length())
}

/// Where `element` is among the ascending members a literal has placed in
/// `run` so far: [`seekSet`]'s answer over a vector under construction.
fn seekPlaced<T>(run: Vector<T>, element: T) -> Int {
  var low = 0
  var high = core.vectorLength(run)
  while low < high {
    let at = (low + high) / 2
    let order = core.order(core.vectorLoad(run, at), element)
    if order < 0 {
      low = at + 1
    } else if order > 0 {
      high = at
    } else {
      return at
    }
  }
  return -low - 1
}

/// `count` members of `items` from `from`, appended to `run`, whose store
/// already has room for them.
///
/// [ADR 0062]'s append of a run, over a set's members rather than a string's
/// bytes: the length, room for `count` more, the copy into the room, and the
/// length raised over it. `std.map`'s `copyFromMap` is the same body over a
/// map's entries, and says why this shape rather than the field store
/// `core.extendFromSet` ended with.
///
/// [ADR 0062]: ../../../docs/adr/0062-an-append-is-ensure-store-commit.md
fn copyFromSet<T>(run: Vector<T>, items: Set<T>, from: Int, count: Int) {
  let at = core.vectorLength(run)
  core.vectorEnsure(run, count)
  core.vectorCopyFromSet(run, at, items, from, count)
  core.vectorCommit(run, count)
}

/// `element` placed at `gap` of `run`, whose store has room for one more: the
/// members from `gap` moved up by one, then the new one written into the hole.
fn placeAt<T>(run: Vector<T>, gap: Int, element: T) {
  let length = core.vectorLength(run)
  core.vectorEnsure(run, 1)
  core.vectorStore(run, length, element)
  core.vectorCommit(run, 1)
  core.vectorMove(run, gap + 1, gap, length - gap)
  core.vectorStore(run, gap, element)
}

/// Where `element` is among `items`' ascending members: its position when it
/// is there, and `-(where it would go) - 1` when it is not.
///
/// So a found position is never negative and a missing one always is, and the
/// insertion point is still in the answer — `slice::binary_search`'s `Ok` and
/// `Err` in one `Int`. The midpoint cannot overflow: a run's length is a
/// header word no larger than a `u32`.
fn seekSet<T>(items: Set<T>, element: T) -> Int {
  var low = 0
  var high = items.length()
  while low < high {
    let at = (low + high) / 2
    let order = core.order(core.memberAt(items, at), element)
    if order < 0 {
      low = at + 1
    } else if order > 0 {
      high = at
    } else {
      return at
    }
  }
  return -low - 1
}
