/// The receiver's whole microseconds, truncated toward zero.
///
/// This is `Duration`, except the one operation that has to know how a
/// duration is actually stored: `Duration.nanos` and `d.nanos()` are the
/// only primitive left, and every function in this file is nanoseconds
/// scaled by a constant. A reader divides by its unit's factor, truncating
/// toward zero the way `Int` division already does, and a builder
/// multiplies by its factor and hands the count to `Duration.nanos`. The
/// factors are the ones the lexer already gives the matching literal suffix
/// — `us`, `ms`, `s`, `m`, `h` — so `1s` and `Duration.seconds(1)` are the
/// same value, and a duration built in a unit and read back in it answers
/// the count unchanged.
///
/// A reader can never fail: dividing a count that fits leaves a count that
/// fits. A builder's multiplication traps exactly as any other `Int`
/// multiplication does — the trap now reads `` `Int` multiplication
/// overflowed `` at the multiply below, rather than `` `Int` duration
/// arithmetic overflowed `` at the call, which is the one externally
/// visible change this migration makes.
export fn micros(duration: Duration) -> Int {
  duration.nanos() / 1_000
}

/// The receiver's whole milliseconds, truncated toward zero.
export fn millis(duration: Duration) -> Int {
  duration.nanos() / 1_000_000
}

/// The receiver's whole seconds, truncated toward zero.
export fn seconds(duration: Duration) -> Int {
  duration.nanos() / 1_000_000_000
}

/// The receiver's whole minutes, truncated toward zero.
export fn minutes(duration: Duration) -> Int {
  duration.nanos() / 60_000_000_000
}

/// The receiver's whole hours, truncated toward zero.
export fn hours(duration: Duration) -> Int {
  duration.nanos() / 3_600_000_000_000
}

/// `count` microseconds.
///
/// Named `ofMicros` rather than `micros`, because a Cove module cannot
/// declare `micros` twice — the reader above already has that name, and
/// `Duration.micros(n)` and `d.micros()` are one schema entry each, bound to
/// two different functions of this module.
export fn ofMicros(count: Int) -> Duration {
  Duration.nanos(count * 1_000)
}

/// `count` milliseconds.
export fn ofMillis(count: Int) -> Duration {
  Duration.nanos(count * 1_000_000)
}

/// `count` seconds.
export fn ofSeconds(count: Int) -> Duration {
  Duration.nanos(count * 1_000_000_000)
}

/// `count` minutes.
export fn ofMinutes(count: Int) -> Duration {
  Duration.nanos(count * 60_000_000_000)
}

/// `count` hours.
export fn ofHours(count: Int) -> Duration {
  Duration.nanos(count * 3_600_000_000_000)
}

/// Appends the text of `value` to `buffer`: what `"{value}"` shows.
///
/// Not exported, and nothing a program can name: the lowering calls it for
/// every `Duration` piece of an interpolation and every `Duration` part of a
/// value it renders, as it calls `std.int.renderInto` for an `Int`. ADR 0068's
/// Phase 4a moved it here from the `Duration` arm of the Rust intrinsic
/// `Value.renderInto`, whose bytes it writes; that arm still renders a
/// `Duration` held inside a box until Phase 4b, and it is the oracle's
/// `write_duration` besides.
///
/// # The text of a `Duration`
///
/// **The count in the largest unit that divides the value exactly, and the
/// unit's suffix**, the units being the literal suffixes the lexer reads, `h`,
/// `m`, `s`, `ms`, `us` and `ns`: `2h`, `90s` rather than `1.5m`, `1500ms`,
/// `1us`, `999ns`. Nought has no largest unit and is `0ns`. A negative
/// duration keeps its sign, `-5ms`, and the least one, which no unit above a
/// nanosecond divides, is its whole count of nanoseconds. So the text is
/// always a literal that reads back as the same value.
///
/// # How
///
/// Five remainders pick the unit — nought is left at nanoseconds rather than
/// taken by the first — and the count is written by `std.int.renderInto`'s
/// loop, copied here because one standard-library module cannot name
/// another's private function: on the non-positive side of nought, where the
/// least `Int` has a counterpart, so nothing in it can overflow. The suffix is
/// one letter and, for the three below a second, an `s`, each bound before its
/// append window.
fn renderInto(value: Duration, buffer: ByteBuffer) {
  let nanos = value.nanos()
  var factor = 1
  var letter = 'n'
  var second = true
  if nanos != 0 {
    if nanos % 3_600_000_000_000 == 0 {
      factor = 3_600_000_000_000
      letter = 'h'
      second = false
    } else if nanos % 60_000_000_000 == 0 {
      factor = 60_000_000_000
      letter = 'm'
      second = false
    } else if nanos % 1_000_000_000 == 0 {
      factor = 1_000_000_000
      letter = 's'
      second = false
    } else if nanos % 1_000_000 == 0 {
      factor = 1_000_000
      letter = 'm'
    } else if nanos % 1_000 == 0 {
      factor = 1_000
      letter = 'u'
    }
  }
  var rest = nanos / factor
  if rest < 0 {
    let minus = '-'
    let at = core.bytesLength(buffer)
    core.bytesEnsure(buffer, 1)
    core.bytesStore(buffer, at, minus)
    core.bytesCommit(buffer, 1)
  } else {
    rest = -rest
  }
  let tenth = rest / 10
  var power = -1
  while tenth <= power {
    power = power * 10
  }
  while power < 0 {
    let digit = rest / power
    let byte = '0' + digit
    let at = core.bytesLength(buffer)
    core.bytesEnsure(buffer, 1)
    core.bytesStore(buffer, at, byte)
    core.bytesCommit(buffer, 1)
    rest = rest - digit * power
    power = power / 10
  }
  let at = core.bytesLength(buffer)
  core.bytesEnsure(buffer, 1)
  core.bytesStore(buffer, at, letter)
  core.bytesCommit(buffer, 1)
  if second {
    let s = 's'
    let end = core.bytesLength(buffer)
    core.bytesEnsure(buffer, 1)
    core.bytesStore(buffer, end, s)
    core.bytesCommit(buffer, 1)
  }
  return
}
