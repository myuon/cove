/// The smaller of two integers.
export fn min(value: Int, other: Int) -> Int {
  if value < other {
    value
  } else {
    other
  }
}

/// The larger of two integers.
export fn max(value: Int, other: Int) -> Int {
  if value > other {
    value
  } else {
    other
  }
}

/// This value, with its sign removed.
///
/// Unlike `min` and `max` beside it, this one can fail: the least `Int` has
/// no positive counterpart, and it traps there exactly as the builtin did.
/// It is the first fallible function in the standard library, which was
/// possible to write here at all only once a trap raised from inside a
/// standard-library body named its caller rather than only this file's own
/// line — [issue #258](https://github.com/myuon/cove/issues/258).
export fn abs(value: Int) -> Int {
  if value < 0 {
    -value
  } else {
    value
  }
}
