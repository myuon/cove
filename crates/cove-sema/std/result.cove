/// Whether this result is a success.
///
/// The first standard-library functions to be generic over two parameters.
/// Nothing in the repository had written `fn f<T, E>(...)` before — the
/// grammar accepted it and no checked program used it — so this is also the
/// first thing that proves `Result<T, E>` is expressible in Cove at all.
export fn isOk<T, E>(result: Result<T, E>) -> Bool {
  match result {
    Ok(_) => true
    Err(_) => false
  }
}

/// Whether this result is a failure.
///
/// Named `isError` and matching `Err`, which is the same disagreement the
/// lowering carried before it: the case is `Err` because that is what a
/// program writes, and the method is `isError` because that is what a
/// sentence reads like.
export fn isError<T, E>(result: Result<T, E>) -> Bool {
  match result {
    Ok(_) => false
    Err(_) => true
  }
}

/// The value this result holds, or `fallback` if it failed.
///
/// Strict in `fallback`, for the same reason [`std.option.unwrapOr`] is.
export fn unwrapOr<T, E>(result: Result<T, E>, fallback: T) -> T {
  match result {
    Ok(value) => value
    Err(_) => fallback
  }
}

/// The same result with its error replaced by what `body` answers.
///
/// The success is rebuilt rather than passed through, because a
/// `Result<T, E>` and a `Result<T, F>` are different types and Cove converts
/// nothing implicitly. `body` is called only on the failing side, which is
/// the one place in this file where a branch decides whether a call happens
/// at all.
///
/// This is the method [ADR 0044](../../../docs/adr/0044-a-callback-takes-what-its-type-declares.md)
/// was written for. It could not be here while a callback's arity was
/// adapted rather than matched: a program could write `mapError { ... }` with
/// a trailing closure naming no parameter, and no Cove body can call such a
/// closure — `body(error)` passes one argument always. Removing that
/// exception is the whole of what let this line be written.
export fn mapError<T, E, F>(
  result: Result<T, E>,
  body: fn(error: E) -> F,
) -> Result<T, F> {
  match result {
    Ok(value) => Ok(value)
    Err(error) => Err(body(error))
  }
}
