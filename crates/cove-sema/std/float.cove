    e += h
    if e >= -1074 {
      return timesPowerOfTwo((top.shiftRight(r) + 1).shiftRight(1), e)
    }
    let d = -1074 - e
    if d > 54 {
      return 0.0
    }
    return timesPowerOfTwo((top.shiftRight(r + d) + 1).shiftRight(1), -1074)
  }
  // Step 4: `L = top 2^90 + l2 2^60 + l1 2^30 + l0` exactly, in
  // `[2^148, 2^150)`. `F`'s low limb is nought for `0 <= q <= 25`, where
  // `5^q` has at most fifty-nine bits.
  var f0 = 0
  if q < 0 || q > 25 {
    f0 = table.byteAt(at + 10) * 64 + table.byteAt(at + 11)
    f0 = f0 * 64 + table.byteAt(at + 12)
    f0 = f0 * 64 + table.byteAt(at + 13)
    f0 = f0 * 64 + table.byteAt(at + 14) - 818089008
  }
  let d0 = a0 * f0
  let d1 = c1.bitAnd(limb) + a1 * f0 + d0.shiftRight(thirty)
  let d2 = c2.bitAnd(limb) + d1.shiftRight(thirty)
  top = top + d2.shiftRight(thirty)
  let l2 = d2.bitAnd(limb)
  // `N = floor(L / 2^b)` in `[2^53, 2^54)`, `b` 96 or 95, whose unit is
  // `2^(e - 1)`: `e` is the unit of the rounded significand.
  let h = top.shiftRightLogical(59)
  let r = h + 5
  e += h
  var n = top.shiftRight(r)
  let rest = top.bitAnd(1.shiftLeft(r) - 1)
  if q >= 0 && q <= 38 {
    // `F` is exact, so `L` is the value: round it, ties to even.
    let half = n.shiftRight(1)
    if n.bitAnd(1) == 1 {
      // Every bit below the round bit, summed: nought only on a tie.
      let below = rest + l2 + d1.bitAnd(limb) + d0.bitAnd(limb)
      if below != 0 || half.bitAnd(1) == 1 {
        return timesPowerOfTwo(half + 1, e)
      }
    }
    return timesPowerOfTwo(half, e)
  }
  // The value is strictly inside `(L, L + 2^60)`, and can carry into `N`
  // only when every bit of `L` from 60 to the round bit is one.
  var ones = rest == 1.shiftLeft(r) - 1 && l2 == limb
  if e < -1074 {
    // Step 5: below the least normal value. Past fifty-four bits down the
    // value is below half the least subnormal.
    let d = -1074 - e
    if d > 54 {
      return 0.0
    }
    let dropped = n.bitAnd(1.shiftLeft(d) - 1)
    if dropped != 1.shiftLeft(d) - 1 {
      ones = false
    }
    n = n.shiftRight(d)
    e = -1074
  }
  if ones {
    // Step 6: an exact value with `q < 0` lands here, just below its
    // boundary, whenever `F`'s shortfall is what put it there.
    if q >= -26 && q < 0 {
      var p = 5
      var left = -q - 1
      while left > 0 {
        p = p * 5
        left -= 1
      }
      if m - m / p * p == 0 {
        return timesPowerOfTwo(m / p, q)
      }
    }
    return 0.0 / 0.0
  }
  return timesPowerOfTwo((n + 1).shiftRight(1), e)
}

/// `significand × 2^exponent`, for a significand of at most fifty-three bits
/// already rounded to the answer's precision and `exponent >= -1074`: a few
/// multiplications or divisions by `2^248`, `2^124` and `2^62`, and then one
/// by the power of two left, which is an `Int` shifted and converted. Each is
/// exact, because every step's product is `significand × 2^j` with `j`
/// between nought and `exponent`. It overflows only when the answer does.
fn timesPowerOfTwo(significand: Int, exponent: Int) -> Float {
  var value = significand.toFloat()
  var left = exponent
  if left < 0 {
    if left < -62 {
      while left < -248 {
        value = value / 4.523128485832664e+74
        left += 248
      }
      if left < -124 {
        value = value / 2.1267647932558654e+37
        left += 124
      }
      if left < -62 {
        value = value / 4.611686018427388e+18
        left += 62
      }
    }
    return value / 1.shiftLeft(-left).toFloat()
  }
  if left > 62 {
    while left > 248 {
      value = value * 4.523128485832664e+74
      left -= 248
    }
    if left > 124 {
      value = value * 2.1267647932558654e+37
      left -= 124
    }
    if left > 62 {
      value = value * 4.611686018427388e+18
      left -= 62
    }
  }
  return value * 1.shiftLeft(left).toFloat()
}

/// The decimal [`parse`] has read and could not answer with one operation,
/// correctly rounded: simple decimal conversion over a bounded digit buffer.
///
/// `text` from `from` holds digits and at most one `.`, at least one digit
/// that is not nought, and then `e` or the end; `exponent` is the saturated
/// exponent [`parse`] read after them.
///
/// # The state
///
/// The value is `0.d1 d2 … dn × 10^point`, with `d1` not nought and `dn` not
/// nought, times `2^exp2`: the digits are the `count` first elements of
/// `digits`, one decimal digit a word, and there are never more than 768.
/// `truncated` says a digit past the 768th was dropped that was not nought —
/// so the value held is below the true one, by less than a unit of the last
/// digit held, and never equal to it.
///
/// # The steps
///
/// 1. **Toward `[1/2, 1)`.** While the value is `1` or more it is divided by
///    `2^s`, and while it is below `1/2` it is multiplied by `2^s`, `exp2`
///    keeping count. A multiplication by `2^s` is a division by `5^s` and ten
///    to the `s`, which moves the point: so both directions are [`divided`], one
///    pass of long division over the digits from the most significant, in
///    place, and no table of powers of five is needed to say how many digits a
///    product has.
/// 2. **A subnormal is shifted down** to the least exponent a normal value
///    has, so that it is rounded once, at the precision its own exponent has.
/// 3. **Fifty-three bits up**, and [`rounded`] takes the whole part: ties to
///    even, where a tie is a last digit `5` directly after the point and
///    nothing dropped behind it. A significand that rounded up to `2^53` is
///    halved and rounded again, from the digits and not from the rounded
///    value.
/// 4. **`significand × 2^(exp2 − 52)`**, a ladder of exact multiplications by
///    powers of two: exact because the significand already has the precision
///    of the answer, subnormals included (`clinger_box.rs`).
///
/// A value whose point is below `-324` is below half the least subnormal and
/// is nought; one whose point is `310` or more is past the largest finite
/// value and is infinity. Both are decided before a digit moves.
///
/// # What it allocates
///
/// The one buffer, `768` words. Nothing else: the state is `Int`s and a
/// `Bool`, and [`divided`] writes through `var` parameters.
fn parseSlow(
  text: String,
  from: Int,
  negative: Bool,
  exponent: Int,
) -> Result<Float, Error> {
  let end = core.byteLength(text)
  let digits: Vector<Int> = core.vectorWithCapacity(768)
  var count = 0
  var seen = 0
  var last = 0
  var point = 0
  var fraction = false
  var at = from
  while at < end {
    let byte = text.byteAt(at)
    let digit = byte - '0'
    if byte == '.' {
      fraction = true
    } else if digit < 0 || digit > 9 {
      break
    } else if seen == 0 && digit == 0 {
      if fraction {
        point -= 1
      }
    } else {
      seen += 1
      if !fraction {
        point += 1
      }
      if digit != 0 {
        last = seen
      }
      if count < 768 {
        pushLimb(digits, digit)
        count += 1
      }
    }
    at += 1
  }
  var truncated = last > 768
  if last < count {
    count = last
  }
  while core.vectorLoad(digits, count - 1) == 0 {
    count -= 1
  }
  point = point + exponent
  // The sign is on an operand, as in [`parse`]: `0.0 * sign` is the zero
  // with the sign written, and `sign / 0.0` the infinity.
  var sign = 1.0
  if negative {
    sign = -1.0
  }
  if point < -324 {
    return Ok(0.0 * sign)
  }
  if point >= 310 {
    return Ok(sign / 0.0)
  }
  var exp2 = 0
  // Step 1, down: a value of `point` digits before its point is at least
  // `10^(point - 1)`, and `2^s` with `s = floor(point × log2(10))` is at most
  // `10^point`, so the quotient is at least a tenth. At most `2^59`, which is
  // what [`divided`]'s arithmetic has room for.
  while point > 0 {
    var shift = 59
    if point < 18 {
      shift = point * 3321928 / 1000000
    }
    point = point + divided(digits, var count, var truncated, powerOf(2, shift))
    exp2 += shift
  }
  // Step 1, up, to at least a half: `2^s` by dividing by `5^s`, at most
  // `5^25`, which is the largest power of five [`divided`] has room for.
  // The point never passes nought on the way: `2^s` is at most `10^-point`.
  while point <= 0 {
    let depth = -point
    var shift = 25
    if point == 0 {
      if core.vectorLoad(digits, 0) >= 5 {
        break
      }
      shift = 1
      if core.vectorLoad(digits, 0) < 2 {
        shift = 2
      }
    } else if depth < 18 {
      shift = depth * 3321928 / 1000000
      if shift > 25 {
        shift = 25
      }
    }
    let moved = divided(digits, var count, var truncated, powerOf(5, shift))
    point = point + moved + shift
    exp2 -= shift
  }
  // The value is `2 × digits × 2^(exp2 - 1)` with twice the digits in
  // `[1, 2)`: `exp2 - 1` is its binary exponent.
  exp2 -= 1
  // Step 2: a subnormal down to the least normal exponent.
  while exp2 < -1022 {
    var shift = -1022 - exp2
    if shift > 59 {
      shift = 59
    }
    point = point + divided(digits, var count, var truncated, powerOf(2, shift))
    exp2 += shift
  }
  if exp2 >= 1024 {
    return Ok(sign / 0.0)
  }
  // Step 3: fifty-three bits up, as three passes of `5^25`, `5^25` and `5^3`.
  let fiveTo25 = 298023223876953125
  point = point + divided(digits, var count, var truncated, fiveTo25) + 25
  point = point + divided(digits, var count, var truncated, fiveTo25) + 25
  point = point + divided(digits, var count, var truncated, 125) + 3
  var significand = rounded(digits, count, point, truncated)
  if significand >= 9007199254740992 {
    point = point + divided(digits, var count, var truncated, 2)
    exp2 += 1
    significand = rounded(digits, count, point, truncated)
    if exp2 >= 1024 {
      return Ok(sign / 0.0)
    }
  }
  // Step 4: `significand × 2^(exp2 - 52)`, each step exact.
  var value = significand.toFloat()
  var left = exp2 - 52
  while left >= 32 {
    value = value * 4294967296.0
    left -= 32
  }
  while left <= -32 {
    value = value / 4294967296.0
    left += 32
  }
  if left >= 16 {
    value = value * 65536.0
    left -= 16
  } else if left <= -16 {
    value = value / 65536.0
    left += 16
  }
  if left >= 8 {
    value = value * 256.0
    left -= 8
  } else if left <= -8 {
    value = value / 256.0
    left += 8
  }
  if left >= 4 {
    value = value * 16.0
    left -= 4
  } else if left <= -4 {
    value = value / 16.0
    left += 4
  }
  if left >= 2 {
    value = value * 4.0
    left -= 2
  } else if left <= -2 {
    value = value / 4.0
    left += 2
  }
  if left >= 1 {
    value = value * 2.0
  } else if left <= -1 {
    value = value / 2.0
  }
  return Ok(value * sign)
}

/// `base` to the `power`, for the few bases and powers [`parseSlow`] asks.
fn powerOf(base: Int, power: Int) -> Int {
  var result = 1
  var left = power
  while left > 0 {
    result = result * base
    left -= 1
  }
  return result
}

/// The `count` digits of `digits` divided by `divisor`, in place: one pass of
/// long division from the most significant digit, answering how far the
/// decimal point moved.
///
/// The quotient's digits are written over the dividend's as they are made,
/// which is safe because the quotient's first digit is made only once the
/// running remainder reaches the divisor, so a write never overtakes the read.
/// A quotient has more digits than its dividend — the division is exact,
/// because `divisor` is a power of two or of five — and a digit past the 768th
/// is dropped, setting `truncated` when it is not nought. The last digit kept
/// is not nought: zeros at the end are taken off, so that [`rounded`] can tell
/// a `5` that is the last digit from one that is not.
///
/// `divisor` is at most `2^59` or `5^25`, below `9.2 × 10^17`: the running
/// remainder `n` is below `10 × divisor`, so `n` and `n × 10 + 9` are below
/// `2^63` and nothing here can trap.
fn divided(
  digits: Vector<Int>,
  var count: Int,
  var truncated: Bool,
  divisor: Int,
) -> Int {
  var read = 0
  var n = 0
  while n < divisor {
    if read < count {
      n = n * 10 + core.vectorLoad(digits, read)
    } else {
      n = n * 10
    }
    read += 1
  }
  let moved = 1 - read
  var write = 0
  while read < count {
    let quotient = n / divisor
    n = (n - quotient * divisor) * 10 + core.vectorLoad(digits, read)
    read += 1
    core.vectorStore(digits, write, quotient)
    write += 1
  }
  var length = core.vectorLength(digits)
  while n > 0 {
    if write >= 768 {
      // What is left is not nought, so a digit past the 768th is not.
      truncated = true
      break
    }
    let quotient = n / divisor
    n = (n - quotient * divisor) * 10
    if write < length {
      core.vectorStore(digits, write, quotient)
    } else {
      pushLimb(digits, quotient)
      length += 1
    }
    write += 1
  }
  while core.vectorLoad(digits, write - 1) == 0 {
    write -= 1
  }
  count = write
  return moved
}

/// The whole part of the value, rounded to the nearest and to the even one on
/// a tie: [`parseSlow`]'s significand, once `point` is at most seventeen.
///
/// A tie is a `5` directly after the point that is the last digit held, with
/// nothing dropped behind it. A `5` with a digit after it, or with `truncated`
/// set, is past the half and rounds up; that is the flag's whole use.
fn rounded(
  digits: Vector<Int>,
  count: Int,
  point: Int,
  truncated: Bool,
) -> Int {
  if point < 0 {
    return 0
  }
  var whole = 0
  var at = 0
  while at < point {
    whole = whole * 10
    if at < count {
      whole = whole + core.vectorLoad(digits, at)
    }
    at += 1
  }
  if point < count {
    let digit = core.vectorLoad(digits, point)
    if digit > 5 {
      return whole + 1
    }
    if digit == 5 {
      if point + 1 < count {
        return whole + 1
      }
      if truncated {
        return whole + 1
      }
      if whole % 2 == 1 {
        return whole + 1
      }
    }
  }
  return whole
}

// --------------------------------------------------------------- elementary
//
// `exp`, `ln`, `log10`, `sin`, `cos` and `pow` (issue #648, ADR 0098).
//
// They are Cove, built from `+`, `-`, `*`, `/`, comparison, `Int` arithmetic
// and `core.floatTruncate`, and nothing else: no instruction of their own and
// no call into the host's `libm`. IEEE 754 makes each of those operations
// correctly rounded, so a body made of them answers the same bits on every
// machine and on every tier — the interpreter, the encoded VM and the native
// code generator — which a host `libm` does not: the standard leaves a
// transcendental function free to differ in its last bit between two
// implementations, and macOS's and glibc's do (issue #250).
//
// The algorithms are FreeBSD's `msun` (Sun's fdlibm), the ones Rust's `libm`
// crate and musl carried, rewritten where they read or wrote the bits of a
// double. Their notice, which they ask to be kept:
//
//   Copyright (C) 1993, 2004 by Sun Microsystems, Inc. All rights reserved.
//
//   Developed at SunSoft, a Sun Microsystems, Inc. business.
//   Permission to use, copy, modify, and distribute this
//   software is freely granted, provided that this notice
//   is preserved.
//
// What a Cove body has instead of the bits:
//
// - **a comparison against the double whose high word was the test**, where
//   fdlibm compared the high word: `hx > 0x3fd62e42` is
//   `|x| >= 0.3465735912322998`, the decimal that is exactly the double
//   `0x3FD62E4300000000`;
// - **a ladder of exact multiplications by powers of two** where fdlibm read
//   or set an exponent field ([`exponentOf`], [`twoTo`], [`scaled`]);
// - **a Veltkamp split** where fdlibm cleared a low word to make a value with
//   few enough bits that a product of two of them is exact ([`split21`]): the
//   split rounds where clearing truncated, which bounds the part split off by
//   the same amount and keeps every product the algorithm relies on exact;
// - **the addition of `1.5 · 2^52`** for "the nearest whole number", which
//   leaves no fraction to keep and which fdlibm's `rem_pio2` already used;
// - **its own Payne–Hanek reduction** for `sin` and `cos` past `2^20 · π/2`
//   ([`reducedFar`]), over 24-bit `Int` limbs of `2/π`, where fdlibm's
//   `__rem_pio2_large` worked in doubles.
//
// The contract, measured against a 300-bit reference by
// `crates/cove-runtime/tests/float_math.rs`: every answer is within one unit
// in the last place of the exact value — the worst seen in 73,237 rows is
// 0.80, `exp`'s — and none is correctly rounded by promise. The exact
// answers the contract names are exact: `exp(0)`, `ln(1)`, `log10` of every
// normal power of ten, and `pow` of two integers whenever the power is below
// `2^53`.

/// `e` raised to this number: within one unit in the last place. That is a
/// bound and not a rounding: `1.0.exp()` is `2.7182818284590455`, one unit
/// above `2.718281828459045`, the double nearest `e`: the exact `e` is 0.67
/// of a unit from the answer and 0.33 from its neighbour.
///
/// `exp(0.0)` is `1.0` exactly; `NaN` is `NaN`; `inf` is `inf` and `-inf` is
/// `0.0`. Past `709.782712893384` the answer is `inf`, and below
/// `-745.1332191019412` it is `0.0`; between `-745.13` and `-708.4` it is
/// subnormal, rounded once.
///
/// FreeBSD's `e_exp.c`: `x = k·ln2 + r` with `|r| <= ln2/2`, `r` carried as
/// `hi - lo`; a degree-5 Remez fit of `r·(e^r + 1)/(e^r - 1)`; and `2^k` put
/// back by [`scaled`].
export fn exp(x: Float) -> Float {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019411 {
    return 0.0
  }
  let ax = x.abs()
  var fk = 0.0
  var hi = x
  var lo = 0.0
  var r = x
  if ax >= 0.3465735912322998 {
    // `|x| > ln2/2`: `k` is `x/ln2` to the nearest whole number — the
    // addition of `1.5·2^52` leaves no fraction to keep — or one away from
    // nought below `1.5·ln2`, where the quotient is no use.
    if ax >= 1.0397205352783203 {
      fk = (1.4426950408889634 * x + 6755399441055744.0) - 6755399441055744.0
    } else if x < 0.0 {
      fk = -1.0
    } else {
      fk = 1.0
    }
    // `ln2` in two parts, the first with enough trailing zero bits that
    // `k` times it is exact for every `k` this can be.
    hi = x - fk * 0.6931471803691238
    lo = fk * 1.9082149292705877e-10
    r = hi - lo
  } else if ax < 3.725293851175593e-09 {
    // Below `2^-28`, `1 + x` is the answer rounded.
    return 1.0 + x
  }
  let rr = r * r
  let c = r -
    rr *
      (0.16666666666666602 +
        rr *
          (-0.0027777777777015593 +
            rr *
              (6.613756321437934e-05 +
                rr * (-1.6533902205465252e-06 + rr * 4.1381367970572385e-08))))
  let y = 1.0 + (r * c / (2.0 - c) - lo + hi)
  if fk == 0.0 {
    return y
  }
  // The `Int` straight from the `Some` it arrives in, into the call that
  // wants it: a binding of it would be a copy.
  match core.floatTruncate(fk) {
    Some(k) => return scaled(y, k)
    None => return y
  }
}

/// The natural logarithm of this number: within one unit in the last place.
///
/// `ln(1.0)` is `0.0` exactly; `ln(0.0)` and `ln(-0.0)` are `-inf`; a
/// negative number and `-inf` are `NaN`; `inf` is `inf`; `NaN` is `NaN`.
/// Subnormals have logarithms like any other number: `ln(5.0e-324)` is
/// `-744.4400719213812`.
///
/// FreeBSD's `e_log.c`: `x = 2^k·(1 + f)` with `1 + f` in `[√2/2, √2)`, and
/// `ln(1 + f)` from `s = f/(2 + f)` and a degree-14 Remez fit in `s`.
export fn ln(x: Float) -> Float {
  if x != x {
    return x
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return x
  }
  if x == 1.0 {
    return 0.0
  }
  var k = 0
  var v = x
  if v < 2.2250738585072014e-308 {
    v = v * 1.8014398509481984e+16
    k = -54
  }
  let e = exponentOf(v)
  var m = v * twoTo(-e)
  k += e
  if m >= 1.4142131805419922 {
    m = m * 0.5
    k += 1
  }
  let f = m - 1.0
  let hfsq = 0.5 * f * f
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w *
    (0.3999999999940942 + w * (0.22222198432149784 + w * 0.15313837699209373))
  let t2 = z *
    (0.6666666666666735 +
      w *
        (0.2857142874366239 + w * (0.1818357216161805 + w * 0.14798198605116586)))
  let rr = t2 + t1
  let dk = k.toFloat()
  s * (hfsq + rr) + dk * 1.9082149292705877e-10 - hfsq + f +
    dk * 0.6931471803691238
}

/// The base-ten logarithm of this number: within one unit in the last place,
/// and **exact on a power of ten** — `log10(1000.0)` is `3.0`, and so is
/// every power from `1.0e-307` to `1.0e308`.
///
/// The special values are [`ln`]'s: `0.0` and `-0.0` are `-inf`, a negative
/// number is `NaN`, `inf` is `inf`.
///
/// FreeBSD's `e_log10.c`: [`ln`]'s reduction and polynomial, and the sum
/// `k·log10(2) + ln(1 + f)/ln(10)` formed in two parts so that its rounding
/// happens once, at the end.
export fn log10(x: Float) -> Float {
  if x != x {
    return x
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return x
  }
  if x == 1.0 {
    return 0.0
  }
  var k = 0
  var v = x
  if v < 2.2250738585072014e-308 {
    v = v * 1.8014398509481984e+16
    k = -54
  }
  let e = exponentOf(v)
  var m = v * twoTo(-e)
  k += e
  if m >= 1.4142131805419922 {
    m = m * 0.5
    k += 1
  }
  let f = m - 1.0
  let hfsq = 0.5 * f * f
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w *
    (0.3999999999940942 + w * (0.22222198432149784 + w * 0.15313837699209373))
  let t2 = z *
    (0.6666666666666735 +
      w *
        (0.2857142874366239 + w * (0.1818357216161805 + w * 0.14798198605116586)))
  let rr = t2 + t1
  // `ln(1 + f)` as `hi + lo`, `hi` short enough that `hi` times the leading
  // part of `1/ln(10)` is exact.
  let hi = split21(f - hfsq)
  let lo = f - hi - hfsq + s * (hfsq + rr)
  let dk = k.toFloat()
  let y = dk * 0.30102999566361177
  let valHi = hi * 0.4342944818781689
  let valLo = dk * 3.694239077158931e-13 + (lo + hi) * 2.5082946711645275e-11 +
    lo * 0.4342944818781689
  let sum = y + valHi
  (valLo + ((y - sum) + valHi)) + sum
}

/// The sine of this number, in radians: within one unit in the last place, at
/// every magnitude.
///
/// `sin(0.0)` is `0.0` and `sin(-0.0)` is `-0.0`; `NaN`, `inf` and `-inf`
/// are `NaN`. A large argument is reduced exactly rather than approximately,
/// so `sin(1.0e300)` is the sine of the double `1.0e300` names to the last
/// bit, not of some nearby multiple of `π`: whether that number means
/// anything to a program is the program's business, but it is the same
/// number on every machine.
///
/// FreeBSD's `s_sin.c` over its `k_sin.c` and `k_cos.c` kernels, with
/// `e_rem_pio2.c`'s three-part Cody–Waite reduction below `2^20 · π/2` and
/// [`reducedFar`] above it.
export fn sin(x: Float) -> Float {
  let ax = x.abs()
  if ax < 0.7853984832763672 {
    if ax < 1.4901161193847656e-08 {
      return x
    }
    return sinKernel(x, 0.0, false)
  }
  if x != x {
    return x - x
  }
  if ax == 1.0 / 0.0 {
    return x - x
  }
  reduced(x, 0)
}

/// The cosine of this number, in radians: within one unit in the last place,
/// at every magnitude.
///
/// `cos(0.0)` is `1.0`; `NaN`, `inf` and `-inf` are `NaN`. A large argument is
/// reduced exactly, as [`sin`]'s is.
///
/// FreeBSD's `s_cos.c`: [`sin`]'s reduction, a quarter turn on.
export fn cos(x: Float) -> Float {
  let ax = x.abs()
  if ax < 0.7853984832763672 {
    if ax < 1.0536709282860102e-08 {
      return 1.0
    }
    return cosKernel(x, 0.0)
  }
  if x != x {
    return x - x
  }
  if ax == 1.0 / 0.0 {
    return x - x
  }
  reduced(x, 1)
}

/// This number raised to `exponent`, written `y` below: within one unit in the last place, and the
/// exact integer when both are integers and the answer is below `2^53`.
///
/// The special cases are C99's and IEEE 754's `pow`, all of them:
///
/// - `x.pow(0.0)` and `x.pow(-0.0)` are `1.0`, even for a `NaN` `x`, and
///   `1.0.pow(y)` is `1.0` even for a `NaN` `y`; otherwise a `NaN` on either
///   side is `NaN`;
/// - a negative `x` to a power that is not a whole number is `NaN`:
///   `(-8.0).pow(1.0 / 3.0)` is `NaN`, not `-2.0`, because `1.0 / 3.0` is not
///   a third;
/// - a negative `x` to an odd whole power is negative, and to an even one
///   positive;
/// - `0.0` to a positive power is `0.0` and to a negative one `inf`, and
///   `-0.0` keeps its sign on an odd power: `(-0.0).pow(-3.0)` is `-inf`;
/// - `(-1.0).pow(inf)` is `1.0`; a magnitude above one to `inf` is `inf` and
///   below one is `0.0`, and the other way about for `-inf`;
/// - `inf` to a positive power is `inf` and to a negative one `0.0`, and
///   `-inf` is `-0.0` or `-inf` on an odd power.
///
/// FreeBSD's `e_pow.c`: `log2(x)` to about 74 bits in two parts, multiplied
/// by `y` in extra precision, split into a whole number and a fraction of at
/// most a half, and `2^fraction` from `exp`'s polynomial.
export fn pow(x: Float, exponent: Float) -> Float {
  let y = exponent
  if y == 0.0 {
    return 1.0
  }
  if x == 1.0 {
    return 1.0
  }
  if x != x {
    return x + y
  }
  if y != y {
    return x + y
  }
  let ax = x.abs()
  let ay = y.abs()
  let infinity = 1.0 / 0.0
  // The sign bit, which `x < 0.0` cannot see on a negative zero.
  var negative = x < 0.0
  if x == 0.0 {
    negative = 1.0 / x < 0.0
  }
  // Whether `y` is an odd whole number (1), an even one (2) or neither (0),
  // asked only where it decides a sign: every `Float` from `2^53` up is even.
  var whole = 0
  if negative {
    if ay >= 9007199254740992.0 {
      whole = 2
    } else if ay >= 1.0 {
      if ay.round() == ay {
        let half = ay * 0.5
        whole = 1
        if half.round() == half {
          whole = 2
        }
      }
    }
  }
  if ay == infinity {
    if ax == 1.0 {
      return 1.0
    }
    if ax > 1.0 {
      if y > 0.0 {
        return y
      }
      return 0.0
    }
    if y > 0.0 {
      return 0.0
    }
    return -y
  }
  if ay == 1.0 {
    if y > 0.0 {
      return x
    }
    return 1.0 / x
  }
  if y == 2.0 {
    return x * x
  }
  if y == 0.5 {
    if !negative {
      return x.sqrt()
    }
  }
  if ax == infinity || ax == 0.0 || ax == 1.0 {
    var z = ax
    if y < 0.0 {
      z = 1.0 / z
    }
    if negative {
      if ax == 1.0 && whole == 0 {
        return 0.0 / 0.0
      }
      if whole == 1 {
        return -z
      }
    }
    return z
  }
  var sign = 1.0
  if negative {
    if whole == 0 {
      return 0.0 / 0.0
    }
    if whole == 1 {
      sign = -1.0
    }
  }
  // `log2(|x|)` as `t1 + t2`, `t1` short.
  var t1 = 0.0
  var t2 = 0.0
  if ay >= 2147485696.0 {
    // `|y|` past `2^31`: anything not within `2^-20` of one overflows or
    // underflows, and past `2^64` everything does.
    if ay >= 1.8446761665895596e+19 {
      if ax < 1.0 {
        if y < 0.0 {
          return infinity
        }
        return 0.0
      }
      if y > 0.0 {
        return infinity
      }
      return 0.0
    }
    if ax < 0.9999995231628418 {
      if y < 0.0 {
        return sign * infinity
      }
      return sign * 0.0
    }
    if ax >= 1.0000009536743164 {
      if y > 0.0 {
        return sign * infinity
      }
      return sign * 0.0
    }
    // `|1 - x|` is at most `2^-20`, so `log(x)` is `t - t²/2 + t³/3 - t⁴/4`
    // to well past the precision needed. The leading product is taken
    // exactly ([`productError`]), which fdlibm's was not: it had one bit too
    // many for that, and at `y` near `2^32` that bit was 200 units in the
    // last place of the answer.
    let t = ax - 1.0
    let w = (t * t) * (0.5 - t * (0.3333333333333333 - t * 0.25))
    let u = 1.4426950216293335 * t
    let v = t * 1.9259629911266175e-08 - w * 1.4426950408889634 +
      productError(1.4426950216293335, t, u)
    t1 = split21(u + v)
    t2 = v - (t1 - u)
  } else {
    var n = 0
    var a = ax
    if a < 2.2250738585072014e-308 {
      a = a * 9007199254740992.0
      n = -53
    }
    let e = exponentOf(a)
    a = a * twoTo(-e)
    n += e
    // `a` in `[1, 2)`, and against `1` below `√(3/2)`, against `1.5` below
    // `√3`, and halved against `1` above it.
    var bp = 1.0
    var dpHi = 0.0
    var dpLo = 0.0
    if a >= 1.7320499420166016 {
      n += 1
      a = a * 0.5
    } else if a >= 1.2247447967529297 {
      bp = 1.5
      dpHi = 0.5849624872207642
      dpLo = 1.350039202129749e-08
    }
    // `ss = sHi + sLo = (a - bp)/(a + bp)`.
    let u = a - bp
    let v = 1.0 / (a + bp)
    let ss = u * v
    let sHi = split21(ss)
    var tHi = split21(a + bp)
    var tLo = a - (tHi - bp)
    let sLo = v * ((u - sHi * tHi) - sHi * tLo)
    // `log(a)`.
    var s2 = ss * ss
    var rr = s2 * s2 *
      (0.5999999999999946 +
        s2 *
          (0.4285714285785502 +
            s2 *
              (0.33333332981837743 +
                s2 *
                  (0.272728123808534 +
                    s2 * (0.23066074577556175 + s2 * 0.20697501780033842)))))
    rr += sLo * (sHi + ss)
    s2 = sHi * sHi
    tHi = split21(3.0 + s2 + rr)
    tLo = rr - ((tHi - 3.0) - s2)
    // `u2 + v2 = ss·(1 + …)`.
    let u2 = sHi * tHi
    let v2 = sLo * tHi + tLo * ss
    // `2/(3·ln2)·(ss + …)`.
    let pHi = split21(u2 + v2)
    let pLo = v2 - (pHi - u2)
    let zHi = 0.9617967009544373 * pHi
    let zLo = -7.028461650952758e-09 * pHi + pLo * 0.9617966939259756 + dpLo
    // `log2(a) = n + dpHi + zHi + zLo`.
    let whole2 = n.toFloat()
    t1 = split21(((zHi + zLo) + dpHi) + whole2)
    t2 = zLo - (((t1 - whole2) - dpHi) - zHi)
  }
  // `y·log2(|x|)` as `pHi + pLo`: `y` split so that `y1·t1` is exact.
  let y1 = split21(y)
  let pLo = (y - y1) * t1 + y * t2
  var pHi = y1 * t1
  let z = pLo + pHi
  if z >= 1024.0 {
    if z > 1024.0 {
      return sign * infinity
    }
    if pLo + 8.008566259537294e-17 > z - pHi {
      return sign * infinity
    }
  } else if z <= -1075.0 {
    if z < -1075.0 {
      return sign * 0.0
    }
    if pLo <= z - pHi {
      return sign * 0.0
    }
  }
  // `z = n + fraction`, `|fraction| <= 1/2`, and `2^fraction`.
  var turns = 0.0
  if z.abs() > 0.5 {
    turns = z.round()
    pHi = pHi - turns
  }
  let t = split21(pLo + pHi)
  let u = t * 0.6931471824645996
  let v = (pLo - (t - pHi)) * 0.6931471805599453 + t * (-1.904654299957768e-09)
  let zz = u + v
  let w = v - (zz - u)
  let tt = zz * zz
  let c = zz -
    tt *
      (0.16666666666666602 +
        tt *
          (-0.0027777777777015593 +
            tt *
              (6.613756321437934e-05 +
                tt * (-1.6533902205465252e-06 + tt * 4.1381367970572385e-08))))
  let rr = (zz * c) / (c - 2.0) - (w + zz * w)
  let fraction = 1.0 - (rr - zz)
  match core.floatTruncate(turns) {
    Some(n) => return sign * scaled(fraction, n)
    None => return sign * fraction
  }
}

/// `y · 2^k` rounded once, for a `y` near one and `k` from about `-1100` to
/// `2100`: one exact product and, where the answer is subnormal or past
/// `2^1023`, a second that does the rounding.
fn scaled(y: Float, k: Int) -> Float {
  if k > 1023 {
    return y * 8.98846567431158e+307 * twoTo(k - 1023)
  }
  if k < -1022 {
    // `2^-969` keeps `y` normal and the product exact; the second product is
    // the one rounding.
    return y * 2.004168360008973e-292 * twoTo(k + 969)
  }
  y * twoTo(k)
}

/// `2^k`, exactly, for `k` from `-1022` to `1023`: at most five exact products
/// or quotients by `2^512` down to `2^32`, and a shifted `Int` for the rest.
fn twoTo(k: Int) -> Float {
  var v = 1.0
  var left = k
  if left >= 0 {
    if left >= 512 {
      v = v * 1.3407807929942597e+154
      left -= 512
    }
    if left >= 256 {
      v = v * 1.157920892373162e+77
      left -= 256
    }
    if left >= 128 {
      v = v * 3.402823669209385e+38
      left -= 128
    }
    if left >= 64 {
      v = v * 1.8446744073709552e+19
      left -= 64
    }
    if left >= 32 {
      v = v * 4294967296.0
      left -= 32
    }
    return v * 1.shiftLeft(left).toFloat()
  }
  left = -left
  if left >= 512 {
    v = v / 1.3407807929942597e+154
    left -= 512
  }
  if left >= 256 {
    v = v / 1.157920892373162e+77
    left -= 256
  }
  if left >= 128 {
    v = v / 3.402823669209385e+38
    left -= 128
  }
  if left >= 64 {
    v = v / 1.8446744073709552e+19
    left -= 64
  }
  if left >= 32 {
    v = v / 4294967296.0
    left -= 32
  }
  v / 1.shiftLeft(left).toFloat()
}

/// The `k` for which `x · 2^-k` is in `[1, 2)`, for a positive normal `x`:
/// ten comparisons, each halving what is left of the exponent's range.
fn exponentOf(x: Float) -> Int {
  var v = x
  var k = 0
  if v >= 2.0 {
    if v >= 1.3407807929942597e+154 {
      v = v / 1.3407807929942597e+154
      k += 512
    }
    if v >= 1.157920892373162e+77 {
      v = v / 1.157920892373162e+77
      k += 256
    }
    if v >= 3.402823669209385e+38 {
      v = v / 3.402823669209385e+38
      k += 128
    }
    if v >= 1.8446744073709552e+19 {
      v = v / 1.8446744073709552e+19
      k += 64
    }
    if v >= 4294967296.0 {
      v = v / 4294967296.0
      k += 32
    }
    if v >= 65536.0 {
      v = v / 65536.0
      k += 16
    }
    if v >= 256.0 {
      v = v / 256.0
      k += 8
    }
    if v >= 16.0 {
      v = v / 16.0
      k += 4
    }
    if v >= 4.0 {
      v = v / 4.0
      k += 2
    }
    if v >= 2.0 {
      k += 1
    }
    return k
  }
  if v < 1.0 {
    // Doubled by `2^s` while below `2^(1-s)`, which leaves it in `[1, 2)`.
    if v < 1.4916681462400413e-154 {
      v = v * 1.3407807929942597e+154
      k -= 512
    }
    if v < 1.727233711018889e-77 {
      v = v * 1.157920892373162e+77
      k -= 256
    }
    if v < 5.877471754111438e-39 {
      v = v * 3.402823669209385e+38
      k -= 128
    }
    if v < 1.0842021724855044e-19 {
      v = v * 1.8446744073709552e+19
      k -= 64
    }
    if v < 4.656612873077393e-10 {
      v = v * 4294967296.0
      k -= 32
    }
    if v < 3.0517578125e-05 {
      v = v * 65536.0
      k -= 16
    }
    if v < 0.0078125 {
      v = v * 256.0
      k -= 8
    }
    if v < 0.125 {
      v = v * 16.0
      k -= 4
    }
    if v < 0.5 {
      v = v * 4.0
      k -= 2
    }
    if v < 1.0 {
      k -= 1
    }
  }
  return k
}

/// `v` rounded to 21 significant bits, by Veltkamp's split with `2^32 + 1`:
/// a product of two such values has at most 42 bits and is exact.
fn split21(v: Float) -> Float {
  let c = v * 4294967297.0
  c - (c - v)
}

/// `a · b - p`, exactly, where `p` is `a · b` rounded: Dekker's product, with
/// each factor split into two 26-bit halves.
fn productError(a: Float, b: Float, p: Float) -> Float {
  let ca = a * 134217729.0
  let aHi = ca - (ca - a)
  let aLo = a - aHi
  let cb = b * 134217729.0
  let bHi = cb - (cb - b)
  let bLo = b - bHi
  ((aHi * bHi - p) + aHi * bLo + aLo * bHi) + aLo * bLo
}

/// `sin` or `cos` of an `x` past `π/4`: `x` reduced to `n·π/2 + y0 + y1`
/// and the kernel the quarter turn `n + shift` names. `shift` is `0` for the
/// sine and `1` for the cosine, which is the sine a quarter turn on.
fn reduced(x: Float, shift: Int) -> Float {
  if x.abs() >= 1647099.0 {
    return reducedFar(x, shift)
  }
  // `n` is `x·2/π` to the nearest whole number, by the addition of
  // `1.5·2^52` that leaves no fraction to keep; `π/2` is three 33-bit parts
  // and their tails, and the second and third are taken only when the first
  // cancelled enough of `x` to need them.
  let turns = (x * 0.6366197723675814 + 6755399441055744.0) - 6755399441055744.0
  var r = x - turns * 1.5707963267341256
  var w = turns * 6.077100506506192e-11
  var y0 = r - w
  let ax = x.abs()
  if y0.abs() * 65536.0 < ax {
    let t = r
    w = turns * 6.077100506303966e-11
    r = t - w
    w = turns * 2.0222662487959506e-21 - ((t - r) - w)
    y0 = r - w
    if y0.abs() * 562949953421312.0 < ax {
      let t3 = r
      w = turns * 2.0222662487111665e-21
      r = t3 - w
      w = turns * 8.4784276603689e-32 - ((t3 - r) - w)
      y0 = r - w
    }
  }
  let y1 = (r - y0) - w
  match core.floatTruncate(turns) {
    Some(n) => return quarter(n + shift, y0, y1)
    None => return y0
  }
}

/// The sine of `n·π/2 + y0 + y1`, for `|y0 + y1|` at most about `π/4`.
fn quarter(n: Int, y0: Float, y1: Float) -> Float {
  let q = n.bitAnd(3)
  if q == 0 {
    return sinKernel(y0, y1, true)
  }
  if q == 1 {
    return cosKernel(y0, y1)
  }
  if q == 2 {
    return -sinKernel(y0, y1, true)
  }
  -cosKernel(y0, y1)
}

/// `sin(x + y)` for `|x + y| <= π/4` and `|y|` below half a unit of `x`:
/// FreeBSD's `k_sin.c`, a degree-13 odd polynomial. `tail` says whether `y`
/// is there at all.
fn sinKernel(x: Float, y: Float, tail: Bool) -> Float {
  let z = x * x
  let w = z * z
  let r = 0.00833333333332249 +
    z * (-0.00019841269829857949 + z * 2.7557313707070068e-06) +
    z * w * (-2.5050760253406863e-08 + z * 1.58969099521155e-10)
  let v = z * x
  if !tail {
    return x + v * (-0.16666666666666632 + z * r)
  }
  x - ((z * (0.5 * y - v * r) - y) - v * (-0.16666666666666632))
}

/// `cos(x + y)` for `|x + y| <= π/4`: FreeBSD's `k_cos.c`, a degree-14 even
/// polynomial with `1 - x²/2` formed so that its rounding is recovered.
fn cosKernel(x: Float, y: Float) -> Float {
  let z = x * x
  let w = z * z
  let r = z *
    (0.0416666666666666 +
      z * (-0.001388888888887411 + z * 2.480158728947673e-05)) +
    w * w *
      (-2.7557314351390663e-07 +
        z * (2.087572321298175e-09 + z * (-1.1359647557788195e-11)))
  let hz = 0.5 * z
  let one = 1.0 - hz
  one + (((1.0 - one) - hz) + (z * r - x * y))
}

/// `sin` or `cos` of an `x` of magnitude `2^20 · π/2` or more, reduced by
/// Payne and Hanek's method in whole numbers.
///
/// `|x|` is `M · 2^E` for a 53-bit `M`, and `2/π` is `Σ c_i · 2^(-24i)` for
/// the 24-bit digits [`twoOverPi`] reads. `|x| · 2/π` is then a sum of
/// `m_j · c_i · 2^(E + 24j - 24i)` over `M`'s three 24-bit digits `m_j`, and
/// every term whose weight is a multiple of four is a whole number of turns
/// and is left out: what is computed is eight 24-bit limbs below that, about
/// 190 bits of which at least 166 are fraction. The closest a double comes to
/// a multiple of `π/2` is about `2^-61` of a quarter turn, so that leaves more
/// than a hundred bits of the reduced argument after the worst cancellation
/// there is. The quarter turn is the whole part's low two bits, and the
/// fraction is gathered into two doubles and multiplied by `π/2` in two parts.
fn reducedFar(x: Float, shift: Int) -> Float {
  let ax = x.abs()
  let e = exponentOf(ax)
  match core.floatTruncate(ax * twoTo(52 - e)) {
    Some(big) => return payneHanek(x, shift, big, e - 52)
    None => return x - x
  }
}

/// [`reducedFar`]'s reduction of `x`, whose magnitude is `big · 2^exponent`
/// with `big` a 53-bit whole number.
fn payneHanek(x: Float, shift: Int, big: Int, exponent: Int) -> Float {
  let m0 = big.bitAnd(16777215)
  let m1 = big.shiftRight(24).bitAnd(16777215)
  let m2 = big.shiftRight(48)
  // The first limb whose weight is below four, so that its weight `2^s` has
  // `s` from `-22` to `1`: `exponent` is at least `-32`, and `+ 48` keeps the
  // quotient's operand positive so that `/` is the floor.
  let first = (exponent - 2 + 48) / 24 - 1
  let s = exponent - 24 * first
  // The ten digits of `2/π` the eight limbs are made of, each read once.
  let c0 = twoOverPi(first)
  let c1 = twoOverPi(first + 1)
  let c2 = twoOverPi(first + 2)
  let c3 = twoOverPi(first + 3)
  let c4 = twoOverPi(first + 4)
  let c5 = twoOverPi(first + 5)
  let c6 = twoOverPi(first + 6)
  let c7 = twoOverPi(first + 7)
  let c8 = twoOverPi(first + 8)
  let c9 = twoOverPi(first + 9)
  var d0 = m0 * c0 + m1 * c1 + m2 * c2
  var d1 = m0 * c1 + m1 * c2 + m2 * c3
  var d2 = m0 * c2 + m1 * c3 + m2 * c4
  var d3 = m0 * c3 + m1 * c4 + m2 * c5
  var d4 = m0 * c4 + m1 * c5 + m2 * c6
  var d5 = m0 * c5 + m1 * c6 + m2 * c7
  var d6 = m0 * c6 + m1 * c7 + m2 * c8
  var d7 = m0 * c7 + m1 * c8 + m2 * c9
  // Carries, from the least significant up; what leaves `d0` is a multiple of
  // four turns.
  d6 += d7.shiftRight(24)
  d7 = d7.bitAnd(16777215)
  d5 += d6.shiftRight(24)
  d6 = d6.bitAnd(16777215)
  d4 += d5.shiftRight(24)
  d5 = d5.bitAnd(16777215)
  d3 += d4.shiftRight(24)
  d4 = d4.bitAnd(16777215)
  d2 += d3.shiftRight(24)
  d3 = d3.bitAnd(16777215)
  d1 += d2.shiftRight(24)
  d2 = d2.bitAnd(16777215)
  d0 += d1.shiftRight(24)
  d1 = d1.bitAnd(16777215)
  d0 = d0.bitAnd(16777215)
  // The quarter turn, and `d0` reduced to its fraction. At `s = 1` the bit of
  // weight one is the top of `d1`.
  var q = 0
  if s > 0 {
    q = (d0 * 2 + d1.shiftRight(23)).bitAnd(3)
    d1 = d1.bitAnd(8388607)
    d0 = 0
  } else {
    q = d0.shiftRight(-s).bitAnd(3)
    d0 = d0.bitAnd(1.shiftLeft(-s) - 1)
  }
  // The fraction as `hi + lo`, summed from the least significant limb, each
  // limb exact and each addition's error kept. A limb's weight is the one
  // below it times `2^24`, which is exact.
  var weight = twoTo(s - 168)
  var hi = d7.toFloat() * weight
  var lo = 0.0
  weight = weight * 16777216.0
  var part = d6.toFloat() * weight
  var sum = part + hi
  var back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d5.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d4.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d3.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d2.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d1.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  weight = weight * 16777216.0
  part = d0.toFloat() * weight
  sum = part + hi
  back = sum - part
  lo = lo + ((part - (sum - back)) + (hi - back))
  hi = sum
  sum = hi + lo
  lo = lo - (sum - hi)
  hi = sum
  // A fraction of a half or more is the next quarter turn less something.
  if hi >= 0.5 {
    hi = hi - 1.0
    q += 1
    sum = hi + lo
    lo = lo - (sum - hi)
    hi = sum
  }
  // Times `π/2`, which is `1.5707963267948966 + 6.123233995736766e-17`.
  let p = hi * 1.5707963267948966
  let err = productError(hi, 1.5707963267948966, p) +
    (hi * 6.123233995736766e-17 + lo * 1.5707963267948966)
  let y0 = p + err
  let y1 = err - (y0 - p)
  let value = quarter(q + shift, y0, y1)
  if x < 0.0 && shift == 0 {
    return -value
  }
  return value
}

/// The `i`th 24-bit digit of `2/π` after the point, counting from one, and
/// nought for an `i` before the point.
///
/// The digits are one string literal, four bytes a digit, each byte six bits
/// offset by `'0'` — the encoding [`eiselLemire`]'s table uses, and the same
/// digits as fdlibm's `ipio2`. Fifty-six of them are enough for every finite
/// `Float`: [`reducedFar`] reads at most nine past the one a value's exponent
/// starts it at, which is at most the forty-first.
fn twoOverPi(i: Int) -> Int {
  if i < 1 {
    return 0
  }
  let table = "X_V3KTi45BWl9eOAmCCM`=]RUITl@i11oU5SZmjkaF6g96hj@TgBh0I9;^X9dI8LoQg[7;4YYckXPSGe;[]4Q>VLL2JdGgi1>I7F>H=C>OBLQ5n;_OTX>aohUooN1IP?kblAReX:KAm]=Wk?9l\\9]dm6?fJNGnX]MBNjan_UlG\\m1cWgRU:BjV_kGk4OSEd8EP<`A_akJj_`ck`PV_@f7JWSTF5NiQ\\8"
  let at = (i - 1) * 4
  ((table.byteAt(at) * 64 + table.byteAt(at + 1)) * 64 + table.byteAt(at + 2)) *
    64 + table.byteAt(at + 3) - 12782640
}
