// HTML: markup with an expression in every hole, and one way past escaping.
//
// A page is a string literal tagged `html`, and **the type of what goes in a
// hole decides whether it is escaped**: an `Html` goes in whole because it is
// already markup, an `Array<Html>` goes in element by element, and everything
// else is rendered as a plain literal renders it and then escaped. The
// literal's value is an `Html`, so a page is built out of pages.
// [ADR 0101](../../../docs/adr/0101-a-page-is-markup-with-an-expression-in-every-hole.md)
// is the record of that, and of the template notation it replaced
// ([ADR 0099](../../../docs/adr/0099-a-page-is-markup-with-a-path-in-every-erb-tag.md)).
//
// ```cove
// use std.html
// use std.html.Html
//
// fn row(line: Line) -> Html {
//   html"""
//     <tr>
//       <td class=at>{line.at}</td>
//       <td>{line.said}</td>
//     </tr>
//     """
// }
//
// fn table(lines: Array<Line>) -> Html {
//   html"<table>{lines.map(fn(line) { row(line) })}</table>"
// }
// ```
//
// A line break in a multi-line `html"""` is spacing
// ([ADR 0103](../../../docs/adr/0103-in-html-a-line-break-is-spacing.md)):
// nothing between a tag or hole and a tag or hole, one space anywhere else,
// so the row above is `<tr><td class=at>…</td><td>…</td></tr>`. The lexer
// decides it from the characters either side of the break; nothing here, and
// nothing in the compiler, reads the markup.
//
// # Where the decision is made
//
// Not here, and not at run time. A hole is an ordinary Cove expression, so
// the checker checks it — `{line.att}` is a compile error at the hole, as it
// would be anywhere else — and the type it settles is what the lowering
// branches on, once, when the literal is lowered. Nothing inspects a value's
// shape while the page is being built. What this module supplies is what
// each branch *does*: [`appendEscaped`] for text, [`appendMarkup`] and
// [`appendEach`] for markup, and [`assembled`] for the finished literal.
// `cove_sema::stdlib::LiteralTag` names those four and is the only thing
// that does; none of them is exported, because nothing but a literal's
// assembly calls them.
//
// The literal text between the holes is the template's own characters, so
// it goes in as written and is not escaped.
//
// # The one way past escaping
//
// `Html` is `opaque`, which is the whole of its safety. The only values of
// it are ones an `html"…"` literal assembled and ones [`markup`] was told
// about, so `markup` is the single way text reaches a page unescaped — one
// name for a review to grep for. That is Rails' arrangement — a
// `SafeBuffer` goes in whole, a `String` is escaped, `raw` is the opt-out —
// with the opt-out made a name that has to be imported, and the type made
// one that no method call can conjure out of a `String`.
//
// What this module is not: a template language. A hole holds one
// expression, so a condition is an `if` expression and a list is a `map`;
// a loop stays in Cove. There is no element tree either: `<td class=at>` is
// written as `<td class=at>`, not translated into a call. And nothing here
// serves a page — `page.render()` hands back the text, and what is done with
// it belongs to whatever is serving.
//
// # Nothing, lists, and the text
//
// No markup is `html""`: the literal with nothing in it is the value a page
// puts where a part is absent, and `page == html""` asks whether a part is
// there, because `==` is structural for `Html` as for every type. A list
// goes in a hole as an `Array<Html>`, one element after another;
// [`join`] puts markup between them — `html.join(links, html" · ")`. And
// `page.render()` is the one way out, as [`markup`] is the one way in.
// [ADR 0102](../../../docs/adr/0102-a-short-literal-may-be-three-quoted-on-one-line-and-markup-joins.md)
// is the record of those three, and of the one-line `"""` literal a fragment
// holding a quote is written as:
//
// ```cove
// html"""<a href="{at}/kv">{name}</a>"""
// html""" class="is-{level}""""
// ```
//
// # What escaping does not cover
//
// One rule — five characters to entities — applies wherever a hole sits.
// That is right between tags and inside a quoted attribute value. It is not
// enough inside an unquoted attribute value, inside `<script>` or `<style>`,
// or for a URL whose scheme is the danger; ADR 0101 leaves those open.

use std.stringbuilder

/// A piece of markup: text an `html"…"` literal puts in whole rather than
/// escape.
///
/// It is `opaque`, so the only values of it are ones a literal assembled and
/// ones [`markup`] was told about.
export opaque struct Html {
  /// The markup, as it will be written.
  said: String
}

/// Markup that was written by hand, taken at its word.
///
/// **This is the one way past escaping**, so what it is given has to be markup
/// already — a constant in the program, or text some other markup produced.
/// Text that came from outside the program goes into a hole of an `html"…"`
/// literal, where it is escaped because its type is not this one.
export fn markup(said: String) -> Html {
  Html(said: said)
}

impl Html {
  /// The text of a page: `page.render()`.
  ///
  /// The one way out, as [`markup`] is the one way in. Everything between the
  /// two is `Html`, so nothing in the middle of building a page is a `String`
  /// that somebody might concatenate unescaped. There is nothing for it to
  /// refuse: every hole was checked by the checker when the page was
  /// compiled.
  ///
  /// It is a method rather than a function of this module, [ADR 0102], so
  /// that a test reads left to right:
  /// `steps(at).render().contains("<b>the last day</b>")`.
  ///
  /// [ADR 0102]: ../../../docs/adr/0102-a-short-literal-may-be-three-quoted-on-one-line-and-markup-joins.md
  export fn render(self) -> String {
    self.said
  }
}

/// `parts` one after another with `between` between each two of them, and
/// nothing in front of the first or after the last: the `" · ".join(…)` of
/// markup, [ADR 0102].
///
/// No parts is no markup, and one part is that part.
///
/// [ADR 0102]: ../../../docs/adr/0102-a-short-literal-may-be-three-quoted-on-one-line-and-markup-joins.md
export fn join(parts: Array<Html>, between: Html) -> Html {
  Html(said: between.said.join(parts.map(fn(part) {
    part.said
  })))
}

/// Appends `text` to `buffer` with the five characters that mean something
/// to a parser written as entities: an `html"…"` literal's hole that is not
/// markup.
///
/// `&` is among them because the others are written with one. `"` and `'`
/// are, and not only `<` and `>`, because a hole is as likely to be an
/// attribute's value as it is to be between tags, and `<a title="{said}">`
/// has to hold a quote without ending the attribute.
///
/// Nothing is copied until the first character that needs an entity: the run
/// in front of it goes in as one append, and so does whatever is left at the
/// end — which for most text is all of it.
fn appendEscaped(buffer: ByteBuffer, text: String) {
  let end = text.byteLength()
  var at = 0
  var copied = 0
  while at < end {
    let named = entity(text.byteAt(at))
    if named != "" {
      stringbuilder.appendRange(buffer, text, copied, at)
      stringbuilder.appendText(buffer, named)
      copied = at + 1
    }
    at = at + 1
  }
  stringbuilder.appendRange(buffer, text, copied, end)
}

/// The entity `byte` is written as, or `""` where it is written as itself.
fn entity(byte: Int) -> String {
  if byte == '&' {
    return "&amp;"
  }
  if byte == '<' {
    return "&lt;"
  }
  if byte == '>' {
    return "&gt;"
  }
  if byte == '"' {
    return "&quot;"
  }
  if byte == 39 {
    return "&#39;"
  }
  ""
}

/// Appends `piece`'s markup to `buffer` as it is: an `html"…"` literal's
/// hole whose type is `Html`.
fn appendMarkup(buffer: ByteBuffer, piece: Html) {
  stringbuilder.appendText(buffer, piece.said)
}

/// Appends every one of `pieces` to `buffer` in order, each as it is: an
/// `html"…"` literal's hole whose type is `Array<Html>`.
///
/// An empty array puts in nothing, because no rows is no markup.
fn appendEach(buffer: ByteBuffer, pieces: Array<Html>) {
  for piece in pieces {
    stringbuilder.appendText(buffer, piece.said)
  }
}

/// The finished text of an `html"…"` literal, as the markup it is.
///
/// What the literal answers. It is [`markup`] under another name, and it is
/// not exported so that `markup` stays the one name a program writes to put
/// text in unescaped.
fn assembled(said: String) -> Html {
  Html(said: said)
}
