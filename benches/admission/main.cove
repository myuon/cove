use console.println
use clock.now

/// What a layout-directed **key admission** costs as a walk the lowering wrote
/// against what it cost as one call into a walk written in Rust.
///
/// [ADR 0064](../../docs/adr/0064-an-intrinsic-names-a-machine-not-a-method.md)'s
/// Decision 3 makes `core.admitKey` on a key whose layout says which of its
/// values are keys a **function lowering synthesizes for that layout**, where
/// it was one `Inst::IntrinsicCall` of `Value.admitKey` reaching `key::admits`
/// in the runtime. `benches/equals` and `benches/ordering` are this package's
/// siblings, written for the same migration's first two operations; this is
/// the third. A package beside them rather than a row inside one, so that
/// their published numbers keep the code layout they were measured under.
///
/// # Why every row is a lookup, and what that makes the difference
///
/// `core.*` is reserved to the standard library, so a Cove program cannot ask
/// the admission anything directly. What it can do is ask a `Set`, whose
/// `contains` admits the element and then binary-searches for it. So one turn
/// here is **one `Set.contains` over eight members**, which is one
/// `Value.admitKey` — the operation this change moves — and three
/// `core.order`s, which it does not: the order became a walk in the migration
/// before this one and is the same code in both builds. The *difference*
/// between the two binaries is therefore the admission and nothing else.
///
/// # The two arms are two binaries over one source
///
/// `benches/ordering`'s arrangement, for its reason: after the migration a
/// program cannot ask for the intrinsic, because nothing in the language names
/// it. So this file is run twice over the same bytes — once by a `cove` built
/// at the migration's parent and once by a `cove` built after it.
///
/// # Three of the rows are controls, and each controls something different
///
/// - `int` is a key **no value of which is ever refused**. `lower::synth`'s
///   `admission` answers `Always` for it and `core.admitKey` emits *nothing at
///   all*, in both builds. It is the shape `covefmt` and `cq` have — every key
///   either program uses is a `String` or an `Int` — and a synthesis that made
///   a function for every key would show up here as the one regression this
///   change could cause. It moves by nothing if the short circuit still fires.
/// - `boxed` is a `Set<dyn Tagged>`, whose element layout is Decision 4's one
///   dynamic-layout fallback: its family is a word in its own header and no
///   walk can be composed for it, so it reaches `Value.admitKey` in **both**
///   builds. It is the rebuild control — the same operation over the same
///   bytes on both sides — and it is also the row that says the fallback is
///   still reached, because a rule that nothing may use the intrinsic is
///   satisfied by deleting the arm. Since ADR 0068's Phase 3b it is no longer
///   a control: a boxed element is decided by `std.dynamic.refusesKey`, Cove
///   over a view of the box, and the intrinsic under the branch on its answer
///   is reached only by a refused key — so an admitting run like this one
///   reaches `Value.admitKey` on no turn, and this row measures the Cove walk.
/// - `deep` is a value type that reaches itself. A walk composed out of a
///   layout that holds itself would not be finite, so `admission` answers
///   `Dynamic` and this one reaches the intrinsic in both builds too — and it
///   is the row that says the runtime's depth bound still governs the values
///   that could reach it. (That bound is gone since ADR 0068's Phase 3b; the
///   runtime's walk is a loop over a stack, and this row still reaches it.)
///
/// # What the rows are, and why these
///
/// Every one of them holds a `Mark`, and `Mark` is the whole point: its
/// `Weight` case holds a `Float`, so whether a `Mark` may be a key is decided
/// by the *value* and not by the type, and the admission has to read a
/// discriminant to answer. No member of any set here is in that case, so every
/// probe is admitted and the run never stops — which is what makes this a
/// measurement of the admitting path, the only path a program that works ever
/// takes.
///
/// - `mark`, the enum itself: one `switch` into three arms, of which two are
///   empty.
/// - `holder`, a struct whose middle field is one: the same `switch` reached
///   through a static word offset, with two fields either side that cost
///   nothing.
/// - `array`, eight of them: a loop, walked to the end, which is where a walk
///   written in Cove is most exposed against a loop written in Rust.
/// - `entries`, a `Map<Int, Mark>`: a loop over the *values* of the entries at
///   the entry layout's width, since a map's keys are keys by construction.
///
/// Every set is eight members and every probe **is** a member, so the search
/// runs its full three steps rather than stopping early on a miss.
///
/// # The loops are in callees, and they are padded
///
/// `benches/ordering`'s arrangement and `benches/equals`' before it: the
/// outermost frame is always encoded, so a loop written in `main` is a VM
/// measurement even under `--backend native`. Each row is a call to a counting
/// callee whose body is the loop, and every counting callee opens with
/// [`ballast`] — a block the parameter's sign makes unreachable and nothing can
/// fold away, sized past `cove_ir::lower::inline`'s `HOT_LIMIT` of forty-eight
/// — so that it is not expanded into [`Row`]'s maker.
fn turns() -> Int {
  50000
}

/// Instructions a counting callee carries so that it is not expanded into its
/// caller, which the native tier refuses for the `now()` in it.
///
/// `rounds` is never negative at any call site, so none of this runs; nothing
/// in the lowering can prove that, so none of it is folded away either.
fn ballast(rounds: Int) -> Int {
  var dead = 0
  if rounds < 0 {
    dead = dead + 1
    dead = dead + 2
    dead = dead + 3
    dead = dead + 4
    dead = dead + 5
    dead = dead + 6
    dead = dead + 7
    dead = dead + 8
    dead = dead + 9
    dead = dead + 10
    dead = dead + 11
    dead = dead + 12
    dead = dead + 13
    dead = dead + 14
    dead = dead + 15
    dead = dead + 16
    dead = dead + 17
    dead = dead + 18
    dead = dead + 19
    dead = dead + 20
    dead = dead + 21
    dead = dead + 22
    dead = dead + 23
    dead = dead + 24
  }
  dead
}

/// Three cases, of which exactly one holds a value the language refuses as a
/// key.
///
/// So `Mark.Plain` and `Mark.Count(3)` are keys and `Mark.Weight(1.5)` is not,
/// and nothing about the *type* decides it. This is the layout the admission
/// cannot answer without reading a discriminant.
enum Mark {
  Plain
  Count(Int)
  Weight(Float)
}

/// A struct holding one, so that the discriminant is read through a field
/// offset and the two fields either side cost nothing.
struct Holder {
  id: Int
  mark: Mark
  label: String
}

/// A value type that reaches itself through a reference, which is the only way
/// [ADR 0035](../../docs/adr/0035-a-value-type-may-not-contain-itself.md)
/// admits — and which no finite walk can be composed for.
struct Node {
  tag: Int
  kids: Array<Node>
}

/// Something to erase, so that the control row has a trait to be a `dyn` of.
trait Tagged {
  fn tag(self) -> Int
}

impl Tagged for Holder {
  fn tag(self) -> Int {
    self.id
  }
}

/// `rounds` lookups of a member of a `Set<Int>`, and nothing else in the loop.
fn countInt(items: Set<Int>, probe: Int, rounds: Int) -> Bool {
  var guard = ballast(rounds)
  var out = false
  var i = 0
  if rounds < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
    guard = guard + 21
    guard = guard + 22
    guard = guard + 23
    guard = guard + 24
  }
  while i < rounds {
    out = items.contains(probe)
    i = i + 1
  }
  if guard < 0 {
    out = false
  }
  out
}

