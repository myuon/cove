/// [`countInt`]'s loop with the lookup taken out and nothing put in its place.
///
/// A control has to see what it controls, and what these rows control is a
/// lookup of several hundred instructions — so this one can afford to hold the
/// turn and nothing else without being dearer than its subject.
fn countBare(rounds: Int) -> Bool {
  var guard = ballast(rounds)
  var out = false
  var i = 0
  if rounds < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
    guard = guard + 21
    guard = guard + 22
    guard = guard + 23
    guard = guard + 24
  }
  while i < rounds {
    out = i < 0
    i = i + 1
  }
  if guard < 0 {
    out = false
  }
  out
}

/// What one row measured: the microseconds its loop took, and what its last
/// turn answered.
///
/// The witness is checked before any number is read as a timing: a row whose
/// loop stopped doing the work would still report one.
struct Row {
  micros: Int
  witness: Bool
}

fn bareRow(rounds: Int) -> Row {
  let from = now()
  let witness = countBare(rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn intRow(items: Set<Int>, probe: Int, rounds: Int) -> Row {
  let from = now()
  let witness = countInt(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn markRow(items: Set<Mark>, probe: Mark, rounds: Int) -> Row {
  let from = now()
  let witness = countMark(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn holderRow(items: Set<Holder>, probe: Holder, rounds: Int) -> Row {
  let from = now()
  let witness = countHolder(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn arrayRow(items: Set<Array<Mark>>, probe: Array<Mark>, rounds: Int) -> Row {
  let from = now()
  let witness = countArray(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn entriesRow(
  items: Set<Map<Int, Mark>>,
  probe: Map<Int, Mark>,
  rounds: Int,
) -> Row {
  let from = now()
  let witness = countEntries(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn deepRow(items: Set<Node>, probe: Node, rounds: Int) -> Row {
  let from = now()
  let witness = countDeep(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn boxedRow(items: Set<dyn Tagged>, probe: dyn Tagged, rounds: Int) -> Row {
  let from = now()
  let witness = countBoxed(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

/// What one lookup cost, in nanoseconds, over `rounds` turns of which `bare`
/// microseconds were the loop itself.
fn perCall(micros: Int, bare: Int, rounds: Int) -> Int {
  (micros - bare) * 1000 / rounds
}

/// A chain of `depth` nodes, each the only child of the one above.
fn chain(depth: Int, last: Int) -> Node {
  var held = Node(tag: last, kids: [])
  var at = 0
  while at < depth {
    held = Node(tag: at, kids: [held])
    at += 1
  }
  held
}

/// One row per arm, each against the same bare loop.
export fn main() -> Result<Unit, Error> {
  let rounds = turns()

  let ints = Set.of(1, 2, 3, 4, 5, 6, 7, 8)
  let marks = Set.of(
    Mark.Plain,
    Mark.Count(1),
    Mark.Count(2),
    Mark.Count(3),
    Mark.Count(4),
    Mark.Count(5),
    Mark.Count(6),
    Mark.Count(7),
  )
  let holders = Set.of(
    Holder(id: 1, mark: Mark.Plain, label: "label"),
    Holder(id: 2, mark: Mark.Count(2), label: "label"),
    Holder(id: 3, mark: Mark.Count(3), label: "label"),
    Holder(id: 4, mark: Mark.Count(4), label: "label"),
    Holder(id: 5, mark: Mark.Count(5), label: "label"),
    Holder(id: 6, mark: Mark.Count(6), label: "label"),
    Holder(id: 7, mark: Mark.Count(7), label: "label"),
    Holder(id: 8, mark: Mark.Count(8), label: "label"),
  )
  let arrays = Set.of(
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(1),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(2),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(3),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(4),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(5),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(6),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(7),
    ],
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(8),
    ],
  )
  let entries = Set.of(
    Map.of(MapEntry(key: 1, value: Mark.Count(1))),
    Map.of(MapEntry(key: 1, value: Mark.Count(2))),
    Map.of(MapEntry(key: 1, value: Mark.Count(3))),
    Map.of(MapEntry(key: 1, value: Mark.Count(4))),
    Map.of(MapEntry(key: 1, value: Mark.Count(5))),
    Map.of(MapEntry(key: 1, value: Mark.Count(6))),
    Map.of(MapEntry(key: 1, value: Mark.Count(7))),
    Map.of(MapEntry(key: 1, value: Mark.Plain)),
  )
  let deeps = Set.of(
    chain(4, 1),
    chain(4, 2),
    chain(4, 3),
    chain(4, 4),
    chain(4, 5),
    chain(4, 6),
    chain(4, 7),
    chain(4, 8),
  )
  let first: dyn Tagged = Holder(id: 1, mark: Mark.Plain, label: "label")
  let second: dyn Tagged = Holder(id: 2, mark: Mark.Plain, label: "label")
  let third: dyn Tagged = Holder(id: 3, mark: Mark.Plain, label: "label")
  let fourth: dyn Tagged = Holder(id: 4, mark: Mark.Plain, label: "label")
  let fifth: dyn Tagged = Holder(id: 5, mark: Mark.Plain, label: "label")
  let sixth: dyn Tagged = Holder(id: 6, mark: Mark.Plain, label: "label")
  let seventh: dyn Tagged = Holder(id: 7, mark: Mark.Plain, label: "label")
  let eighth: dyn Tagged = Holder(id: 8, mark: Mark.Plain, label: "label")
  let boxes = Set.of(
    first,
    second,
    third,
    fourth,
    fifth,
    sixth,
    seventh,
    eighth,
  )

  let bare = bareRow(rounds)
  let xInt = intRow(ints, 5, rounds)
  let xMark = markRow(marks, Mark.Count(5), rounds)
  let xHolder = holderRow(
    holders,
    Holder(id: 5, mark: Mark.Count(5), label: "label"),
    rounds,
  )
  let xArray = arrayRow(
    arrays,
    [
      Mark.Plain,
      Mark.Count(1),
      Mark.Count(2),
      Mark.Count(3),
      Mark.Count(4),
      Mark.Count(5),
      Mark.Count(6),
      Mark.Count(5),
    ],
    rounds,
  )
  let xEntries = entriesRow(
    entries,
    Map.of(MapEntry(key: 1, value: Mark.Count(5))),
    rounds,
  )
  let xDeep = deepRow(deeps, chain(4, 5), rounds)
  let xBoxed = boxedRow(boxes, fifth, rounds)

  // What each row answered, checked before any of it is read as a timing: a
  // row whose loop stopped writing would still report a number, and the
  // number would be of something else. Every probe is a member, so every
  // witness but the bare loop's is `true`.
  assertEqual(bare.witness, false)?
  assertEqual(xInt.witness, true)?
  assertEqual(xMark.witness, true)?
  assertEqual(xHolder.witness, true)?
  assertEqual(xArray.witness, true)?
  assertEqual(xEntries.witness, true)?
  assertEqual(xDeep.witness, true)?
  assertEqual(xBoxed.witness, true)?

  println("bare loop           {bare.micros * 1000 / rounds} ns/turn over {rounds} turn(s)")?
  println("")?
  println("row                 ns/lookup")?
  println("int                 {perCall(xInt.micros, bare.micros, rounds)}")?
  println("mark                {perCall(xMark.micros, bare.micros, rounds)}")?
  println("holder              {perCall(xHolder.micros, bare.micros, rounds)}")?
  println("array               {perCall(xArray.micros, bare.micros, rounds)}")?
  println("entries             {perCall(xEntries.micros, bare.micros, rounds)}")?
  println("deep                {perCall(xDeep.micros, bare.micros, rounds)}")?
  println("boxed               {perCall(xBoxed.micros, bare.micros, rounds)}")?
  Ok(())
}
