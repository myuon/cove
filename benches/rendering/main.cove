/// What one row measured: the microseconds its loop took, and what its last
/// turn rendered.
///
/// The witness is checked before any number is read as a timing: a row whose
/// loop stopped doing the work would still report one, and a row whose walk
/// rendered the *wrong* text would report one too.
struct Row {
  micros: Int
  witness: String
}

fn bareRow(rounds: Int) -> Row {
  let from = now()
  let witness = countBare(rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn stringRow(text: String, rounds: Int) -> Row {
  let from = now()
  let witness = countString(text, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn intRow(value: Int, rounds: Int) -> Row {
  let from = now()
  let witness = countInt(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn structRow(value: Point, rounds: Int) -> Row {
  let from = now()
  let witness = countStruct(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn enumRow(value: Mark, rounds: Int) -> Row {
  let from = now()
  let witness = countEnum(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn arrayRow(value: Array<Int>, rounds: Int) -> Row {
  let from = now()
  let witness = countArray(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn mapRow(value: Map<Int, Point>, rounds: Int) -> Row {
  let from = now()
  let witness = countMap(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn floatRow(value: Float, rounds: Int) -> Row {
  let from = now()
  let witness = countFloat(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn durationRow(value: Duration, rounds: Int) -> Row {
  let from = now()
  let witness = countDuration(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn boxedRow(value: dyn Tagged, rounds: Int) -> Row {
  let from = now()
  let witness = countBoxed(value, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

/// What one rendering cost, in nanoseconds, over `rounds` turns of which
/// `bare` microseconds were the loop itself.
fn perCall(micros: Int, bare: Int, rounds: Int) -> Int {
  (micros - bare) * 1000 / rounds
}

/// One row per arm, each against the same bare loop.
export fn main() -> Result<Unit, Error> {
  let rounds = turns()

  let point = Point(id: 5, label: "label")
  let numbers = [1, 2, 3, 4, 5, 6, 7, 8]
  let table = Map.of(
    MapEntry(key: 1, value: Point(id: 1, label: "one")),
    MapEntry(key: 2, value: Point(id: 2, label: "two")),
    MapEntry(key: 3, value: Point(id: 3, label: "three")),
    MapEntry(key: 4, value: Point(id: 4, label: "four")),
  )
  let held: dyn Tagged = point

  let bare = bareRow(rounds)
  let xString = stringRow("a moderately long label", rounds)
  let xInt = intRow(1234567, rounds)
  let xStruct = structRow(point, rounds)
  let xEnum = enumRow(Mark.Count(5), rounds)
  let xArray = arrayRow(numbers, rounds)
  let xMap = mapRow(table, rounds)
  let xFloat = floatRow(1.5, rounds)
  let xDuration = durationRow(1500ms, rounds)
  let xBoxed = boxedRow(held, rounds)

  // What each row rendered, checked before any of it is read as a timing.
  // These are the same strings `tests/e2e/values_value_render_into` pins, so
  // a walk that composed the wrong punctuation fails here rather than
  // reporting a number for something else.
  assertEqual(bare.witness, "")?
  assertEqual(xString.witness, "a moderately long label")?
  assertEqual(xInt.witness, "1234567")?
  assertEqual(xStruct.witness, "Point(id: 5, label: label)")?
  assertEqual(xEnum.witness, "Count(5)")?
  assertEqual(xArray.witness, "[1, 2, 3, 4, 5, 6, 7, 8]")?
  assertEqual(
    xMap.witness,
    "\{1: Point(id: 1, label: one), 2: Point(id: 2, label: two), 3: Point(id: 3, label: three), 4: Point(id: 4, label: four)\}",
  )?
  assertEqual(xFloat.witness, "1.5")?
  assertEqual(xDuration.witness, "1500ms")?
  assertEqual(xBoxed.witness, "Point(id: 5, label: label)")?

  println("bare loop           {bare.micros * 1000 / rounds} ns/turn over {rounds} turn(s)")?
  println("")?
  println("row                 ns/rendering")?
  println("string              {perCall(xString.micros, bare.micros, rounds)}")?
  println("int                 {perCall(xInt.micros, bare.micros, rounds)}")?
  println("struct              {perCall(xStruct.micros, bare.micros, rounds)}")?
  println("enum                {perCall(xEnum.micros, bare.micros, rounds)}")?
  println("array               {perCall(xArray.micros, bare.micros, rounds)}")?
  println("map                 {perCall(xMap.micros, bare.micros, rounds)}")?
  println("float               {perCall(xFloat.micros, bare.micros, rounds)}")?
  println(
    "duration            {perCall(xDuration.micros, bare.micros, rounds)}",
  )?
  println("boxed               {perCall(xBoxed.micros, bare.micros, rounds)}")?
  Ok(())
}
