use console.println
use clock.now

/// Two words inline, so that `==` on it is the intrinsic rather than one
/// comparison instruction.
struct Point {
  x: Int
  y: Int
}

/// What one of the `Int` piece rows took, and the bytes it rendered.
struct Rendering {
  micros: Int
  bytes: Int
}

/// `rounds` turns of `"{value}"`, one `Int` piece and nothing else, answering
/// the bytes rendered.
///
/// No host call, so that the native tier compiles the loop and the rows price
/// the rendering on the tier that runs it.
fn renderMany(value: Int, rounds: Int) -> Int {
  var bytes = 0
  var i = 0
  while i < rounds {
    bytes = bytes + "{value}".byteLength()
    i = i + 1
  }
  bytes
}

/// [`renderMany`], timed.
fn rendering(value: Int, rounds: Int) -> Rendering {
  let from = now()
  let bytes = renderMany(value, rounds)
  Rendering(micros: (now() - from).micros(), bytes: bytes)
}

/// One builtin call per turn, and nothing else the loop can be about.
///
/// The first three rows are where the boundary was first priced: `byteLength`
/// answered one word, `codePointAtByte` an `Option` the machine had to
/// assemble, and `sliceBytes` a `Result` carrying a heap object it had to
/// allocate. All three are `std.string` now (ADR 0058), so what they report
/// is the Cove that replaced the call, and they stay as the history.
///
/// The four after them are the shapes of the intrinsic boundary that is left
/// (#378, Phase 5), each timed apart because each pays a different part of
/// it:
///
/// - `String.length` answers one word;
/// - `Int.parse` answers a `Result`, several words written into the
///   destination;
/// - `==` on a two-word struct is `Any.equals` over two operands wider than a
///   word;
/// - a ten-piece interpolation is a variadic call past eight operands, which
///   is where an operand list stops fitting inline.
///
/// The last four are one `Int` piece and nothing else, at 1, 3, 10 and 19
/// digits (#403): what rendering an `Int` into an interpolation costs, and how
/// that cost grows with the digits it writes.
export fn main() -> Result<Unit, Error> {
  let text = "the quick brown fox jumps over the lazy dog"
  let digits = "1234567"
  let rounds = 2000000

  // The loop itself, with no builtin in it, so that what the rows below
  // report is the call and not the turn.
  let bareFrom = now()
  var sum = 0
  var i = 0
  while i < rounds {
    sum = sum + i
    i = i + 1
  }
  let bareTo = now()

  let wordFrom = now()
  var counted = 0
  i = 0
  while i < rounds {
    counted = counted + text.byteLength()
    i = i + 1
  }
  let wordTo = now()

  let optionFrom = now()
  var scalars = 0
  i = 0
  while i < rounds {
    scalars = scalars + text.codePointAtByte(4).unwrapOr(0)
    i = i + 1
  }
  let optionTo = now()

  let sliceFrom = now()
  var bytes = 0
  i = 0
  while i < rounds {
    bytes = bytes + text.sliceBytes(4, 9).unwrapOr("").byteLength()
    i = i + 1
  }
  let sliceTo = now()

  let lengthFrom = now()
  var characters = 0
  i = 0
  while i < rounds {
    characters = characters + text.length()
    i = i + 1
  }
  let lengthTo = now()

  let parseFrom = now()
  var parsed = 0
  i = 0
  while i < rounds {
    parsed = parsed + match Int.parse(digits) {
      Ok(n) => n % 7
      Err(_) => 0
    }
    i = i + 1
  }
  let parseTo = now()

  let here = Point(x: 3, y: 4)
  let there = Point(x: 3, y: 4)
  let wideFrom = now()
  var same = 0
  i = 0
  while i < rounds {
    if here == there {
      same = same + 1
    }
    i = i + 1
  }
  let wideTo = now()

  let pieceFrom = now()
  var built = 0
  i = 0
  while i < rounds {
    built = built + "a{i}b{i}c{i}d{i}e{i}".byteLength() % 7
    i = i + 1
  }
  let pieceTo = now()

  let one = rendering(7, rounds)
  let three = rendering(123, rounds)
  let ten = rendering(1234567890, rounds)
  let nineteen = rendering(1234567890123456789, rounds)

  let bare = (bareTo - bareFrom).micros()
  let word = (wordTo - wordFrom).micros()
  let option = (optionTo - optionFrom).micros()
  let slice = (sliceTo - sliceFrom).micros()
  let length = (lengthTo - lengthFrom).micros()
  let parse = (parseTo - parseFrom).micros()
  let wide = (wideTo - wideFrom).micros()
  let piece = (pieceTo - pieceFrom).micros()
  println("bare loop            {bare * 1000 / rounds} ns/turn ({sum})")?
  println(
    "byteLength  (1 word) {(word - bare) * 1000 / rounds} ns/call ({counted})",
  )?
  println("codePointAtByte (Option) {(option - bare) * 1000 / rounds} ns/call ({scalars})")?
  println("sliceBytes  (Result+heap) {(slice - bare) * 1000 / rounds} ns/call ({bytes})")?
  println("length      (1 word) {(length - bare) * 1000 / rounds} ns/call ({characters})")?
  println(
    "Int.parse   (Result) {(parse - bare) * 1000 / rounds} ns/call ({parsed})",
  )?
  println(
    "==          (wide)   {(wide - bare) * 1000 / rounds} ns/call ({same})",
  )?
  println("interpolate (10 pieces) {(piece - bare) * 1000 / rounds} ns/call ({built})")?
  println("Int piece  (1 digit)  {(one.micros - bare) * 1000 / rounds} ns/call ({one.bytes})")?
  println("Int piece  (3 digits) {(three.micros - bare) * 1000 / rounds} ns/call ({three.bytes})")?
  println("Int piece (10 digits) {(ten.micros - bare) * 1000 / rounds} ns/call ({ten.bytes})")?
  println("Int piece (19 digits) {(nineteen.micros - bare) * 1000 / rounds} ns/call ({nineteen.bytes})")?
  Ok(())
}
