/// `turns` calls of `Float.cos`.
fn countCos(x: Float, turns: Int) -> Float {
  var guard = ballast(turns)
  var out = x
  var i = 0
  if turns < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
