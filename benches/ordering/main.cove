/// [`countInt`]'s loop with the lookup taken out and nothing put in its place.
///
/// A control has to see what it controls, and what these rows control is a
/// lookup of several hundred instructions — so this one can afford to hold the
/// turn and nothing else without being dearer than its subject.
fn countBare(rounds: Int) -> Bool {
  var guard = ballast(rounds)
  var out = false
  var i = 0
  if rounds < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
    guard = guard + 21
    guard = guard + 22
    guard = guard + 23
    guard = guard + 24
  }
  while i < rounds {
    i = i + 1
  }
  if guard < 0 {
    out = false
  }
  out
}

/// How long `rounds` turns took, in microseconds, and the last answer the loop
/// wrote.
struct Row {
  micros: Int
  witness: Bool
}

fn bareRow(rounds: Int) -> Row {
  let from = now()
  let witness = countBare(rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn intRow(items: Set<Int>, probe: Int, rounds: Int) -> Row {
  let from = now()
  let witness = countInt(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn textRow(items: Set<String>, probe: String, rounds: Int) -> Row {
  let from = now()
  let witness = countText(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn oneRow(items: Set<One>, probe: One, rounds: Int) -> Row {
  let from = now()
  let witness = countOne(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn tripleRow(items: Set<Triple>, probe: Triple, rounds: Int) -> Row {
  let from = now()
  let witness = countTriple(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn markRow(items: Set<Mark>, probe: Mark, rounds: Int) -> Row {
  let from = now()
  let witness = countMark(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn arrayRow(items: Set<Array<Int>>, probe: Array<Int>, rounds: Int) -> Row {
  let from = now()
  let witness = countArray(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn entriesRow(
  items: Set<Map<String, Int>>,
  probe: Map<String, Int>,
  rounds: Int,
) -> Row {
  let from = now()
  let witness = countEntries(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn boxedRow(items: Set<dyn Tagged>, probe: dyn Tagged, rounds: Int) -> Row {
  let from = now()
  let witness = countBoxed(items, probe, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

/// What one lookup cost, in nanoseconds, over `rounds` turns of which `bare`
/// microseconds were the loop itself.
fn perCall(micros: Int, bare: Int, rounds: Int) -> Int {
  (micros - bare) * 1000 / rounds
}

/// One row per arm, each against the same bare loop.
export fn main() -> Result<Unit, Error> {
  let rounds = turns()

  let ints = Set.of(1, 2, 3, 4, 5, 6, 7, 8)
  let texts = Set.of("a", "b", "c", "d", "e", "f", "g", "h")
  let ones = Set.of(
    One(first: 1),
    One(first: 2),
    One(first: 3),
    One(first: 4),
    One(first: 5),
    One(first: 6),
    One(first: 7),
    One(first: 8),
  )
  let triples = Set.of(
    Triple(first: 7, middle: "middle", last: 1),
    Triple(first: 7, middle: "middle", last: 2),
    Triple(first: 7, middle: "middle", last: 3),
    Triple(first: 7, middle: "middle", last: 4),
    Triple(first: 7, middle: "middle", last: 5),
    Triple(first: 7, middle: "middle", last: 6),
    Triple(first: 7, middle: "middle", last: 7),
    Triple(first: 7, middle: "middle", last: 8),
  )
  let marks = Set.of(
    Mark.Plain,
    Mark.Count(1),
    Mark.Count(2),
    Mark.Count(3),
    Mark.Named("a"),
    Mark.Named("b"),
    Mark.Named("c"),
    Mark.Named("d"),
  )
  let arrays = Set.of(
    [1, 2, 3, 4, 5, 6, 7, 1],
    [1, 2, 3, 4, 5, 6, 7, 2],
    [1, 2, 3, 4, 5, 6, 7, 3],
    [1, 2, 3, 4, 5, 6, 7, 4],
    [1, 2, 3, 4, 5, 6, 7, 5],
    [1, 2, 3, 4, 5, 6, 7, 6],
    [1, 2, 3, 4, 5, 6, 7, 7],
    [1, 2, 3, 4, 5, 6, 7, 8],
  )
  let entries = Set.of(
    Map.of(MapEntry(key: "key", value: 1)),
    Map.of(MapEntry(key: "key", value: 2)),
    Map.of(MapEntry(key: "key", value: 3)),
    Map.of(MapEntry(key: "key", value: 4)),
    Map.of(MapEntry(key: "key", value: 5)),
    Map.of(MapEntry(key: "key", value: 6)),
    Map.of(MapEntry(key: "key", value: 7)),
    Map.of(MapEntry(key: "key", value: 8)),
  )
  let first: dyn Tagged = One(first: 1)
  let second: dyn Tagged = One(first: 2)
  let third: dyn Tagged = One(first: 3)
  let fourth: dyn Tagged = One(first: 4)
  let fifth: dyn Tagged = One(first: 5)
  let sixth: dyn Tagged = One(first: 6)
  let seventh: dyn Tagged = One(first: 7)
  let eighth: dyn Tagged = One(first: 8)
  let boxes = Set.of(
    first,
    second,
    third,
    fourth,
    fifth,
    sixth,
    seventh,
    eighth,
  )

  let bare = bareRow(rounds)
  let xInt = intRow(ints, 5, rounds)
  let xText = textRow(texts, "e", rounds)
  let xOne = oneRow(ones, One(first: 5), rounds)
  let xTriple = tripleRow(
    triples,
    Triple(first: 7, middle: "middle", last: 5),
    rounds,
  )
  let xMark = markRow(marks, Mark.Named("a"), rounds)
  let xArray = arrayRow(arrays, [1, 2, 3, 4, 5, 6, 7, 5], rounds)
  let xEntries = entriesRow(
    entries,
    Map.of(MapEntry(key: "key", value: 5)),
    rounds,
  )
  let xBoxed = boxedRow(boxes, fifth, rounds)

  // What each row answered, checked before any of it is read as a timing: a
  // row whose loop stopped writing would still report a number, and the
  // number would be of something else. Every probe is a member, so every
  // witness but the bare loop's is `true`.
  assertEqual(bare.witness, false)?
  assertEqual(xInt.witness, true)?
  assertEqual(xText.witness, true)?
  assertEqual(xOne.witness, true)?
  assertEqual(xTriple.witness, true)?
  assertEqual(xMark.witness, true)?
  assertEqual(xArray.witness, true)?
  assertEqual(xEntries.witness, true)?
  assertEqual(xBoxed.witness, true)?

  println("bare loop           {bare.micros * 1000 / rounds} ns/turn over {rounds} turn(s)")?
  println("")?
  println("row                 ns/lookup")?
  println("int                 {perCall(xInt.micros, bare.micros, rounds)}")?
  println("text                {perCall(xText.micros, bare.micros, rounds)}")?
  println("one                 {perCall(xOne.micros, bare.micros, rounds)}")?
  println("triple              {perCall(xTriple.micros, bare.micros, rounds)}")?
  println("mark                {perCall(xMark.micros, bare.micros, rounds)}")?
  println("array               {perCall(xArray.micros, bare.micros, rounds)}")?
  println("entries             {perCall(xEntries.micros, bare.micros, rounds)}")?
  println("boxed               {perCall(xBoxed.micros, bare.micros, rounds)}")?
  Ok(())
}
