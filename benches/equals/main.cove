/// [`countOne`]'s loop with the comparison taken out and nothing put in its
/// place.
///
/// A control has to see what it controls, and what these rows control is a
/// walk of several instructions — so unlike `benches/floatabs`' control this
/// one can afford to hold the turn and nothing else without being dearer than
/// its subject.
fn countBare(rounds: Int) -> Bool {
  var guard = ballast(rounds)
  var out = false
  var i = 0
  if rounds < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
    guard = guard + 21
    guard = guard + 22
    guard = guard + 23
    guard = guard + 24
  }
  while i < rounds {
    i = i + 1
  }
  if guard < 0 {
    out = false
  }
  out
}

/// How long `rounds` turns took, in microseconds, and the last answer the
/// loop wrote.
struct Row {
  micros: Int
  witness: Bool
}

fn bareRow(rounds: Int) -> Row {
  let from = now()
  let witness = countBare(rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn oneRow(x: One, y: One, rounds: Int) -> Row {
  let from = now()
  let witness = countOne(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn tripleRow(x: Triple, y: Triple, rounds: Int) -> Row {
  let from = now()
  let witness = countTriple(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn markRow(x: Mark, y: Mark, rounds: Int) -> Row {
  let from = now()
  let witness = countMark(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn arrayRow(x: Array<Int>, y: Array<Int>, rounds: Int) -> Row {
  let from = now()
  let witness = countArray(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn mapRow(x: Map<String, Int>, y: Map<String, Int>, rounds: Int) -> Row {
  let from = now()
  let witness = countMap(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn boxedRow(x: dyn Tagged, y: dyn Tagged, rounds: Int) -> Row {
  let from = now()
  let witness = countBoxed(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

fn treeRow(x: Tree, y: Tree, rounds: Int) -> Row {
  let from = now()
  let witness = countTree(x, y, rounds)
  Row(micros: (now() - from).micros(), witness: witness)
}

/// What one comparison cost, in nanoseconds, over `rounds` turns of which
/// `bare` microseconds were the loop itself.
fn perCall(micros: Int, bare: Int, rounds: Int) -> Int {
  (micros - bare) * 1000 / rounds
}

/// One row per arm, each against the same bare loop.
export fn main() -> Result<Unit, Error> {
  let rounds = turns()

  let one = One(first: 7)
  let otherOne = One(first: 7)
  let triple = Triple(first: 7, middle: "middle", last: 9)
  let otherTriple = Triple(first: 7, middle: "middle", last: 9)
  let mark = Mark.Count(7)
  let otherMark = Mark.Count(7)
  let array = [1, 2, 3, 4, 5, 6, 7, 8]
  let otherArray = [1, 2, 3, 4, 5, 6, 7, 8]
  let map = Map.of(
    MapEntry(key: "alpha", value: 1),
    MapEntry(key: "beta", value: 2),
    MapEntry(key: "gamma", value: 3),
    MapEntry(key: "delta", value: 4),
  )
  let otherMap = Map.of(
    MapEntry(key: "delta", value: 4),
    MapEntry(key: "gamma", value: 3),
    MapEntry(key: "beta", value: 2),
    MapEntry(key: "alpha", value: 1),
  )
  let boxed: dyn Tagged = triple
  let otherBoxed: dyn Tagged = otherTriple

  let bare = bareRow(rounds)
  let xOne = oneRow(one, otherOne, rounds)
  let xTriple = tripleRow(triple, otherTriple, rounds)
  let xMark = markRow(mark, otherMark, rounds)
  let xArray = arrayRow(array, otherArray, rounds)
  let xMap = mapRow(map, otherMap, rounds)
  let xBoxed = boxedRow(boxed, otherBoxed, rounds)
  let few = treeTurns()
  let tree = grow(6, 3)
  let otherTree = grow(6, 3)
  let boxedTree: dyn Tagged = tree
  let otherBoxedTree: dyn Tagged = otherTree
  let fewBare = bareRow(few)
  let xTree = treeRow(tree, otherTree, few)
  let xBoxedTree = boxedRow(boxedTree, otherBoxedTree, few)

  // What each row answered, checked before any of it is read as a timing: a
  // row whose loop stopped writing would still report a number, and the
  // number would be of something else. Every pair is equal, so every witness
  // but the bare loop's is `true`.
  assertEqual(bare.witness, false)?
  assertEqual(xOne.witness, true)?
  assertEqual(xTriple.witness, true)?
  assertEqual(xMark.witness, true)?
  assertEqual(xArray.witness, true)?
  assertEqual(xMap.witness, true)?
  assertEqual(xBoxed.witness, true)?
  assertEqual(xTree.witness, true)?
  assertEqual(xBoxedTree.witness, true)?

  println("bare loop           {bare.micros * 1000 / rounds} ns/turn over {rounds} turn(s)")?
  println("")?
  println("row                 ns/call")?
  println("one                 {perCall(xOne.micros, bare.micros, rounds)}")?
  println("triple              {perCall(xTriple.micros, bare.micros, rounds)}")?
  println("mark                {perCall(xMark.micros, bare.micros, rounds)}")?
  println("array               {perCall(xArray.micros, bare.micros, rounds)}")?
  println("map                 {perCall(xMap.micros, bare.micros, rounds)}")?
  println("boxed               {perCall(xBoxed.micros, bare.micros, rounds)}")?
  println("tree                {perCall(xTree.micros, fewBare.micros, few)}")?
  println(
    "tree.boxed          {perCall(xBoxedTree.micros, fewBare.micros, few)}",
  )?
  Ok(())
}
