use console.println
use clock.now

/// What a layout-directed `==` costs as a walk the lowering wrote against
/// what it cost as one call into a walk written in Rust.
///
/// [ADR 0064](../../docs/adr/0064-an-intrinsic-names-a-machine-not-a-method.md)'s
/// Decision 3 makes `==` on a value whose layout is known a **function
/// lowering synthesizes for that layout**, composed structurally, where it was
/// one `Inst::IntrinsicCall` of `Any.equals` reaching `equal::value` in the
/// runtime. `Any.equals` runs **zero times** on covefmt and on cq — 0 static
/// sites and 0 dynamic calls on both — so no whole-program figure exists to
/// make, and this package is the whole of the performance argument.
///
/// # The two arms are two binaries over one source
///
/// There is no way to write both arms in one process for a *known* layout:
/// after the migration a program cannot ask for the intrinsic, because
/// nothing in the language names it. So this file is run twice, over the same
/// bytes of the same package — once by a `cove` built at the migration's
/// parent, where every row below lowers to an `intrinsic-call`, and once by a
/// `cove` built here, where every row but the last lowers to a walk.
/// `benches/floatabs` settled that arrangement and this is its shape.
///
/// # The last row is a control that sees what it controls
///
/// `boxed` compares two `dyn Tagged` values, and a `dyn Tagged` is Decision
/// 4's one dynamic-layout fallback: its family is a word in its own header
/// and no walk can be composed for it, so it reaches `Any.equals` in **both**
/// builds. It is the same operation over the same bytes on both sides of the
/// comparison, so whatever it moves by between two builds is what a rebuild
/// moves things by — and a row that moved by less than `boxed` did is a row
/// that said nothing. ADR 0063 measured a rebuild's code layout at −2.13% on
/// a program whose every count was byte-identical, which is why a control is
/// asked for rather than a percentage.
///
/// It is also the row that says the fallback is still *reached*: a rule that
/// nothing may use the intrinsic wrongly is satisfied by deleting the arm,
/// and this is a program that needs it.
///
/// # What the rows are, and why these
///
/// One per arm of the composition, at the sizes a walk's cost is actually
/// shaped by:
///
/// - `one`, a one-field struct: the smallest walk there is, and the one
///   `cove_ir::lower::inline` expands into its caller whole. What it measures
///   is the *floor* — a comparison with no call at either end.
/// - `triple`, three fields of which the middle is a `String`: the shape a
///   record has, and the one that makes a wrong field offset visible.
/// - `mark`, an enum with a payload: a case comparison and a `switch`.
/// - `array`, eight `Int`s: a loop, which is where a walk written in Cove is
///   most exposed against a loop written in Rust — eight turns of five
///   instructions against one crossing.
/// - `map`, four entries: the same loop over a two-part element, which is
///   what a keyed collection's canonical order costs.
/// - `boxed`, the control above.
/// - `tree` and `tree.boxed`, a tree of 364 nodes through vectors — three
///   children a node, six levels — compared with an equal tree built apart,
///   once as a `Tree` and once erased. A `Tree` holds a `Vector<Tree>`, so it
///   is a layout that can contain itself, and both of its walks carry the
///   path of vector pairs that refuses one that does (issue #493): these two
///   rows are what that costs, on a value that never does. They run for
///   [`treeTurns`] rather than [`turns`], because one comparison is hundreds
///   of nodes.
///
/// Every pair is **equal**, which is the walk's worst case: an early exit
/// stops at the first part that differs and would measure the prefix rather
/// than the composition. The early-exit case is charged correctly and
/// `crates/cove-runtime/src/vm/report.rs` pins that; what is wanted here is
/// the whole walk.
///
/// # The loops are in callees, and they are padded
///
/// `benches/floatabs`' arrangement, for its reason: the outermost frame is
/// always encoded, so a loop written in `main` is a VM measurement even under
/// `--backend native`. Each row is a call to a counting callee whose body is
/// the loop, and every counting callee opens with [`ballast`] — a block the
/// parameter's sign makes unreachable and nothing can fold away, sized past
/// `cove_ir::lower::inline`'s `HOT_LIMIT` of forty-eight — so that it is not
/// expanded into [`Row`]'s maker.
///
/// # What the native column will and will not hold
///
/// `crates/cove-native/src/subset.rs` admits `Compare::Str` for `CmpOp::Order`
/// alone and admits `Compare::Float` for nothing, so a synthesized walk that
/// compares a `String` field is **refused by the native tier** where the
/// `intrinsic-call` it replaced was admitted. `triple` and `map` are the rows
/// that carry one; `one`, `mark` and `array` are `Int` throughout. That is a
/// finding rather than a defect of this file, and the rows are arranged so
/// that it can be read off them: `--backend native --boundary` names the
/// compiled and the refused.
fn turns() -> Int {
  200000
}

/// How many times the two tree rows compare, which is fewer than [`turns`]
/// by about the tree's size.
fn treeTurns() -> Int {
  2000
}

/// Instructions a counting callee carries so that it is not expanded into its
/// caller, which the native tier refuses for the `now()` in it.
///
/// `rounds` is never negative at any call site, so none of this runs; nothing
/// in the lowering can prove that, so none of it is folded away either.
fn ballast(rounds: Int) -> Int {
  var dead = 0
  if rounds < 0 {
    dead = dead + 1
    dead = dead + 2
    dead = dead + 3
    dead = dead + 4
    dead = dead + 5
    dead = dead + 6
    dead = dead + 7
    dead = dead + 8
    dead = dead + 9
    dead = dead + 10
    dead = dead + 11
    dead = dead + 12
    dead = dead + 13
    dead = dead + 14
    dead = dead + 15
    dead = dead + 16
    dead = dead + 17
    dead = dead + 18
    dead = dead + 19
    dead = dead + 20
    dead = dead + 21
    dead = dead + 22
    dead = dead + 23
    dead = dead + 24
  }
  dead
}

/// A one-field struct: the floor.
struct One {
  first: Int
}

/// Three fields of which the middle is a reference.
struct Triple {
  first: Int
  middle: String
  last: Int
}

/// Cases with payloads beside one without.
enum Mark {
  Plain
  Count(Int)
  Named(String)
}

/// Something to erase, so that the control row has a trait to be a `dyn` of.
trait Tagged {
  fn tag(self) -> Int
}

/// A node with a vector of nodes under it: a layout that reaches itself
/// through a `Vector`.
struct Tree {
  tag: Int
  kids: Vector<Tree>
}

impl Tagged for Tree {
  fn tag(self) -> Int {
    self.tag
  }
}

/// A full tree `levels` deep with `width` children a node, tagged by level.
fn grow(levels: Int, width: Int) -> Tree {
  var kids: Vector<Tree> = Vector.of()
  if levels > 1 {
    var at = 0
    while at < width {
      kids.push(grow(levels - 1, width))
      at = at + 1
    }
  }
  Tree(tag: levels, kids: kids)
}

impl Tagged for Triple {
  fn tag(self) -> Int {
    self.first
  }
}

/// `rounds` comparisons of two equal `One`s, and nothing else in the loop.
fn countOne(x: One, y: One, rounds: Int) -> Bool {
  var guard = ballast(rounds)
  var out = false
  var i = 0
  if rounds < 0 {
    guard = guard + 1
    guard = guard + 2
    guard = guard + 3
    guard = guard + 4
    guard = guard + 5
    guard = guard + 6
    guard = guard + 7
    guard = guard + 8
    guard = guard + 9
    guard = guard + 10
    guard = guard + 11
    guard = guard + 12
    guard = guard + 13
    guard = guard + 14
    guard = guard + 15
    guard = guard + 16
    guard = guard + 17
    guard = guard + 18
    guard = guard + 19
    guard = guard + 20
    guard = guard + 21
    guard = guard + 22
    guard = guard + 23
    guard = guard + 24
  }
  while i < rounds {
    out = x == y
    i = i + 1
  }
  if guard < 0 {
    out = false
  }
  out
}

