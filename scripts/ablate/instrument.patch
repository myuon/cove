 };
 pub use value::Value;
 pub use vm::Vm;
+
+// ------------------------------------------------------- scratch instrument
+
+/// Counts every allocation the process makes, for issue #123's matrix.
+pub struct CountingAllocator;
+
+/// How many allocations, and how many bytes.
+pub static ALLOCATIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static ALLOCATED_BYTES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+unsafe impl std::alloc::GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
+        ALLOCATIONS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        ALLOCATED_BYTES.fetch_add(layout.size() as u64, std::sync::atomic::Ordering::Relaxed);
+        std::alloc::System.alloc(layout)
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: std::alloc::Layout) {
+        std::alloc::System.dealloc(ptr, layout)
+    }
+}
+
+#[global_allocator]
+static COUNTING: CountingAllocator = CountingAllocator;
+
+/// What the process has allocated so far: a count and a total size.
+pub fn allocation_counts() -> (u64, u64) {
+    (
+        ALLOCATIONS.load(std::sync::atomic::Ordering::Relaxed),
+        ALLOCATED_BYTES.load(std::sync::atomic::Ordering::Relaxed),
+    )
+}
