/// Recursive descent over the tokens, at the item level.
///
/// This slice takes a declaration apart into its header — the words in front
/// of it, its name, its generics, its parameters, its answer — and keeps its
/// body whole. What is inside a body is the next slice's; until then it is a
/// `Body` of leaves, which is enough to be lossless and not enough to format.
///
/// Every rule ends where it began or later and never skips a token, so the
/// tree tiles whatever the source says. A file that does not parse is not a
/// failure here: the tokens no rule claimed become an `Error` node, and the
/// tree still covers them.
/// A cursor over the tokens of one source.
struct Parser {
  source: String
  tokens: Array<Token>
  at: Int
  /// The children every leaf has, which is none — one array for the whole
  /// parse rather than an empty `[]` allocated per leaf. An `Array` cannot
  /// change, so every leaf can hold the same one; allocating it afresh was
  /// one allocation per token of the file, the parse phase's most frequent.
  empty: Array<Tree>
}

/// Whether the token at `at` is the word `word`.
///
/// Compared byte by byte rather than by cutting the run out: `sliceBytes`
/// allocates a `String`, and a keyword test happens at every item and every
/// word in front of one.
fn isWord(source: String, tokens: Array<Token>, at: Int, word: String) -> Bool {
  match tokens.get(at) {
    Some(token) => {
      if token.kind != Kind.Word || token.to - token.from != word.byteLength() {
        return false
      }
      var i = 0
      while i < word.byteLength() {
        if source.byteAt(token.from + i) != word.byteAt(i) {
          return false
        }
        i = i + 1
      }
      true
    }
    None => false
  }
}

/// Whether the token at `at` is the punctuation `mark`.
fn isPunct(
  source: String,
  tokens: Array<Token>,
  at: Int,
  mark: String,
) -> Bool {
  match tokens.get(at) {
    Some(token) => {
      if token.kind != Kind.Punct || token.to - token.from != mark.byteLength() {
        return false
      }
      var i = 0
      while i < mark.byteLength() {
        if source.byteAt(token.from + i) != mark.byteAt(i) {
          return false
        }
        i = i + 1
      }
      true
    }
    None => false
  }
}

/// Whether the token at `at` is trivia: space, or one of the comment forms.
fn isTrivia(tokens: Array<Token>, at: Int) -> Bool {
  match tokens.get(at) {
    Some(token) => token.kind == Kind.Space || token.kind == Kind.LineComment ||
      token.kind == Kind.BlockComment || token.kind == Kind.DocComment
    None => false
  }
}

impl Parser {
  /// Whether every token has been taken.
  fn done(self) -> Bool {
    self.at >= self.tokens.length()
  }

  /// The first token at or after `at` that is not trivia.
  fn significant(self, at: Int) -> Int {
    var i = at
    while i < self.tokens.length() && isTrivia(self.tokens, i) {
      i = i + 1
    }
    i
  }

  /// The byte of a one-byte punctuation token at `at`, or zero.
  ///
  /// One read where a chain of `isPunct` calls is six. A body is most of a
  /// file and every token of one is asked whether it opens or closes a
  /// bracket, so asking it as six calls — each of them an `Option<Token>` and
  /// a loop over a word — was 774 ms of the 874 the parse took. Reading the
  /// byte once and comparing it six times is the same question, answered.
  fn punctByte(self, at: Int) -> Int {
    match self.tokens.get(at) {
      Some(token) => {
        if token.kind != Kind.Punct || token.to - token.from != 1 {
          return 0
        }
        self.source.byteAt(token.from)
      }
      None => 0
    }
  }

  /// Takes one token as a leaf.
  ///
  /// The rules that take leaves in a loop do not call this: a `var self`
  /// method is a frame per call however small it is, and that was a call per
  /// token of the file. They push [`leafIn`] and step the cursor themselves,
  /// which is this, written where it is needed.
  fn leaf(var self) -> Tree {
    let at = self.at
    self.at = at + 1
    leafIn(at, self.empty)
  }

  /// Takes the run of trivia at the cursor into `into`, and answers whether
  /// there was any.
  fn trivia(var self, var into: Vector<Tree>) -> Bool {
    let from = self.at
    while isTrivia(self.tokens, self.at) {
      into.push(leafIn(self.at, self.empty))
      self.at = self.at + 1
    }
    self.at > from
  }

  /// Takes a balanced run beginning at an opening bracket, brackets included.
  ///
  /// Depth is counted over `{`, `[` and `(` together rather than per kind,
  /// which is what a lexer's output supports: a `}` that closes nothing ends
  /// the run, because a run that read past it would swallow the rest of the
  /// file on one typo.
  ///
  /// Everything inside is leaves. A `Node.Body` is taken by [`Parser::body`]
  /// instead, which reads the same run as statements.
  fn balanced(var self, kind: Node) -> Tree {
    let from = self.at
    var held = Vector.of()
    var depth = 0
    while !self.done() {
      let c = self.punctByte(self.at)
      let opens = c == '\{' || c == '[' || c == '('
      let closes = c == '\}' || c == ']' || c == ')'
      if opens {
        depth = depth + 1
      }
      held.push(leafIn(self.at, self.empty))
      self.at = self.at + 1
      if closes {
        depth = depth - 1
        if depth <= 0 {
          return nodeOf(kind, from, self.at, held.toArray())
        }
      }
    }
    nodeOf(kind, from, self.at, held.freeze())
  }

  /// A `( ... )`, `[ ... ]` or `< ... >` group: the brackets, the trivia
  /// between members, and the members themselves.
  ///
  /// The same shape [`Parser::body`] gives a `{ ... }`, one level and not
  /// all of them: a member's own tokens stay leaves, and what this adds is
  /// where one member ends and the next begins. That is the boundary a
  /// formatter needs to decide the *one thing* it cannot decide without it —
  /// how far in a member sits when the group is written over several lines.
  ///
  /// A member ends at a comma at the group's own depth. Commas deeper than
  /// that belong to a group inside this one — `f(g(a, b), c)` has three —
  /// and a member that ends at the closing bracket has no comma at all.
  fn grouped(var self, kind: Node) -> Tree {
    let from = self.at
    var held = Vector.of()
    let opener = self.punctByte(self.at)
    if opener != '(' && opener != '[' {
      return self.balanced(kind)
    }
    held.push(leafIn(self.at, self.empty))
    self.at = self.at + 1
    while !self.done() {
      if isTrivia(self.tokens, self.at) {
        self.trivia(var held)
        continue
      }
      let c = self.punctByte(self.at)
      if c == ')' || c == ']' {
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
        return nodeOf(kind, from, self.at, held.toArray())
      }
      if c == ',' {
        // A comma of this group belongs to the group and not to the member
        // in front of it, the way a body's braces belong to the body.
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
        continue
      }
      let before = self.at
      held.push(self.member())
      if self.at == before {
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
      }
    }
    nodeOf(kind, from, self.at, held.freeze())
  }

  /// One member of a group, ending at a comma of the group's own depth or at
  /// the bracket that closes it.
  fn member(var self) -> Tree {
    let from = self.at
    var held = Vector.of()
    var depth = 0
    // How many generic lists stand open. A comma inside one belongs to the
    // type and not to the group: `f(result: Result<T, E>, at: Int)` has two
    // members and not three, and split into three it came back as
    // `Result<T,\n  E>,` — valid, and not what anybody wrote.
    var angles = 0
    while !self.done() {
      let c = self.punctByte(self.at)
      if c == '<' && self.opensGenerics(self.at) {
        angles = angles + 1
      } else if c == '>' && angles > 0 {
        angles = angles - 1
      }
      if angles > 0 {
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
        continue
      }
      if depth <= 0 && (c == ',' || c == ')' || c == ']') {
        return nodeOf(Node.Member, from, self.at, held.toArray())
      }
      // A group inside a member is a group: `g(h(1))` is a call whose one
      // argument holds another, and a formatter indents the inner one from
      // the outer. Taking it whole here is what makes that depth readable
      // rather than a run of leaves — the same split `statement` makes.
      if depth <= 0 && (c == '(' || c == '[') {
        held.push(self.grouped(Node.Group))
        continue
      }
      // And a `{ ... }` inside a member is a body: a lambda written as an
      // argument — `items.filter(fn(item) \{ ... \})` — carries statements,
      // and a formatter that could not see them would flatten a lambda with
      // a body onto one line. `cove_syntax::format` refuses that in
      // `breaks`: a lambda body that is not empty always breaks.
      if depth <= 0 && c == '\{' {
        held.push(self.body())
        continue
      }
      if c == '(' || c == '[' || c == '\{' {
        depth = depth + 1
      } else if c == ')' || c == ']' || c == '\}' {
        depth = depth - 1
      }
      held.push(leafIn(self.at, self.empty))
      self.at = self.at + 1
    }
    nodeOf(Node.Member, from, self.at, held.freeze())
  }

  /// Whether the `<` at `at` opens a generic list rather than comparing two
  /// things.
  ///
  /// It is written against the name it belongs to — `Result<T, E>`, never
  /// `Result <T, E>` — and a comparison is written with a space on each side,
  /// which `cove_syntax::format` guarantees and every file this reads is the
  /// output of. So the token directly before it, with no run of space
  /// between, is the whole of the question.
  ///
  /// **A heuristic, and the first one here.** The lexer cannot answer this
  /// properly: telling `Result<T, E>` from `a<b, c>d` is the ambiguity C++
  /// parsers are known for, and it takes a parser that knows what is a type.
  /// What this gets wrong is source nobody has run `cove fmt` over yet, where
  /// somebody has written `a<b` — and it gets it wrong by keeping a comma
  /// inside a member, which costs a line break and not a meaning.
  ///
  /// The alternative was leaving it, and leaving it meant a formatter that
  /// writes `Result<T,` at the end of a line the moment it breaks a
  /// parameter list.
  fn opensGenerics(self, at: Int) -> Bool {
    match self.tokens.get(at - 1) {
      Some(token) => token.kind == Kind.Word
      None => false
    }
  }

  /// A `{ ... }` body: the braces, the trivia between statements, and the
  /// statements themselves.
  ///
  /// One level and not all of them. A statement's own tokens stay leaves —
  /// what an expression is made of is the next slice's work — so what this
  /// adds is exactly the boundary a formatter needs first: where one
  /// statement ends and the next begins. The tiling holds at the new level
  /// the way it holds at every other, and `covers` is what says so.
  ///
  /// A nested `{ ... }` is a body too, which is what makes an `if`'s or a
  /// `while`'s block hold statements rather than a run of leaves. It is
  /// reached from [`Parser::statement`], because a statement is where one
  /// can open.
  fn body(var self) -> Tree {
    self.bodyOf(false)
  }

  /// A body, told whether what is between its braces is declarations.
  ///
  /// A `struct`'s fields, an `enum`'s variants and a `trait`'s or an `impl`'s
  /// methods are declarations, and a declaration is one to a line. A
  /// statement is not: it carries on past a line that ends on an operator,
  /// which is what `continues` is for and what a declaration must not be
  /// read by. `tokens: Array<Token>` and `fn appraise(self, pr: PullRequest)
  /// -> Option<Finding>` both end on a `>`, and a statement ending on the
  /// same `>` is a comparison whose operand is on the next line.
  ///
  /// The lexer cannot tell those two `>` apart — it has no parser to ask —
  /// so the difference is made where it is actually known, which is the
  /// declaration that opened the brace. Read as statements, every field after
  /// the first went under the one above it as its continuation; teaching
  /// `continues` that a `>` ends a line fixed the fields and broke
  /// `if steps(a) >\n  steps(b) {`, which is the same ambiguity from the
  /// other side. This is the version that has no other side.
  fn bodyOf(var self, declaring: Bool) -> Tree {
    let from = self.at
    var held = Vector.of()
    if self.punctByte(self.at) != '\{' {
      return self.balanced(Node.Body)
    }
    held.push(leafIn(self.at, self.empty))
    self.at = self.at + 1
    while !self.done() {
      if isTrivia(self.tokens, self.at) {
        self.trivia(var held)
        continue
      }
      if self.punctByte(self.at) == '\}' {
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
        return nodeOf(Node.Body, from, self.at, held.toArray())
      }
      let before = self.at
      held.push(self.statementOf(declaring))
      // A rule that took nothing would loop for ever. Nothing here can —
      // `statement` takes at least one token — and the check is the cheap
      // way to keep that true rather than to trust it.
      if self.at == before {
        held.push(leafIn(self.at, self.empty))
        self.at = self.at + 1
      }
    }
    nodeOf(Node.Body, from, self.at, held.freeze())
  }

  /// One statement, ending where the language says a statement ends.
  ///
  /// # The rule, and why each half of it is here
  ///
  /// `docs/LANGUAGE_REFERENCE.md`: *"Statements end at the end of a line:
  /// Cove has no `;`."* That sentence alone would cut `a +` from the `b`
  /// under it, so three things qualify it and all three are below.
  ///
  /// **An operator at the end of a line carries the statement on.** `a +`
  /// then `b` is one expression and `a` then `+ b` is two statements, so
  /// which side of the break the operator is written on is the whole of the
  /// difference — and it is the reason this asks about the token *before*
  /// the newline rather than the one after.
  ///
  /// **A line beginning with `.` continues the chain above it.** So the
  /// question is asked of the next line's first token too.
  ///
  /// **A line break inside `(`, `[` or `<` ends nothing**, which is what
  /// lets an argument list span lines. A `{ }` block is not such a group:
  /// its statements *do* end at line ends, which is why depth here counts
  /// only the three and a brace opens a body instead.
  ///
  /// `break`, `continue` and `return` end at the end of their line whatever
  /// encloses them, groups included — and an operand belongs to one only
  /// when it *begins* on the keyword's own line. That is the one place a
  /// statement ends inside a group, and [`Parser::escapes`] is it.
  fn statement(var self) -> Tree {
    self.statementOf(false)
  }

  /// One statement or one declaration, `declaring` saying which.
  ///
  /// A declaration ends at its line, full stop. Everything else here is the
  /// same for both: a brace still opens a body, a bracket is still taken
  /// whole as a group, and an unmatched closer still stops at itself.
  fn statementOf(var self, declaring: Bool) -> Tree {
    let from = self.at
    var held = Vector.of()
    let escaping = self.escapes(self.at)
    var depth = 0
    while !self.done() {
      // A brace at the top of a statement opens a body, which holds
      // statements of its own. Inside a group it is a leaf like any other:
      // `fn() { ... }` written as an argument is one argument.
      if depth <= 0 && self.punctByte(self.at) == '\{' {
        held.push(self.body())
        // And then ask, because a block is where a statement most often
        // ends: `if a \{ b \}` is over at the brace unless an `else` or a
        // method call follows on the same line. Reading on without asking
        // made the `c` under an `if` part of the `if`'s own statement.
        if self.atLineEnd() && self.ends(depth, escaping, declaring) {
          return nodeOf(Node.Stmt, from, self.at, held.toArray())
        }
        continue
      }
      let c = self.punctByte(self.at)
      // The brace that closes the body this statement is in. It belongs to
      // the body and not to the statement, so the statement ends in front of
      // it — which is what makes `fn a() -> Int \{ 1 \}` one statement and a
      // closing brace rather than a statement that ate the brace.
      if depth <= 0 && c == '\}' {
        return nodeOf(Node.Stmt, from, self.at, held.toArray())
      }
      if c == '(' || c == '[' {
        // A group is taken whole, as its members: a statement's own tokens
        // are leaves, but a group inside one is a node the formatter can
        // decide the depth of. It is the same split `body` makes — what the
        // tree can see into, it does.
        //
        // Depth is not counted for it any more, because `grouped` runs to
        // its own closing bracket: a statement that has taken a group is
        // back at its own level when it answers.
        held.push(self.grouped(Node.Group))
        if self.atLineEnd() && self.ends(0, escaping, declaring) {
          return nodeOf(Node.Stmt, from, self.at, held.toArray())
        }
        continue
      }
      if c == ')' || c == ']' {
        // A closer that closes nothing ends the statement rather than
        // running past it, for `balanced`'s reason: one typo should cost
        // one statement and not the rest of the file.
        return nodeOf(Node.Stmt, from, self.at, held.toArray())
      }
      held.push(leafIn(self.at, self.empty))
      self.at = self.at + 1
      if self.atLineEnd() && self.ends(depth, escaping, declaring) {
        return nodeOf(Node.Stmt, from, self.at, held.toArray())
      }
    }
    nodeOf(Node.Stmt, from, self.at, held.freeze())
  }

  /// Whether the statement is over at the cursor, having just taken a token
  /// at `depth`.
  ///
  /// `escaping` says the statement began with `break`, `continue` or
  /// `return`, which end at their line whatever encloses them. `declaring`
  /// says this is a field, a variant or a method rather than a statement,
  /// and those end at their line full stop — see [`Parser::bodyOf`].
  fn ends(self, depth: Int, escaping: Bool, declaring: Bool) -> Bool {
    if depth > 0 && !escaping && !declaring {
      return false
    }
    if !self.atLineEnd() {
      return false
    }
    // A declaration has no continuation rule to apply: it is one to a line,
    // so the line ending is the whole of the question.
    if declaring {
      return true
    }
    // The two continuations. `escaping` overrides neither: a `return` ends
    // at its line, and an operator written at the end of that line is a
    // `return` whose operand runs on — the reference's *"an operand that
    // opens on the keyword's line may run over as many further lines as it
    // needs"*.
    //
    // But a keyword with nothing after it on its line has no operand, and the
    // line below cannot give it one: `at_operand` asks only whether the next
    // token is on the keyword's line. So `return` then `.x` is a bare
    // `return` and a second statement, however the second one begins.
    if escaping && self.escapes(self.lastTaken()) {
      return true
    }
    !self.continues() && !self.opensWithAContinuation()
  }

  /// The last token taken that is not trivia, or `-1`.
  fn lastTaken(self) -> Int {
    var i = self.at - 1
    while i >= 0 && isTrivia(self.tokens, i) {
      i = i - 1
    }
    i
  }

  /// Whether the token just taken is followed by a line break: a run of space
  /// holding a newline, or a block comment holding one.
  ///
  /// The comment is `cove_syntax`'s rule and not a nicety. Its lexer marks a
  /// token as preceded by a newline when a `/* */` in front of it spans one,
  /// so that commenting out the tail of a line cannot join two statements —
  /// `a /* … newline … */ b` is two statements there, and read only by runs
  /// of space it was one here.
  fn atLineEnd(self) -> Bool {
    match self.tokens.get(self.at) {
      Some(token) => {
        (token.kind == Kind.Space || token.kind == Kind.BlockComment) &&
          endsLine(self.source, token)
      }
      None => true
    }
  }

  /// Whether the last token taken leaves the line unfinished.
  ///
  /// Punctuation, unless it is punctuation that completes what it follows: an
  /// operator, a comma or a colon leaves a line owing something, and a name
  /// or a literal is already a complete expression.
  ///
  /// And a keyword, unless it is one that completes an expression on its own.
  /// `cove_syntax`'s `ends_expression` admits a name, a literal, `self`, and
  /// the three that take an operand only on their own line — `break`,
  /// `continue`, `return` — and no other keyword: `a is` then `b` is one
  /// comparison, `for x in` then `xs \{` one loop, `\} else` then `\{` one
  /// `if`. The lexer here does not tell a keyword from a name, so the list is
  /// asked for at the one place it decides anything.
  fn continues(self) -> Bool {
    let i = self.lastTaken()
    match self.tokens.get(i) {
      Some(token) => {
        if token.kind == Kind.Word {
          return self.leavesALineOpen(i)
        }
        if token.kind != Kind.Punct {
          return false
        }
        !completes(self.source, token)
      }
      None => false
    }
  }

  /// Whether the word at `at` is a keyword that cannot end an expression.
  ///
  /// Written as a chain of comparisons rather than a loop over a list, for
  /// the reason `operatorWidth` gives: a list literal in a function is built
  /// again on every call, and this is asked at every line that ends on a word.
  fn leavesALineOpen(self, at: Int) -> Bool {
    let source = self.source
    let tokens = self.tokens
    isWord(source, tokens, at, "if") || isWord(source, tokens, at, "else") ||
      isWord(source, tokens, at, "match") || isWord(source, tokens, at, "while") ||
      isWord(source, tokens, at, "for") || isWord(source, tokens, at, "in") ||
      isWord(source, tokens, at, "is") || isWord(source, tokens, at, "let") ||
      isWord(source, tokens, at, "var") || isWord(source, tokens, at, "fn") ||
      isWord(source, tokens, at, "async") || isWord(source, tokens, at, "await") ||
      isWord(source, tokens, at, "scope") || isWord(source, tokens, at, "dyn")
  }

  /// Whether the next line begins with a token that continues the line above
  /// it whatever that line ended on.
  ///
  /// `.` continues a chain and `?` applies to what is above it: neither can
  /// begin an expression, so `cove_syntax` never stops in front of one. `else`
  /// and `=>` are read across a line break by name — `parse_if` eats the
  /// `else` and `parse_match` expects the arrow without asking about lines —
  /// so `\}` then `else \{` is one `if`, and a pattern then `=> value` is one
  /// arm.
  fn opensWithAContinuation(self) -> Bool {
    let next = self.significant(self.at)
    let c = self.punctByte(next)
    if c == '.' || c == '?' {
      return true
    }
    isPunct(self.source, self.tokens, next, "=>") ||
      isWord(self.source, self.tokens, next, "else")
  }

  /// Whether the statement beginning at `at` is a `break`, a `continue` or a
  /// `return`.
  ///
  /// Compared in place with [`isWord`] rather than cut out with `sliceBytes`
  /// and compared as a `String`, which allocated a string per statement and
  /// per line end a statement was asked about.
  fn escapes(self, at: Int) -> Bool {
    isWord(self.source, self.tokens, at, "break") ||
      isWord(self.source, self.tokens, at, "continue") ||
      isWord(self.source, self.tokens, at, "return")
  }

  /// Takes the rest of the line as leaves, the newline excluded.
  ///
  /// What `use` and `type` end at: a statement ends at the end of a line, so
  /// a declaration with no body does too.
  ///
  /// A line break inside a bracket ends nothing, which is the language's own
  /// rule and not a nicety here: `export type Handler = async fn(\n  request:
  /// http.Request,\n) -> ...` is one declaration, and a rule that stopped at
  /// the first newline made it two and the second an error.
  fn toEndOfLine(
    var self,
    kind: Node,
    from: Int,
    var held: Vector<Tree>,
  ) -> Tree {
    var depth = 0
    while !self.done() {
      match self.tokens.get(self.at) {
        Some(token) => {
          if depth <= 0 && token.kind == Kind.Space &&
            endsLine(self.source, token) {
            return nodeOf(kind, from, self.at, held.toArray())
          }
        }
        None => { }
      }
      let c = self.punctByte(self.at)
      // A group is taken whole, as its members, exactly as `statement` takes
      // one: `async fn(\n  request: http.Request,\n)` written as a type is
      // the same shape as a call written as an expression, and a formatter
      // that can place the lines of one can place the lines of the other.
      // Left as leaves, the `)` on its own line was a continuation of the
      // line above and was indented a step it does not take.
      //
      // `grouped` runs to its own closing bracket, so the depth this counts
      // is only ever a brace's.
      if c == '(' || c == '[' {
        held.push(self.grouped(Node.Group))
        continue
      }
      if c == '\{' {
        depth = depth + 1
      } else if c == '\}' {
        depth = depth - 1
      }
      held.push(leafIn(self.at, self.empty))
      self.at = self.at + 1
    }
    nodeOf(kind, from, self.at, held.toArray())
  }
}

/// Whether a run of space holds a newline.
///
/// Bytes and not code points, which is what `Scan::at` says of the lexer and
/// is just as true here: `String.byteAt` is an instruction where
/// `codePointAtByte` is a builtin call that allocates the `Option` it answers
/// with. A native profile of the printer put a third of the *whole run* in
/// that allocation, and this loop is why — it reads every byte of every run
/// of space, and a run of space is a third of the tokens in a file.
///
/// Every comparison here is against ASCII, where a byte and a code point are
/// the same number.
fn endsLine(source: String, token: Token) -> Bool {
  var i = token.from
  while i < token.to {
    if source.byteAt(i) == '\n' {
      return true
    }
    i = i + 1
  }
  false
}

/// Whether punctuation completes the expression in front of it.
///
/// The three closing brackets and the two postfix operators. `?` and `...`
/// are written *after* what they apply to, so a line ending in one has said
/// everything it is going to; `..<` is written *between* two operands and has
/// not.
///
/// This is the complement of `parser::ends_expression`, and it is written as
/// a list of what completes rather than as "not a closing bracket" because
/// the two are not the same list. As the negative it read `f(1)?` as a line
/// that runs on, so the statement below it was taken into the one above and
/// came out with no indentation of its own. The corpus never saw it: the file
/// it read that from was indented already, and covefmt keeps a space it
/// cannot place.
fn completes(source: String, token: Token) -> Bool {
  let width = token.to - token.from
  if width == 1 {
    let c = source.byteAt(token.from)
    c == ')' || c == ']' || c == '\}' || c == '?'
  } else {
    // `...` against `..<`, which the lexer gives the same width.
    width == 3 && source.byteAt(token.from) == '.' &&
      source.byteAt(token.from + 2) == '.'
  }
}
